{
  "globalPatterns": [
    ".editorconfig",
    ".gitattributes",
    "Directory.Build.props",
    "Directory.Packages.props",
    "OpenBlade.slnx",
    "global.json",
    "NuGet.config",
    "src/Directory.Build.targets",
    ".github/workflows/*",
    "build/Assert-CiLaneResults.ps1",
    "build/CiBuildScope.ps1",
    "build/CiImpactManifest.json",
    "build/Run-AffectedCi.ps1"
  ],
  "fullInstallerPatterns": [
    "build/installer/*",
    "build/BuildIdentity.ps1",
    "build/identity/*",
    "build/store/*",
    "build/Installer*.ps1",
    "build/Publish*.ps1",
    "build/SparsePackageIdentity.ps1",
    "build/StoreSubmissionValidation.ps1",
    "build/Verify-Branding.ps1",
    "build/WindowsAppRuntimeNotificationResource.ps1",
    "src/OpenBlade.Setup/*",
    "src/OpenBlade.Tray/Assets/Brand/OpenBlade.ico",
    "src/OpenBlade.Tray/Assets/Brand/OpenBlade.Installer.ico",
    "src/OpenBlade.Tray/Assets/Brand/OpenBlade.png"
  ],
  "publishableProjects": [
    "src/OpenBlade.Capture/OpenBlade.Capture.csproj",
    "src/OpenBlade.FirmwareSmoke/OpenBlade.FirmwareSmoke.csproj",
    "src/OpenBlade.Service/OpenBlade.Service.csproj",
    "src/OpenBlade.SessionAgent/OpenBlade.SessionAgent.csproj",
    "src/OpenBlade.Setup/OpenBlade.Setup.csproj",
    "src/OpenBlade.Tray/OpenBlade.Tray.csproj"
  ],
  "testInputRules": [
    {
      "patterns": ["build/tools/OpenBlade.LocalDevDeployment.Tool/*"],
      "testProjects": ["tests/OpenBlade.LocalDevDeployment.Tool.Tests/OpenBlade.LocalDevDeployment.Tool.Tests.csproj"],
      "reason": "The developer-only staging tool must preserve TPM and fixed-inbox contracts."
    },
    {
      "patterns": ["src/OpenBlade.Deployment/*"],
      "testProjects": ["tests/OpenBlade.Deployment.Tests/OpenBlade.Deployment.Tests.csproj", "tests/OpenBlade.DeploymentBroker.Tests/OpenBlade.DeploymentBroker.Tests.csproj", "tests/OpenBlade.LocalDevDeployment.Tool.Tests/OpenBlade.LocalDevDeployment.Tool.Tests.csproj"],
      "reason": "The signed local-development manifest is shared by staging and the elevated broker."
    },
    {
      "patterns": ["src/OpenBlade.DeploymentBroker/*"],
      "testProjects": ["tests/OpenBlade.DeploymentBroker.Tests/OpenBlade.DeploymentBroker.Tests.csproj", "tests/OpenBlade.DevelopmentDeployment.Setup.Tests/OpenBlade.DevelopmentDeployment.Setup.Tests.csproj"],
      "reason": "The fixed elevated broker and attended provisioner share enrollment contracts."
    },
    {
      "patterns": ["src/OpenBlade.DeploymentClient/*"],
      "testProjects": ["tests/OpenBlade.DeploymentClient.Tests/OpenBlade.DeploymentClient.Tests.csproj"],
      "reason": "The normal-integrity client must preserve its narrow service and relaunch contracts."
    },
    {
      "patterns": ["src/OpenBlade.DevelopmentDeployment.Setup/*"],
      "testProjects": ["tests/OpenBlade.DevelopmentDeployment.Setup.Tests/OpenBlade.DevelopmentDeployment.Setup.Tests.csproj"],
      "reason": "The attended developer provisioner must preserve enrollment and ACL contracts."
    },
    {
      "patterns": ["src/OpenBlade.Setup/LocalDevEnrollmentUser.cs", "src/OpenBlade.Setup/OpenBlade.Setup.csproj", "src/OpenBlade.Setup/Program.cs", "src/OpenBlade.Setup/WindowsSetupPlatform.cs"],
      "testProjects": ["tests/OpenBlade.Setup.Tests/OpenBlade.Setup.Tests.csproj", "tests/OpenBlade.DevelopmentDeployment.Setup.Tests/OpenBlade.DevelopmentDeployment.Setup.Tests.csproj"],
      "reason": "The release-excluded Setup build must bind user-scoped work to the protected enrollment."
    },
    {
      "patterns": ["src/*.cs"],
      "testProjects": ["tests/OpenBlade.Architecture.Tests/OpenBlade.Architecture.Tests.csproj"],
      "reason": "Production C# changes must satisfy repository-wide architecture contracts."
    },
    {
      "patterns": ["src/OpenBlade.Setup/StartupShortcutWriter.cs"],
      "seedProjects": ["src/OpenBlade.Tray/OpenBlade.Tray.csproj"],
      "reason": "The Tray links StartupShortcutWriter directly."
    },
    {
      "patterns": [
        "src/OpenBlade.Tray/WindowsDisplayBrightnessOsd.cs",
        "src/OpenBlade.Tray/WindowsRegistryReader.cs"
      ],
      "testProjects": ["tests/OpenBlade.SessionAgent.Tests/OpenBlade.SessionAgent.Tests.csproj"],
      "reason": "Session Agent tests link these Tray sources directly."
    },
    {
      "patterns": [
        "src/OpenBlade.SessionAgent/Program.cs",
        "src/OpenBlade.SessionAgent/WindowsReactiveKeyboardSource.cs",
        "build/Publish.ps1",
        "build/PublishPayloadValidation.ps1"
      ],
      "testProjects": ["tests/OpenBlade.Tray.Tests/OpenBlade.Tray.Tests.csproj"],
      "reason": "Tray architecture contracts inspect these Session Agent and publishing inputs directly."
    },
    {
      "patterns": ["tests/OpenBlade.Testing/AsyncTest.cs"],
      "testProjects": [
        "tests/OpenBlade.Protocol.Tests/OpenBlade.Protocol.Tests.csproj",
        "tests/OpenBlade.SessionAgent.Tests/OpenBlade.SessionAgent.Tests.csproj",
        "tests/OpenBlade.Tray.Tests/OpenBlade.Tray.Tests.csproj"
      ],
      "reason": "These test projects link AsyncTest directly."
    },
    {
      "patterns": ["tests/OpenBlade.Testing/UnavailableServiceClient.cs"],
      "testProjects": [
        "tests/OpenBlade.SessionAgent.Tests/OpenBlade.SessionAgent.Tests.csproj",
        "tests/OpenBlade.Tray.Tests/OpenBlade.Tray.Tests.csproj"
      ],
      "reason": "These test projects link UnavailableServiceClient directly."
    },
    {
      "patterns": ["tests/OpenBlade.Testing/PublicApiSurface.cs"],
      "testProjects": [
        "tests/OpenBlade.Contracts.Tests/OpenBlade.Contracts.Tests.csproj",
        "tests/OpenBlade.Protocol.Tests/OpenBlade.Protocol.Tests.csproj",
        "tests/OpenBlade.Session.Tests/OpenBlade.Session.Tests.csproj"
      ],
      "reason": "These test projects link the public API surface helper directly."
    },
    {
      "patterns": ["scripts/Test-FirmwareUpdate.ps1"],
      "testProjects": ["tests/OpenBlade.FirmwareSmoke.Tests/OpenBlade.FirmwareSmoke.Tests.csproj"],
      "reason": "FirmwareSmoke tests inspect the firmware-update script."
    },
    {
      "patterns": ["captures"],
      "testProjects": [
        "tests/OpenBlade.Capture.Tests/OpenBlade.Capture.Tests.csproj",
        "tests/OpenBlade.Protocol.Tests/OpenBlade.Protocol.Tests.csproj"
      ],
      "requiresCaptures": true,
      "reason": "Capture and Protocol tests consume the pinned capture evidence."
    }
  ],
  "contractRules": [
    {
      "test": "tests/Build.Tests/AffectedCiRunner.Tests.ps1",
      "patterns": ["build/Run-AffectedCi.ps1"]
    },
    {
      "test": "tests/Build.Tests/BuildIdentity.Tests.ps1",
      "patterns": ["build/BuildIdentity.ps1"]
    },
    {
      "test": "tests/Build.Tests/PadlessHyperBoostLifecycleValidationBuild.Tests.ps1",
      "patterns": ["build/Build-PadlessHyperBoostLifecycleValidation.ps1", "src/OpenBlade.Service/OpenBlade.Service.csproj", "src/OpenBlade.Service/PadlessHyperBoostLifecycleValidationBuild.cs", "src/OpenBlade.Protocol/HyperBoostWithoutCoolingPadEvidence.cs", "src/OpenBlade.Protocol/Fixtures/Rz09_0581_02e0_4_00_HyperBoostWithoutCoolingPadAdmission.json"]
    },
    {
      "test": "tests/Build.Tests/ThermalExternalDriftValidationBuild.Tests.ps1",
      "patterns": ["build/Build-ThermalExternalDriftValidation.ps1", "build/Publish.ps1", "build/development-deployment/Invoke-LocalDevDeployment.ps1", "src/OpenBlade.Service/OpenBlade.Service.csproj", "src/OpenBlade.Service/ThermalExternalDriftValidationBuild.cs", "src/OpenBlade.Protocol/ProductionFixtureSource.cs", "src/OpenBlade.Protocol/TrustedFixtureHashRegistry.cs", "src/OpenBlade.Protocol/Fixtures/Rz09_0581_02e0_3_01_BatteryProduction.json"]
    },
    {
      "test": "tests/Build.Tests/ChangelogReleases.Tests.ps1",
      "patterns": ["build/Validate-ChangelogReleases.ps1", "build/NightlyChangelog.ps1", "CHANGELOG.md", "AGENTS.md", "tests/Build.Tests/ChangelogReleases.Tests.ps1"]
    },
    {
      "test": "tests/Build.Tests/CiBuildScope.Tests.ps1",
      "patterns": ["build/CiBuildScope.ps1", "build/CiImpactManifest.json", ".github/workflows/ci.yml", ".github/workflows/build.yml"]
    },
    {
      "test": "tests/Build.Tests/CiLaneResults.Tests.ps1",
      "patterns": ["build/Assert-CiLaneResults.ps1", ".github/workflows/build.yml"]
    },
    {
      "test": "tests/Build.Tests/InstallerAuthoring.Tests.ps1",
      "patterns": ["build/installer/*", "build/InstallerValidation.ps1", "build/Publish.ps1", "build/store/OpenBlade.StoreSubmission.json", "Directory.Packages.props", "OpenBlade.slnx", "src/OpenBlade.Setup/OpenBlade.Setup.csproj", "src/OpenBlade.Setup/SetupPaths.cs", "src/OpenBlade.Tray/Assets/Brand/OpenBlade.Installer.ico"]
    },
    {
      "test": "tests/Build.Tests/InteractiveUsbPcapCaptureRunner.Tests.ps1",
      "patterns": ["captures"],
      "requiresCaptures": true
    },
    {
      "test": "tests/Build.Tests/LightingOracleCheckoutPolicy.Tests.ps1",
      "patterns": [".gitattributes", "src/OpenBlade.Protocol/Fixtures/*TidalOracle.json", "src/OpenBlade.Protocol/Fixtures/*WaveWheelOracle.json"]
    },
    {
      "test": "tests/Build.Tests/LightingSpectrumRandomCaptureWorkflow.Tests.ps1",
      "patterns": ["captures"],
      "requiresCaptures": true
    },
    {
      "test": "tests/Build.Tests/LightingSpectrumRandomOracleAnalysis.Tests.ps1",
      "patterns": ["captures"],
      "requiresCaptures": true
    },
    {
      "test": "tests/Build.Tests/LocalizationResources.Tests.ps1",
      "patterns": ["build/*Localization*.ps1", "src/OpenBlade.Tray/*.xaml", "src/OpenBlade.Tray/*.cs", "src/OpenBlade.Tray/Strings/*", "src/OpenBlade.Tray.Core/*.cs", "src/OpenBlade.Tray.Core/Properties/*", "src/OpenBlade.Setup/*.cs", "src/OpenBlade.Setup/Properties/*", "build/installer/OpenBlade.Installer.UI/*", "build/installer/*.wxl", "build/installer/Bundle.wxs"]
    },
    {
      "test": "tests/Build.Tests/LocalizationTranslatorWorkflow.Tests.ps1",
      "patterns": ["build/Export-LocalizationTranslatorPackage.ps1", "build/Import-LocalizationTranslatorWorkbook.ps1", "build/LocalizationTranslatorWorkflow.psm1", "build/Validate-LocalizationResources.ps1", "build/Capture-LocalizationSnapshots.ps1", "build/localization/TranslatorScreenshotMap.json", "build/installer/OpenBlade.Installer.UI.Tests/InstallerWindowTests.cs", "build/installer/OpenBlade.Installer.UI/Properties/*", "docs/localization-translators.md", "src/OpenBlade.Setup/Properties/*", "src/OpenBlade.Tray/App.xaml.cs", "src/OpenBlade.Tray/MainWindow.xaml", "src/OpenBlade.Tray/MainWindow.xaml.cs", "src/OpenBlade.Tray/Strings/*", "src/OpenBlade.Tray.Core/Properties/*", "tests/Build.Tests/LocalizationTranslatorWorkflow.Tests.ps1"],
      "restoreProjects": ["src/OpenBlade.Tray/OpenBlade.Tray.csproj", "build/installer/OpenBlade.Installer.UI.Tests/OpenBlade.Installer.UI.Tests.csproj"]
    },
    {
      "test": "tests/Build.Tests/NightlyChangelog.Tests.ps1",
      "patterns": ["build/NightlyChangelog.ps1", "CHANGELOG.md"]
    },
    {
      "test": "tests/Build.Tests/NightlyWorkflow.Tests.ps1",
      "patterns": [".github/workflows/ci.yml", ".github/workflows/build.yml", ".github/workflows/nightly.yml", ".github/workflows/finalize-nightly.yml", "build/Complete-NightlyRelease.ps1"]
    },
    {
      "test": "tests/Build.Tests/NightlyReleaseFinalization.Tests.ps1",
      "patterns": ["build/Complete-NightlyRelease.ps1", "build/NightlyChangelog.ps1", "build/Validate-ChangelogReleases.ps1", ".github/workflows/finalize-nightly.yml"]
    },
    {
      "test": "tests/Build.Tests/LocalNightlySkill.Tests.ps1",
      "patterns": [".agents/skills/openblade-local-nightly/*", "build/Publish.ps1", "build/PublishPayloadValidation.ps1", "build/NightlyChangelog.ps1"]
    },
    {
      "test": "tests/Build.Tests/PublishPayloadValidation.Tests.ps1",
      "patterns": ["build/PublishPayloadValidation.ps1"]
    },
    {
      "test": "tests/Build.Tests/PullRequestVersion.Tests.ps1",
      "patterns": ["build/PullRequestVersion.ps1", ".github/workflows/pr-version.yml", ".github/workflows/ci.yml", ".github/PULL_REQUEST_TEMPLATE.md"]
    },
    {
      "test": "tests/Build.Tests/SparkAgentWorkflow.Tests.ps1",
      "patterns": [".agents/skills/openblade-spark-operators/*", ".codex/agents/*"]
    },
    {
      "test": "tests/Build.Tests/RazerBrightnessDriverPackage.Tests.ps1",
      "patterns": ["build/Export-RazerBrightnessDriverPackage.ps1", "src/OpenBlade.Service/WindowsRazerDisplayBrightnessHidTransport.cs", "docs/razer-brightness-driver-package.md", ".gitattributes"]
    },
    {
      "test": "tests/Build.Tests/ReadmeHardwareSupport.Tests.ps1",
      "patterns": ["README.md"]
    },
    {
      "test": "tests/Build.Tests/SparsePackageIdentity.Tests.ps1",
      "patterns": ["build/SparsePackageIdentity.ps1", "build/PublishPayloadValidation.ps1", "build/identity/*", "build/Publish.ps1", "src/OpenBlade.SessionAgent/OpenBlade.SessionAgent.csproj"],
      "restoreProjects": ["src/OpenBlade.SessionAgent/OpenBlade.SessionAgent.csproj"]
    },
    {
      "test": "tests/Build.Tests/StoreSubmissionValidation.Tests.ps1",
      "patterns": ["build/StoreSubmissionValidation.ps1", "build/store/OpenBlade.StoreSubmission.json"]
    },
    {
      "test": "tests/Build.Tests/LocalDevBuildVersion.Tests.ps1",
      "patterns": ["build/development-deployment/LocalDevBuildVersion.ps1", "build/development-deployment/Invoke-LocalDevDeployment.ps1"]
    },
    {
      "test": "tests/Build.Tests/LocalDevDeploymentReleaseBoundary.Tests.ps1",
      "patterns": ["build/Build-ThermalExternalDriftValidation.ps1", "build/Publish.ps1", "build/StoreSubmissionValidation.ps1", "build/installer/*", "build/development-deployment/*", "build/tools/OpenBlade.LocalDevDeployment.Tool/*", "src/OpenBlade.Deployment/*", "src/OpenBlade.DeploymentBroker/*", "src/OpenBlade.DeploymentClient/*", "src/OpenBlade.DevelopmentDeployment.Setup/*", "src/OpenBlade.Setup/LocalDevEnrollmentUser.cs", "src/OpenBlade.Setup/OpenBlade.Setup.csproj", "src/OpenBlade.Setup/Program.cs"]
    },
    {
      "test": "tests/Build.Tests/UsbPcapCaptureControl.Tests.ps1",
      "patterns": ["captures"],
      "requiresCaptures": true
    },
    {
      "test": "tests/Build.Tests/WindowsAppRuntimeNotificationResource.Tests.ps1",
      "patterns": ["build/WindowsAppRuntimeNotificationResource.ps1"]
    }
  ]
}
