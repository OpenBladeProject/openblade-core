  "rules": [
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^(?:Applications(?:UI)?_|Feature_(?:061b9b48e177|0d94e35e8475|155db46f9362|19ad9b4c6b5c|207f5db133a0|3a29f5ccc091|3d621a53b31e|496960c3c1f5|50accd740fa2|51e2604e2aaf|5f81f632042a|612a36db4fc9|6cc5df35f033|6fce74ac10dd|7837e2a6dec5|7a0afacfb221|847ced6ca02b|877cb5a94232|96ad4bd0f7ba|9c7c8919be0e|9cb7099bc130|9cc01faad79c|9d2725011acd|a4873a62f9e5|a66522394a37|ac3492bfbd41|af4123249281|b26de372b4b0|b4c2f503b194|c0774c185060|c1db83d165ed|c43fb5f4da35|c83928a24959|c88a6043293f|ce6bbac0215e|d7c76cf63323|ea008cd08808|f7e6729d30cf|f8ed8576f5a9|fb51849e03f2|fb8bc434078d))",
      "context": "Application profile list, pushed editor and grouped game discovery shown with disconnected fixtures and empty states.",
      "screenshots": ["tray/main-profiles-applications.png", "tray/main-profiles-applications-empty.png", "tray/main-profiles-application-editor.png", "tray/main-profiles-application-editor-controls.png", "tray/main-profiles-application-discovery.png", "tray/main-profiles-application-discovery-empty.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^(?:Telemetry(?:UI)?_|Navigation_Telemetry$|Feature_(?:3ca3281778c2|42d94a35c548|4696d358d054|6141eef71a99|6c455cda31d0|72539d6acd07|73998e0f0da8|73e7c4edf7e7|7d021f67142c|7f1c35cb6572|8f1c7cba79a7|905c2bc1b6eb|94d954185187|a72204aa94d0|b5c358cef921|c650cc78b7fe|c7f01a7da8db|c83b7fc012ef|d6db2da1a792|e09ca605b555|f04321b95415|f8d2f2cd53a8))",
      "context": "Telemetry page shown with deterministic readings, gaps, analysis statistics, a draggable exact-time range, narrow and dark layouts, and per-user metric visibility and color flyouts.",
      "screenshots": ["tray/main-telemetry.png", "tray/main-telemetry-empty.png", "tray/main-telemetry-analysis.png", "tray/main-telemetry-narrow.png", "tray/main-telemetry-dark.png", "tray/main-telemetry-range.png", "tray/main-telemetry-metrics.png", "tray/telemetry-metrics.png", "tray/main-telemetry-color.png", "tray/telemetry-color.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^(?:BatteryHistory_|BatteryPreset_|BatteryTimeline_|MainWindow_BatteryHistoryRowsText)",
      "context": "Windows battery history and long battery life preset preview shown with disconnected sample intervals.",
      "screenshots": ["tray/main-laptop-battery-history.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^MainWindow_(?:DisplayBrightness|ProfileDisplayBrightness)",
      "context": "Display brightness shown in both available and unavailable capability states.",
      "screenshots": ["tray/main-display-brightness-known.png", "tray/main-display-brightness-unavailable.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^SnapTap_",
      "context": "SnapTap controls and information popup on the Laptop page.",
      "screenshots": ["tray/main-laptop-snap-tap-info.png", "tray/snap-tap-information.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^MainWindow_ThxAudio",
      "context": "Optional THX audio controls shown with disconnected sample data.",
      "screenshots": ["tray/main-thx-audio.png", "tray/main-thx-audio-headphones.png", "tray/main-thx-audio-enhancements.png", "tray/main-thx-audio-applications.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:\\bTHX\\b|audio change could not be confirmed)",
      "context": "Optional THX audio availability, confirmation, or recovery status.",
      "screenshots": ["tray/main-thx-audio.png", "tray/main-thx-audio-applications.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "^(?:TrayDashboard|TrayIconMenu)",
      "context": "Tray dashboard or notification-area menu.",
      "screenshots": ["tray/tray-dashboard.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:lighting|keyboard|logo|chroma|ambient|audioMeter|spectrum)",
      "context": "Lighting page control, status, or accessibility text.",
      "screenshots": ["tray/main-lighting.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:display|brightness|refresh|resolution|gpuApp)",
      "context": "Display page control, status, or accessibility text.",
      "screenshots": ["tray/main-display.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:profile|automation)",
      "context": "Profiles and automation page control or status.",
      "screenshots": ["tray/main-profiles.png", "tray/main-profiles-narrow.png", "tray/main-profiles-wide.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:AppLanguage|appearance|theme|accent|density)",
      "context": "Appearance and language settings control.",
      "screenshots": ["tray/main-settings-appearance.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:setting|startup|notification|update|specialKey|exitDialog)",
      "context": "Settings page control, dialog, or status.",
      "screenshots": ["tray/main-settings.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:about|firmware|version|diagnostic|component|ForGamersByTheCommunity)",
      "context": "About, diagnostics, version, or firmware information.",
      "screenshots": ["tray/main-about.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": "(?i)(?:laptop|fan|performance|hyperBoost|battery|charge|power|temperature|clock|voltage)",
      "context": "Laptop page hardware status or control shown with deterministic mock data.",
      "screenshots": ["tray/main-laptop.png"]
    },
    {
      "surface": "tray",
      "match": "key",
      "pattern": ".*",
      "context": "Main OpenBlade window navigation, status, dialog, or common action.",
      "screenshots": ["tray/main-home.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:application profile|application activation mode|unknown application|power-source profile|name of up to 80 characters|at least one application profile setting|exact game or application executable)",
      "context": "Runtime application profile validation and presentation text.",
      "screenshots": ["tray/main-profiles-applications.png", "tray/main-profiles-applications-empty.png", "tray/main-profiles-application-editor.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:telemetry recording|recording reached its limit)",
      "context": "Runtime telemetry recording status and recovery text.",
      "screenshots": ["tray/main-telemetry.png", "tray/main-telemetry-empty.png", "tray/main-telemetry-analysis.png", "tray/main-telemetry-range.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:battery history|long battery life|last 24 hours|connected standby|discharged|full charge \\{0\\}.*design)",
      "context": "Runtime Windows battery history and long battery life preset text.",
      "screenshots": ["tray/main-laptop-battery-history.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:display brightness|^brightness \\{0\\}%$)",
      "context": "Runtime display brightness value or unavailable state.",
      "screenshots": ["tray/main-display-brightness-known.png", "tray/main-display-brightness-unavailable.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:lighting|keyboard|logo|chroma|ambient|audio meter|spectrum)",
      "context": "Runtime lighting presentation text used by the tray and dashboard.",
      "screenshots": ["tray/main-lighting.png", "tray/tray-dashboard.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:display|brightness|refresh rate|resolution|GPU application)",
      "context": "Runtime display presentation text.",
      "screenshots": ["tray/main-display.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:profile|automation)",
      "context": "Runtime profile and automation presentation text.",
      "screenshots": ["tray/main-profiles.png", "tray/main-profiles-narrow.png", "tray/main-profiles-wide.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:firmware|BIOS|VBIOS|version|diagnostic|update)",
      "context": "Runtime diagnostics, version, update, or firmware text.",
      "screenshots": ["tray/main-about.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": "(?i)(?:fan|performance|battery|charge|power|temperature|RPM|MHz|voltage|HyperBoost)",
      "context": "Runtime laptop status or control text shown with deterministic mock data.",
      "screenshots": ["tray/main-laptop.png", "tray/main-home.png"]
    },
    {
      "surface": "tray-core",
      "match": "source",
      "pattern": ".*",
      "context": "Shared runtime presentation text used in the main window or tray dashboard.",
      "screenshots": ["tray/main-home.png", "tray/tray-dashboard.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": "(?i)(?:cancel|rollback|keep working)",
      "context": "Installer cancellation and safe rollback state.",
      "screenshots": ["installer/installer-cancel.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": "(?i)(?:failed|could not|unavailable|missing|malformed|recovery)",
      "context": "Installer failure or recovery guidance.",
      "screenshots": ["installer/installer-failure.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": "(?i)(?:newer|older installer|already installed|already registered)",
      "context": "Older-installer block when a newer OpenBlade version is installed.",
      "screenshots": ["installer/installer-newer-version.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": "(?i)(?:repair|uninstall|maintenance|remove)",
      "context": "Installed-product maintenance, repair, or removal state.",
      "screenshots": ["installer/installer-maintenance.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": "(?i)(?:progress|preparing|copying|installing|removing|registering|checking|working|applying|committing|restoring|stopping)",
      "context": "Installer progress state with sanitized deterministic details.",
      "screenshots": ["installer/installer-progress.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": "(?i)(?:\\bcomplete(?:d)?\\b|\\bsuccess(?:fully)?\\b|\\bready\\b|\\blaunch\\b)",
      "context": "Successful setup completion state.",
      "screenshots": ["installer/installer-success.png"]
    },
    {
      "surface": "installer",
      "match": "source",
      "pattern": ".*",
      "context": "Graphical installer ready-to-install state or common action.",
      "screenshots": ["installer/installer-install.png"]
    },
    {
      "surface": "setup",
      "match": "source",
      "pattern": "(?i)(?:failed|could not)",
      "context": "Native uninstall failure dialog; graphical installer failure is the closest safe preview.",
      "screenshots": ["installer/installer-failure.png"]
    },
    {
      "surface": "setup",
      "match": "source",
      "pattern": ".*",
      "context": "Native uninstall confirmation or completion dialog; mapped to the safe graphical maintenance preview.",
      "screenshots": ["installer/installer-maintenance.png"]
    }
  ]
}
