<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <Font Id="0" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
  <Font Id="1" Height="-24" Weight="500" Foreground="windowtext">Segoe UI</Font>
  <Font Id="2" Height="-20" Weight="500" Foreground="graytext">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>

  <Window Width="520" Height="410" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">
    <ImageControl X="16" Y="16" Width="64" Height="64" ImageFile="logo.png" Visible="yes" />
    <Label X="92" Y="16" Width="-16" Height="64" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Label>

    <Page Name="Loading">
      <Label Name="CheckingForUpdatesLabel" X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes" Visible="no" />
    </Page>

    <Page Name="Help">
      <Label X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
      <Label X="16" Y="132" Width="-16" Height="-48" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
      <Button Name="HelpCloseButton" X="-16" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0">
        <Text>#(loc.HelpCloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Install">
      <Label X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes">#(loc.InstallHeader)</Label>
      <Label X="16" Y="132" Width="-16" Height="-136" FontId="3" DisablePrefix="yes">#(loc.InstallMessage)</Label>
      <Hypertext Name="EulaHyperlink" X="16" Y="-116" Width="-16" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
      <Label Name="InstallVersion" X="16" Y="-82" Width="270" Height="17" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Checkbox Name="EulaAcceptCheckbox" X="-16" Y="-48" Width="280" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
      <Button Name="InstallUpdateButton" X="16" Y="-16" Width="210" Height="25" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
      <Button Name="InstallButton" X="-108" Y="-16" Width="92" Height="25" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
      <Button Name="InstallCancelButton" X="-16" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0">
        <Text>#(loc.InstallCancelButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Progress">
      <Label X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
      <Label X="16" Y="132" Width="76" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
      <Label Name="OverallProgressPackageText" X="96" Y="132" Width="-16" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="16" Y="158" Width="-16" Height="16" />
      <Button Name="ProgressCancelButton" X="-16" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
    </Page>

    <Page Name="Modify">
      <Label X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
      <Label X="16" Y="132" Width="-16" Height="38" FontId="3" DisablePrefix="yes">Choose whether uninstalling OpenBlade should also delete your saved profiles and settings.</Label>
      <Checkbox Name="OpenBladePurgeProfiles" X="16" Y="182" Width="-16" Height="20" TabStop="yes" FontId="3">Remove saved profiles and settings</Checkbox>
      <Button Name="ModifyUpdateButton" X="16" Y="-16" Width="210" Height="25" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
      <Button Name="RepairButton" X="-200" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
      <Button Name="UninstallButton" X="-108" Y="-16" Width="92" Height="25" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
      <Button Name="ModifyCancelButton" X="-16" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0">
        <Text>#(loc.ModifyCancelButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Success">
      <Label X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes">
        <Text>#(loc.SuccessHeader)</Text>
        <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.SuccessInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.SuccessRepairHeader)</Text>
      </Label>
      <Button Name="LaunchButton" X="-108" Y="-16" Width="92" Height="25" TabStop="yes" FontId="0" HideWhenDisabled="yes" VisibleCondition="WixBundleAction = 5 OR WixBundleAction = 7">#(loc.SuccessLaunchButton)</Button>
      <Label X="-16" Y="-60" Width="420" Height="38" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
        <Text>#(loc.SuccessRestartText)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
      </Label>
      <Button Name="SuccessRestartButton" X="-108" Y="-16" Width="92" Height="25" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
      <Button Name="SuccessCloseButton" X="-16" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0">
        <Text>#(loc.SuccessCloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Failure">
      <Label X="16" Y="92" Width="-16" Height="30" FontId="2" DisablePrefix="yes">
        <Text>#(loc.FailureHeader)</Text>
        <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.FailureInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.FailureRepairHeader)</Text>
      </Label>
      <Hypertext Name="FailureLogFileLink" X="16" Y="132" Width="-16" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="28" Y="176" Width="-16" Height="56" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
      <Label X="-16" Y="-60" Width="420" Height="38" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
      <Button Name="FailureRestartButton" X="-108" Y="-16" Width="92" Height="25" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
      <Button Name="FailureCloseButton" X="-16" Y="-16" Width="82" Height="25" TabStop="yes" FontId="0">
        <Text>#(loc.FailureCloseButton)</Text>
        <CloseWindowAction />
      </Button>
    </Page>
  </Window>
</Theme>
