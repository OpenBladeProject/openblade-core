<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>OpenBlade-Setup</OutputName>
    <Cultures>en-US</Cultures>
    <AcceptEula>wix7</AcceptEula>
    <OpenBladeEmbedDotNetRuntime Condition="'$(OpenBladeEmbedDotNetRuntime)' == ''">no</OpenBladeEmbedDotNetRuntime>
    <DefineConstants>OpenBladeVersion=$(OpenBladeVersion);OpenBladeMinimumDotNetRuntimeVersion=$(OpenBladeMinimumDotNetRuntimeVersion);OpenBladeEmbedDotNetRuntime=$(OpenBladeEmbedDotNetRuntime)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="$(OpenBladeBundle)" BindName="OpenBladeBundle" />
    <BindPath Include="$(OpenBladePrerequisites)" BindName="OpenBladePrerequisites" />
    <BindPath Include="$(OpenBladeInstallerUi)" BindName="OpenBladeInstallerUi" />
    <BindPath Include="$(MSBuildThisFileDirectory)..\..\src\OpenBlade.Tray\Assets\Brand"
              BindName="BrandAssets" />
  </ItemGroup>

  <Target Name="ValidateOpenBladeBundle" BeforeTargets="BeforeBuild">
    <Error Condition="'$(OpenBladeBundle)' == ''"
           Text="OpenBladeBundle must point to a validated OpenBlade publish bundle." />
    <Error Condition="!Exists('$(OpenBladeBundle)\OpenBlade.Setup.exe')"
           Text="OpenBladeBundle is missing OpenBlade.Setup.exe." />
    <Error Condition="!Exists('$(OpenBladeBundle)\payload\OpenBlade.Service.exe')"
           Text="OpenBladeBundle is missing payload\OpenBlade.Service.exe." />
    <Error Condition="'$(OpenBladePrerequisites)' == ''"
           Text="OpenBladePrerequisites must point to the validated prerequisite directory." />
    <Error Condition="!Exists('$(OpenBladePrerequisites)\VC_redist.x64.exe')"
           Text="OpenBladePrerequisites is missing VC_redist.x64.exe." />
    <Error Condition="'$(OpenBladeMinimumDotNetRuntimeVersion)' == ''"
           Text="OpenBladeMinimumDotNetRuntimeVersion must define the minimum shared .NET Desktop Runtime version." />
    <Error Condition="!Exists('$(OpenBladePrerequisites)\windowsdesktop-runtime-10.0.12-win-x64.exe')"
           Text="OpenBladePrerequisites is missing windowsdesktop-runtime-10.0.12-win-x64.exe." />
    <Error Condition="'$(OpenBladeInstallerUi)' == ''"
           Text="OpenBladeInstallerUi must point to the published installer UI." />
    <Error Condition="!Exists('$(OpenBladeInstallerUi)\OpenBlade.Installer.UI.exe')"
           Text="OpenBladeInstallerUi is missing OpenBlade.Installer.UI.exe." />
    <Error Condition="!Exists('$(OpenBladeInstallerUi)\WixToolset.BootstrapperApplicationApi.dll')"
           Text="OpenBladeInstallerUi is missing WixToolset.BootstrapperApplicationApi.dll." />
    <Error Condition="!Exists('$(OpenBladeInstallerUi)\mbanative.dll')"
           Text="OpenBladeInstallerUi is missing mbanative.dll." />
  </Target>

  <Target Name="SignBundleEngine" Condition="'$(OpenBladeSigningThumbprint)' != ''">
    <Exec Command="&quot;$(OpenBladeSignTool)&quot; sign /sha1 &quot;$(OpenBladeSigningThumbprint)&quot; /fd SHA256 /tr &quot;$(OpenBladeTimestampUrl)&quot; /td SHA256 &quot;@(SignBundleEngine)&quot;" />
  </Target>

  <Target Name="SignBundle" Condition="'$(OpenBladeSigningThumbprint)' != ''">
    <Exec Command="&quot;$(OpenBladeSignTool)&quot; sign /sha1 &quot;$(OpenBladeSigningThumbprint)&quot; /fd SHA256 /tr &quot;$(OpenBladeTimestampUrl)&quot; /td SHA256 &quot;@(SignBundle)&quot;" />
  </Target>

</Project>
