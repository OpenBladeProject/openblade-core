<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Id="OSSBlade.OpenBlade"
      UpgradeCode="{FF859CA9-D69F-4995-A2AD-69E540E45724}"
      ProviderKey="OSSBlade.OpenBlade"
      Name="OpenBlade"
      Version="$(OpenBladeVersion)"
      Manufacturer="OSSBlade"
      AboutUrl="https://github.com/OSSBlade/openblade-core"
      HelpUrl="https://github.com/OSSBlade/openblade-docs"
      IconSourceFile="!(bindpath.BrandAssets)\OpenBlade.Installer.ico"
      Condition="VersionNT64 &gt;= v10.0 AND WindowsBuildNumber &gt;= 26100"
      Compressed="yes">
    <BootstrapperApplication
        SourceFile="!(bindpath.OpenBladeInstallerUi)\OpenBlade.Installer.UI.exe">
      <Payloads Include="!(bindpath.OpenBladeInstallerUi)\**">
        <Exclude Files="!(bindpath.OpenBladeInstallerUi)\OpenBlade.Installer.UI.exe" />
        <Exclude Files="!(bindpath.OpenBladeInstallerUi)\*.pdb" />
      </Payloads>
    </BootstrapperApplication>

    <Variable
        Name="LaunchTarget"
        Type="formatted"
        Value="[ProgramFiles64Folder]OpenBlade\OpenBlade.Tray.exe"
        Hidden="no"
        Persisted="no" />

    <Variable
        Name="LaunchWorkingFolder"
        Type="formatted"
        Value="[ProgramFiles64Folder]OpenBlade"
        Hidden="no"
        Persisted="no" />

    <Variable
        Name="OpenBladeSetupProgressPipe"
        Type="string"
        Value=""
        Hidden="yes"
        Persisted="no" />

    <Variable
        Name="OpenBladePurgeProfiles"
        Type="numeric"
        Value="0" />

    <Variable
        Name="OpenBladeBundleOwnerId"
        Type="string"
        Value=""
        Persisted="yes" />

    <util:RegistrySearch
        Id="OpenBladeBundleOwnershipSearch"
        Variable="OpenBladeInstalledVersion"
        Root="HKLM"
        Key="SOFTWARE\OSSBlade\OpenBlade\Installer"
        Value="InstalledVersion"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="OpenBladeVcRuntimeSearch"
        Variable="OpenBladeVcRuntimeInstalled"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Installed"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="OpenBladeVcRuntimeMajorSearch"
        Variable="OpenBladeVcRuntimeMajor"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Major"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="OpenBladeVcRuntimeMinorSearch"
        Variable="OpenBladeVcRuntimeMinor"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Minor"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="OpenBladeVcRuntimeBuildSearch"
        Variable="OpenBladeVcRuntimeBuild"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Bld"
        Result="value"
        Bitness="always64" />

    <Chain>
      <ExePackage
          Id="OpenBladeVcRuntime"
          SourceFile="!(bindpath.OpenBladePrerequisites)\VC_redist.x64.exe"
          DisplayName="!(loc.VcRuntimeDisplayName)"
          Description="!(loc.VcRuntimeDescription)"
          InstallArguments="/install /quiet /norestart"
          RepairArguments="/repair /quiet /norestart"
          UninstallArguments="/uninstall /quiet /norestart"
          DetectCondition="OpenBladeVcRuntimeInstalled AND OpenBladeVcRuntimeMajor AND OpenBladeVcRuntimeMinor AND OpenBladeVcRuntimeBuild AND OpenBladeVcRuntimeInstalled = 1 AND (OpenBladeVcRuntimeMajor &gt; 14 OR (OpenBladeVcRuntimeMajor = 14 AND (OpenBladeVcRuntimeMinor &gt; 50 OR (OpenBladeVcRuntimeMinor = 50 AND OpenBladeVcRuntimeBuild &gt;= 35719))))"
          PerMachine="yes"
          Permanent="yes"
          Cache="remove"
          Vital="yes" />

      <ExePackage
          Id="OpenBladeSetup"
          SourceFile="!(bindpath.OpenBladeBundle)\OpenBlade.Setup.exe"
          DisplayName="!(loc.OpenBladeSetupDisplayName)"
          Description="!(loc.OpenBladeSetupDescription)"
          InstallArguments="install --bundle-managed --bundle-owner-id &quot;[OpenBladeBundleOwnerId]&quot;"
          RepairArguments="install --bundle-managed --bundle-owner-id &quot;[OpenBladeBundleOwnerId]&quot;"
          UninstallArguments="uninstall --bundle-managed --bundle-owner-id &quot;[OpenBladeBundleOwnerId]&quot;"
          DetectCondition="OpenBladeInstalledVersion AND OpenBladeInstalledVersion &gt;= v$(OpenBladeVersion)"
          PerMachine="yes"
          Cache="keep"
          Vital="yes">
        <CommandLine
            Condition="OpenBladePurgeProfiles"
            UninstallArgument="--purge" />
        <CommandLine
            Condition="OpenBladeSetupProgressPipe"
            InstallArgument="--progress-pipe &quot;[OpenBladeSetupProgressPipe]&quot;"
            RepairArgument="--progress-pipe &quot;[OpenBladeSetupProgressPipe]&quot;"
            UninstallArgument="--progress-pipe &quot;[OpenBladeSetupProgressPipe]&quot;" />
        <Payloads Include="!(bindpath.OpenBladeBundle)\**">
          <Exclude Files="!(bindpath.OpenBladeBundle)\OpenBlade.Setup.exe" />
        </Payloads>
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
