<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>OpenBlade.Installer.UI.Tests</AssemblyName>
    <RootNamespace>OpenBlade.Installer.UI.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- WPF text-services COM objects must not be unloaded with a secondary
       xUnit AppDomain after their STA exits. Each test run has its own process. -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBlade.Installer.UI\OpenBlade.Installer.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\tests\OpenBlade.Testing\WindowsVisualTestDesktop.cs"
             Link="WindowsVisualTestDesktop.cs" />
    <Compile Include="..\..\..\src\OpenBlade.Tray\LocalizationSnapshotWindowInput.cs"
             Link="LocalizationSnapshotWindowInput.cs" />
    <Compile Include="..\..\..\src\OpenBlade.Tray\LocalizationSnapshotPixelCanonicalizer.cs"
             Link="LocalizationSnapshotPixelCanonicalizer.cs" />
    <Compile Include="..\..\localization\LocalizationSnapshotFailureEvidence.cs"
             Link="LocalizationSnapshotFailureEvidence.cs" />
  </ItemGroup>

</Project>
