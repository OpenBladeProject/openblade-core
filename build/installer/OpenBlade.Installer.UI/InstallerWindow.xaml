<Window x:Class="OpenBlade.Installer.UI.InstallerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenBlade Setup"
        Width="560"
        Height="430"
        MinWidth="560"
        MinHeight="430"
        MaxWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#44C767" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,3" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="#101010" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="22,18,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="38" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="62" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top"
             Source="/OpenBlade.Installer.UI;component/Assets/OpenBlade.png" />
      <StackPanel Grid.Column="1" Margin="10,2,0,0">
        <TextBlock Text="OpenBlade" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="HeaderSubtitle" Text="Setup" FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="20">
      <Grid>
        <Grid x:Name="LoadingPanel">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Checking this PC…" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <ProgressBar Margin="48,20,48,0" Height="14" IsIndeterminate="True" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ReadyPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="ReadyHeading" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ReadyMessage" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <CheckBox x:Name="PurgeProfilesCheckBox" Margin="0,22,0,0"
                      Content="Remove saved profiles and settings"
                      Visibility="Collapsed" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RepairButton" Content="Repair" Click="RepairButton_Click"
                    Visibility="Collapsed" />
            <Button x:Name="UninstallButton" Content="Uninstall" Click="UninstallButton_Click"
                    Visibility="Collapsed" />
            <Button x:Name="InstallButton" Content="Install" Click="InstallButton_Click"
                    Visibility="Collapsed" />
            <Button Content="Cancel" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ProgressPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="ProgressHeading" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="ProgressMessage" Grid.Row="1" Margin="0,10,0,0"
                     Text="Preparing…" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ProgressBar x:Name="OverallProgress" Grid.Row="2" Margin="0,12,0,0"
                       Height="16" Minimum="0" Maximum="100" />
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="DetailsToggle" Content="Show details"
                          HorizontalAlignment="Left" Checked="DetailsToggle_Changed"
                          Unchecked="DetailsToggle_Changed" />
            <Border x:Name="DetailsBorder" Grid.Row="1" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource InputBrush}" Visibility="Collapsed">
              <TextBox x:Name="DetailsText" IsReadOnly="True" BorderThickness="0"
                       Background="Transparent" Foreground="{DynamicResource TextBrush}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       Padding="8" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" />
            </Border>
          </Grid>
          <Button x:Name="ProgressCancelButton" Grid.Row="4" Content="Cancel"
                  HorizontalAlignment="Right" Click="CancelButton_Click" />
        </Grid>

        <Grid x:Name="SuccessPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SuccessHeading" Text="OpenBlade is ready"
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="SuccessMessage" Margin="0,12,0,0"
                       Text="Setup completed successfully."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LaunchButton" Content="Launch OpenBlade"
                    Click="LaunchButton_Click" Visibility="Collapsed" MinWidth="142" />
            <Button Content="Close" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="FailurePanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Setup could not finish" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="FailureMessage" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenLogButton" Content="Open log" Click="OpenLogButton_Click" />
            <Button Content="Close" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <TextBlock x:Name="VersionText" Grid.Row="2" VerticalAlignment="Bottom"
               Foreground="{DynamicResource SecondaryTextBrush}" />
  </Grid>
</Window>
