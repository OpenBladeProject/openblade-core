<Window x:Class="OpenBlade.Installer.UI.InstallerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenBlade Setup"
        Width="560"
        Height="560"
        MinWidth="560"
        MinHeight="560"
        MaxWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="InputBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextBrush" Color="#202020" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D5D5D5" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#D8D8D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#44C767" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,3" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource ControlHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource ControlPressedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource ControlHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource ControlPressedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="#101010" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="17" Height="17"
                      Background="{DynamicResource InputBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="2">
                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 14,4"
                      Stroke="#101010" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background"
                        Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}" CornerRadius="2" />
                <Border x:Name="PART_GlowRect" Width="90" HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}" CornerRadius="2"
                        Visibility="Collapsed">
                  <Border.RenderTransform>
                    <TranslateTransform X="-90" />
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="IndeterminateStoryboard">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="PART_GlowRect"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       From="-90" To="520" Duration="0:0:1.4" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="22,18,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="38" />
    </Grid.RowDefinitions>

    <Grid x:Name="HeaderPanel" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="62" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="BrandImage" Width="52" Height="52"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             Focusable="False" IsHitTestVisible="False"
             Source="/OpenBlade.Installer.UI;component/Assets/OpenBlade.png" />
      <StackPanel Grid.Column="1" Margin="10,2,0,0">
        <TextBlock Text="OpenBlade" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="HeaderSubtitle" Text="Setup" FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
    </Grid>

    <Grid x:Name="ContentHost" Grid.Row="1" Margin="20,0">
      <Grid>
        <Grid x:Name="LoadingPanel">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Checking this PC…" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <ProgressBar Margin="48,20,48,0" Height="14" IsIndeterminate="True" />
          </StackPanel>
        </Grid>

        <Grid x:Name="ReadyPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="ReadyHeading" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ReadyMessage" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <CheckBox x:Name="PurgeProfilesCheckBox" Margin="0,22,0,0"
                      Content="Remove saved _profiles and settings"
                      Visibility="Collapsed" />
          </StackPanel>
          <UniformGrid Grid.Row="1" Rows="1" HorizontalAlignment="Right">
            <Button x:Name="RepairButton" Content="_Repair" Click="RepairButton_Click"
                    Visibility="Collapsed" />
            <Button x:Name="UninstallButton" Content="_Uninstall" Click="UninstallButton_Click"
                    Visibility="Collapsed" />
            <Button x:Name="InstallButton" Content="_Install" Click="InstallButton_Click"
                    Visibility="Collapsed" />
            <Button x:Name="ReadyCancelButton" Content="_Cancel"
                    Click="ReadyCancelButton_Click" />
          </UniformGrid>
        </Grid>

        <Grid x:Name="ProgressPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="ProgressHeading" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="ProgressMessage" Grid.Row="1" Margin="0,10,0,0"
                     Text="Preparing…" TextTrimming="CharacterEllipsis"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ProgressBar x:Name="OverallProgress" Grid.Row="2" Margin="0,12,0,0"
                       Height="16" Minimum="0" Maximum="100"
                       AutomationProperties.Name="Setup progress" />
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="DetailsToggle" Content="Show _details"
                          HorizontalAlignment="Left" Checked="DetailsToggle_Changed"
                          Unchecked="DetailsToggle_Changed" />
            <Border x:Name="DetailsBorder" Grid.Row="1" Margin="0,8,0,12"
                    MaxHeight="96" VerticalAlignment="Top"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource InputBrush}" Visibility="Collapsed">
              <TextBox x:Name="DetailsText" IsReadOnly="True" BorderThickness="0"
                       AutomationProperties.Name="Setup details"
                       Background="Transparent" Foreground="{DynamicResource TextBrush}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       Padding="8" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled" />
            </Border>
          </Grid>
          <Button x:Name="ProgressCancelButton" Grid.Row="4" Content="_Cancel"
                  HorizontalAlignment="Right" Click="CancelButton_Click" />
        </Grid>

        <Grid x:Name="SuccessPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SuccessHeading" Text="OpenBlade is ready"
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="SuccessMessage" Margin="0,12,0,0"
                       Text="Setup completed successfully."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LaunchButton" Content="_Launch OpenBlade"
                    Click="LaunchButton_Click" Visibility="Collapsed" MinWidth="142" />
            <Button x:Name="SuccessCloseButton" Content="_Close" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="FailurePanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Setup could not finish" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="FailureMessage" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenLogButton" Content="_Open log" Click="OpenLogButton_Click" />
            <Button x:Name="FailureCloseButton" Content="_Close" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="CancelConfirmationPanel" Panel.ZIndex="10"
              KeyboardNavigation.TabNavigation="Cycle"
              Background="{DynamicResource WindowBrush}" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Cancel setup?" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Margin="16,12,16,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="OpenBlade will stop safely and restore the previous installation state." />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="KeepWorkingButton" Content="Keep _working"
                    Click="KeepWorkingButton_Click" MinWidth="112" />
            <Button x:Name="ConfirmCancelButton" Content="Cancel _setup"
                    Click="ConfirmCancelButton_Click" MinWidth="112" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <TextBlock x:Name="VersionText" Grid.Row="2" VerticalAlignment="Bottom"
               Foreground="{DynamicResource SecondaryTextBrush}" />
  </Grid>
</Window>
