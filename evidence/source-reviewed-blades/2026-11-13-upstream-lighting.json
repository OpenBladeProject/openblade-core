    "findings": [
      {
        "id": "0253-exact-definition",
        "claim": "RazerBlade15Advanced2020 declares USB1532:0253, a6x16 matrix, built-in setters, custom effect/frame methods, logo active methods and software ripple. Setter availability does not establish independent firmware confirmation.",
        "sourcePath": "daemon/openrazer_daemon/hardware/keyboards.py",
        "startLine": 1894,
        "endLine": 1908,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/daemon/openrazer_daemon/hardware/keyboards.py#L1894-L1908"
      },
      {
        "id": "0253-kernel-admission",
        "claim": "Exact0253 kernel branch creates builtin effect, custom effect/frame and logo-state sysfs files.",
        "sourcePath": "driver/razerkbd_driver.c",
        "startLine": 5891,
        "endLine": 5929,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L5891-L5929"
      },
      {
