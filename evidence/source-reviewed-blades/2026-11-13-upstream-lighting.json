        "startLine": 4220,
        "endLine": 4259,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L4220-L4259"
      },
      {
        "id": "0253-brightness-getter-path",
        "claim": "Exact0253 routes brightness reads through the Blade-specific helper; brightness is independently queried.",
        "sourcePath": "driver/razerkbd_driver.c",
        "startLine": 4391,
        "endLine": 4452,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L4391-L4452"
