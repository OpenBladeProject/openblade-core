      },
      {
        "id": "restore-replays-cache",
        "claim": "restore_effect selects a setter from the cached/persisted effect and replays cached colors,speed and direction. It cannot recover an arbitrary independently read firmware baseline.",
        "sourcePath": "daemon/openrazer_daemon/hardware/device_base.py",
        "startLine": 453,
        "endLine": 520,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/daemon/openrazer_daemon/hardware/device_base.py#L453-L520"
      },
      {
        "id": "submission-ack",
        "claim": "Transport checks report length,remaining packets,class and command,accepts success or busy,and may retry. This is command-response handling,not independent effect readback; OpenBlade must retain its own stop-on-ambiguity semantics.",
        "sourcePath": "driver/razerkbd_driver.c",
        "startLine": 438,
        "endLine": 494,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L438-L494"
      },
      {
        "id": "alternate-brightness-contract",
        "claim": "OpenRazer defines Blade brightness set0E/04 args[1,brightness] and get0E/84 args[1,0]. This differs from the separately reviewed Synapse03/03 and03/83 LED path. No replacement is needed.",
        "sourcePath": "driver/razerchromacommon.c",
        "startLine": 993,
        "endLine": 1013,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerchromacommon.c#L993-L1013"
