        "startLine": 550,
        "endLine": 581,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/daemon/openrazer_daemon/hardware/device_base.py#L550-L581"
      },
      {
