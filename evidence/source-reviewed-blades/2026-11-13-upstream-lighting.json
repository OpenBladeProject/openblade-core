        "startLine": 208,
        "endLine": 248,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerchromacommon.c#L208-L248"
      },
      {
        "id": "0253-standard-path",
        "claim": "Exact0253 is in the standard legacy Wave setter branch, using transactionFF rather than a newer0F matrix API.",
        "sourcePath": "driver/razerkbd_driver.c",
        "startLine": 2550,
        "endLine": 2580,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L2550-L2580"
      },
      {
        "id": "breathing-setters",
        "claim": "Legacy03/0A Breathing carries type3 random,type1 single,type2 dual plus RGB fields.",
        "sourcePath": "driver/razerchromacommon.c",
        "startLine": 351,
        "endLine": 379,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerchromacommon.c#L351-L379"
      },
      {
        "id": "custom-frame-geometry",
        "claim": "Standard custom-row helper encodes03/0B with frameFF,row,start/end inclusive and RGB bytes. Exact0253 selects that helper. Geometry evidence is separate from region-specific key mapping.",
        "sourcePath": "driver/razerchromacommon.c",
        "startLine": 450,
        "endLine": 471,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerchromacommon.c#L450-L471"
      },
      {
        "id": "0253-custom-frame-path",
        "claim": "Exact0253 selects the standard custom-frame row helper and transactionFF.",
        "sourcePath": "driver/razerkbd_driver.c",
        "startLine": 4651,
        "endLine": 4682,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L4651-L4682"
      },
      {
        "id": "effect-write-only",
        "claim": "Builtin matrix effects and custom effect/frame attributes have no read callback. The separately readable pulsate attribute does not establish a0253 matrix-effect getter.",
        "sourcePath": "driver/razerkbd_driver.c",
        "startLine": 4936,
        "endLine": 4947,
        "url": "https://github.com/openrazer/openrazer/blob/477f4d6d3ab7e9deb6310d5bd3742560c5cbe80d/driver/razerkbd_driver.c#L4936-L4947"
      },
      {
