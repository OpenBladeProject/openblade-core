<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="OpenBlade.Testing.AsyncTest" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OpenBlade.Testing\AsyncTest.cs" Link="AsyncTest.cs" />
    <Compile Include="..\OpenBlade.Testing\UnavailableServiceClient.cs"
             Link="UnavailableServiceClient.cs" />
    <Compile Include="..\..\src\OpenBlade.Setup\StartupShortcutWriter.cs"
             Link="StartupShortcutWriter.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\WindowNotificationCoordinator.cs"
             Link="WindowNotificationCoordinator.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\ITrayIconHost.cs"
             Link="ITrayIconHost.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\WindowsStartupRegistration.cs"
             Link="WindowsStartupRegistration.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\ElevatedServiceControlLauncher.cs"
             Link="ElevatedServiceControlLauncher.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\GpuAppCleanupCoordinator.cs" Link="GpuAppCleanupCoordinator.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\GpuAppForceCloseOutcomeTracker.cs"
             Link="GpuAppForceCloseOutcomeTracker.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\PageHeaderLayoutPolicy.cs"
             Link="PageHeaderLayoutPolicy.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\LocalizationSnapshotPixelCanonicalizer.cs"
             Link="LocalizationSnapshotPixelCanonicalizer.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\RazerServiceStopOperation.cs"
             Link="RazerServiceStopOperation.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\ServiceStateConfirmation.cs"
             Link="ServiceStateConfirmation.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\WindowsServiceStateConfirmation.cs"
             Link="WindowsServiceStateConfirmation.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\WindowsServiceStartOperation.cs"
             Link="WindowsServiceStartOperation.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\TrayCompleteShutdownCoordinator.cs"
             Link="TrayCompleteShutdownCoordinator.cs" />
    <Compile Include="..\..\src\OpenBlade.Tray\TrayServiceStartCoordinator.cs"
             Link="TrayServiceStartCoordinator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenBlade.Session\OpenBlade.Session.csproj" />
    <ProjectReference Include="..\..\src\OpenBlade.Tray.Core\OpenBlade.Tray.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildTrayForXamlStartupSmoke" BeforeTargets="Build">
    <MSBuild Projects="..\..\src\OpenBlade.Tray\OpenBlade.Tray.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);OpenBladeDeveloperHarness=true"
             BuildInParallel="false" />
    <MSBuild Projects="..\..\src\OpenBlade.Tray\OpenBlade.Tray.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);OpenBladeLocalizationPreview=true"
             BuildInParallel="false" />
  </Target>

</Project>
