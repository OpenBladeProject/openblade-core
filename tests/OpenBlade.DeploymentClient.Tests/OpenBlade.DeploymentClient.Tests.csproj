<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>OpenBlade.DeploymentClient.Tests.LaunchFixture</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenBlade.Contracts\OpenBlade.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OpenBlade.DeploymentClient\OpenBlade.DeploymentClient.csproj" />
  </ItemGroup>
  <!-- The test SDK sets OutputType=Exe after project properties are evaluated.
       Keep the launch fixture windowed before compilation and apphost creation. -->
  <Target Name="PreserveWindowedLaunchFixture" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <OutputType>WinExe</OutputType>
    </PropertyGroup>
  </Target>
</Project>
