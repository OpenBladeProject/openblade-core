[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
DriverVer=08/14/2026,0.6.0.0
CatalogFile=OpenBlade.BrightnessHid.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskDescription%,,,

[SourceDisksFiles]
OpenBlade.BrightnessHid.dll=1

[Manufacturer]
%Manufacturer%=OSSBlade,NTamd64.10.0...26100

[OSSBlade.NTamd64.10.0...26100]
%DeviceDescription%=OpenBladeBrightnessHid,ROOT\OSSBLADE_OPENBLADE_BRIGHTNESS_HID

[OpenBladeBrightnessHid.NT]
CopyFiles=OpenBladeBrightnessHid.Copy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[OpenBladeBrightnessHid.NT.HW]
AddReg=OpenBladeBrightnessHid.Security
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.HW
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.HW

[OpenBladeBrightnessHid.Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;UD)"

[OpenBladeBrightnessHid.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[OpenBladeBrightnessHid.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[OpenBladeBrightnessHid.NT.Wdf]
UmdfService="OpenBlade.BrightnessHid",OpenBladeBrightnessHid.Install
UmdfServiceOrder=OpenBlade.BrightnessHid
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[OpenBladeBrightnessHid.Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\OpenBlade.BrightnessHid.dll"

[OpenBladeBrightnessHid.Copy]
OpenBlade.BrightnessHid.dll

[Strings]
Provider="OSSBlade"
Manufacturer="OSSBlade"
DiskDescription="OpenBlade display brightness HID driver"
DeviceDescription="OpenBlade Display Brightness HID"
