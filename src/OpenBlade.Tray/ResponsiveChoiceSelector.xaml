<UserControl
    x:Class="OpenBlade.Tray.ResponsiveChoiceSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <SelectorBar x:Name="ExpandedSelector"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"
                     SelectionChanged="OnExpandedSelectionChanged" />
        <ComboBox x:Name="CompactSelector"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  SelectionChanged="OnCompactSelectionChanged"
                  DropDownOpened="OnCompactDropDownOpened"
                  DropDownClosed="OnCompactDropDownClosed" />
    </Grid>
</UserControl>
