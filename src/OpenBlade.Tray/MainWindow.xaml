                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource SystemFillColorCautionBrush}"
                                        CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.PlatformCompatibilityWarningTitle, Mode=OneWay}"
                                               Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AboutTestedPlatformWarningMessage, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        </StackPanel>

