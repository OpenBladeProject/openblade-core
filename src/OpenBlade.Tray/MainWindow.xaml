                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Firmware" Style="{StaticResource SecondaryTextStyle}" />
                                        <Grid Grid.Column="1" ColumnSpacing="24">
