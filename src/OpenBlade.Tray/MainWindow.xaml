                                        <TextBlock x:Uid="MainWindow_TextBlockVBIOS" Text="VBIOS" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutVbiosVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="MainWindow_TextBlockUSBDevice" Text="USB device" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingUsbDeviceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="MainWindow_TextBlockPlatform" Text="Platform" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="MainWindow_TextBlockWindows11X64" Grid.Column="1" Text="Windows 11 x64" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Uid="MainWindow_OfficialFirmwareUpdatesCardText" x:Name="OfficialFirmwareUpdatesCard"
                                Style="{StaticResource SettingsGroupStyle}"
                                Margin="0,18,0,0"
                                Visibility="{x:Bind FirmwareUpdateViewModel.IsSupported, Mode=OneWay}"
                                AutomationProperties.Name="Official Razer firmware update assistant">
                            <StackPanel>
                                <Border x:Name="FirmwareHeaderSection"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="MainWindow_TextBlockOfficialFirmware" Text="Official firmware"
                                                           Style="{StaticResource CardTitleStyle}"
                                                           VerticalAlignment="Center" />
                                                <ProgressRing x:Uid="MainWindow_ProgressRingCheckingRazerForFirmwareVersions" Grid.Column="1"
                                                              Style="{StaticResource FirmwareProgressRingStyle}"
                                                              IsActive="{x:Bind FirmwareUpdateViewModel.IsChecking, Mode=OneWay}"
                                                              Visibility="{x:Bind FirmwareUpdateViewModel.IsChecking, Mode=OneWay}"
                                                              AutomationProperties.Name="Checking Razer for firmware versions" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.StatusText, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Uid="MainWindow_ButtonCheckForUpdates" Grid.Column="1"
                                                Content="Check for updates"
                                                Command="{x:Bind FirmwareUpdateViewModel.CheckCommand}"
                                                AutomationProperties.Name="Check official Razer firmware versions" />
                                    </Grid>
                                </Border>

                                <Border x:Name="FirmwareCheckIntervalSection"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,14">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockCheckInterval2" Text="Check interval"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChecksAtStartupWhenDue2" Text="Checks at startup when due."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Uid="MainWindow_ResponsiveChoiceSelectorFirmwareUpdateCheckInterval" Grid.Column="1"
                                                                        CompactMinWidth="160"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="Firmware update check interval"
                                                                        ItemsSource="{x:Bind FirmwareUpdateViewModel.IntervalOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        SelectedItem="{x:Bind FirmwareUpdateViewModel.SelectedIntervalOption, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="FirmwareVersionsSection"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,14">
                                    <Grid ColumnSpacing="24" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="MainWindow_TextBlockFirmware" Text="Firmware" Style="{StaticResource SecondaryTextStyle}" />
                                        <Grid Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockInstalled" Text="Installed" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockLatest" Grid.Column="1" Text="Latest" Style="{StaticResource SecondaryTextStyle}" />
                                        </Grid>
                                        <TextBlock x:Uid="MainWindow_TextBlockBIOS2" Grid.Row="1" Text="BIOS" Style="{StaticResource CardTitleStyle}" />
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.InstalledBiosVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FirmwareUpdateViewModel.PublishedBiosVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock x:Uid="MainWindow_TextBlockEC2" Grid.Row="2" Text="EC" Style="{StaticResource CardTitleStyle}" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.InstalledEcVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FirmwareUpdateViewModel.PublishedEcVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock x:Uid="MainWindow_TextBlockMCU2" Grid.Row="3" Text="MCU" Style="{StaticResource CardTitleStyle}" />
                                        <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.InstalledMcuVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FirmwareUpdateViewModel.PublishedMcuVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="FirmwareFooterSection"
                                        Style="{StaticResource SettingsLastRowStyle}"
                                        Padding="0">
                                    <HyperlinkButton x:Uid="MainWindow_HyperlinkButtonOpenOfficialRazerFirmwareSupportPage" NavigateUri="{x:Bind FirmwareUpdateViewModel.OfficialSupportUri, Mode=OneWay}"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     CornerRadius="0,0,8,8"
                                                     AutomationProperties.Name="Open official Razer firmware support page"
                                                     ToolTipService.ToolTip="Open official Razer firmware support page">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock x:Uid="MainWindow_TextBlockOpenOfficialRazerPage" Text="Open official Razer page"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock x:Uid="MainWindow_TextBlockViewFirmwareDownloadsAndReleaseDetailsOn" Text="View firmware downloads and release details on Razer's site."
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1"
                                                      Glyph="&#xE8A7;"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource CardActionIconStyle}" />
                                        </Grid>
                                    </HyperlinkButton>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Uid="MainWindow_AboutTestedPlatformWarningText" x:Name="AboutTestedPlatformWarning"
                                Style="{StaticResource CardStyle}"
                                Margin="0,18,0,0"
                                Padding="16"
                                Visibility="{x:Bind ViewModel.HasUntestedPlatformVersion, Mode=OneWay}"
                                AutomationProperties.Name="System version compatibility warning">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource SystemFillColorCautionBrush}"
                                        CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.PlatformCompatibilityWarningTitle, Mode=OneWay}"
                                               Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AboutTestedPlatformWarningMessage, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        </StackPanel>

                        <StackPanel x:Name="AboutSupportSection">
                        <TextBlock x:Uid="MainWindow_TextBlockSupport" Text="Support" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <Button x:Uid="MainWindow_ButtonExportDiagnostics" Style="{StaticResource IconActionButtonStyle}"
                                            CornerRadius="8,8,0,0"
                                            Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                                            AutomationProperties.Name="Export diagnostics"
                                            ToolTipService.ToolTip="Export diagnostics">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="MainWindow_TextBlockExportDiagnostics" Text="Export diagnostics" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockSaveLogsAndSystemDetailsWithSensitive" Text="Save logs and system details with sensitive information removed." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE896;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </Button>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton x:Uid="MainWindow_HyperlinkButtonOpenGitHubIssues" NavigateUri="https://github.com/OSSBlade/openblade-core/issues"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="Open GitHub Issues"
                                                     ToolTipService.ToolTip="Open GitHub Issues">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="MainWindow_TextBlockReportAProblem" Text="Report a problem" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockOpenGitHubIssuesToReportABug" Text="Open GitHub Issues to report a bug or request an improvement." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton x:Uid="MainWindow_HyperlinkButtonOpenDocumentation" NavigateUri="https://github.com/OSSBlade/openblade-docs"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="Open documentation"
                                                     ToolTipService.ToolTip="Open documentation">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="MainWindow_TextBlockDocumentation" Text="Documentation" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockReadSetupUsageAndCompatibilityInformation" Text="Read setup, usage, and compatibility information." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton x:Uid="MainWindow_HyperlinkButtonOpenReleaseNotes" NavigateUri="https://github.com/OSSBlade/openblade-core/blob/main/CHANGELOG.md"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="Open release notes"
                                                     ToolTipService.ToolTip="Open release notes">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="MainWindow_TextBlockReleaseNotes" Text="Release notes" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockSeeWhatChangedInEachOpenBladeBuild" Text="See what changed in each OpenBlade build." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}" Padding="0">
                                    <HyperlinkButton x:Uid="MainWindow_HyperlinkButtonOpenSourceCode" NavigateUri="https://github.com/OSSBlade/openblade-core"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     CornerRadius="0,0,8,8"
                                                     AutomationProperties.Name="Open source code"
                                                     ToolTipService.ToolTip="Open source code">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="MainWindow_TextBlockSourceCode" Text="Source code" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockViewAndContributeToOpenBladeOnGitHub" Text="View and contribute to OpenBlade on GitHub." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutTroubleshootingSection">
                        <TextBlock x:Uid="MainWindow_TextBlockTroubleshooting" Text="Troubleshooting" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Expander x:Uid="MainWindow_TroubleshootingExpanderText" x:Name="TroubleshootingExpander"
                                      Style="{StaticResource CardContentExpanderStyle}"
                                      PointerEntered="OnTroubleshootingHeaderPointerEntered"
                                      PointerMoved="OnTroubleshootingHeaderPointerMoved"
                                      PointerExited="OnTroubleshootingHeaderPointerExited"
                                      PointerPressed="OnTroubleshootingHeaderPointerPressed"
                                      PointerReleased="OnTroubleshootingHeaderPointerReleased"
                                      PointerCanceled="OnTroubleshootingHeaderPointerCanceled"
                                      PointerCaptureLost="OnTroubleshootingHeaderPointerCanceled"
                                      AutomationProperties.Name="Troubleshooting details">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Grid x:Name="TroubleshootingHeaderSurface"
                                          Margin="-16,0,-60,0">
                                        <Border x:Name="TroubleshootingHeaderHoverBackground"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <Border x:Name="TroubleshootingHeaderPressedBackground"
                                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <StackPanel Spacing="3" Margin="16,14,60,14">
                                            <TextBlock x:Uid="MainWindow_TextBlockServiceAndDeviceStatus" Text="Service and device status" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockViewLiveConnectionAndControlDetails" Text="View live connection and control details." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockOpenBladeService" Text="OpenBlade service" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Margin="0,0,7,0"
                                                             Visibility="{x:Bind ViewModel.IsServiceUnavailable, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingServiceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                                <Button x:Uid="MainWindow_StartOpenBladeButtonText" x:Name="StartOpenBladeButton"
                                                        Grid.Column="2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.IsServiceUnavailable, Mode=OneWay}"
                                                        Click="OnStartOpenBlade"
                                                        AutomationProperties.LiveSetting="Polite"
                                                        AutomationProperties.Name="Start OpenBlade">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ProgressRing x:Name="StartOpenBladeProgressRing"
                                                                      Width="14"
                                                                      Height="14"
                                                                      IsActive="False"
                                                                      Opacity="0"
                                                                      AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock x:Uid="MainWindow_TextBlockStartOpenBlade" Text="Start OpenBlade" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockLaptopBehavior2" Text="Laptop behavior" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <ProgressRing Width="12" Height="12"
                                                                  Margin="0,0,7,0"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Margin="0,0,7,0"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Margin="0,0,7,0"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingControlsStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockKeyboardDriverMode" Text="Keyboard driver mode" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ViewModel.TroubleshootingKeyboardDriverModeStatus, Mode=OneWay}"
                                                       Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockPowerSource" Text="Power source" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingPowerSourceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockOtherRazerSoftwareRunning" Text="Other Razer software running" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind ViewModel.TroubleshootingOtherRazerSoftwareStatus, Mode=OneWay}"
                                                           Style="{StaticResource TroubleshootingValueStyle}"
                                                           TextWrapping="Wrap" />
                                                <Button x:Uid="MainWindow_StopRazerServicesButtonText" x:Name="StopRazerServicesButton"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Style="{StaticResource DestructiveButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Click="OnStopRazerServices"
                                                        AutomationProperties.Name="Stop Razer services"
                                                        AutomationProperties.LiveSetting="Polite">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <ProgressRing x:Name="StopRazerServicesProgressRing"
                                                                      Width="14"
                                                                      Height="14"
                                                                      IsIndeterminate="True"
                                                                      IsActive="False"
                                                                      Visibility="Collapsed" />
                                                        <FontIcon x:Name="StopRazerServicesIcon"
                                                                  Glyph="&#xE71A;"
                                                                  FontSize="14" />
                                                        <TextBlock x:Uid="MainWindow_StopRazerServicesButtonLabelText" x:Name="StopRazerServicesButtonLabel"
                                                                   Text="Stop services" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}" Visibility="{x:Bind ViewModel.HasTroubleshootingRecentError, Mode=OneWay}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_TextBlockRecentError" Text="Recent error" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingRecentErrorStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
