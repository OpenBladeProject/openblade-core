                                            </Grid.ColumnDefinitions>
                                            <Slider x:Uid="MainWindow_DisplayBrightnessEditor" x:Name="DisplayBrightnessSlider"
                                                    Style="{StaticResource InlineCardSliderStyle}"
                                                    Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                                                    IsThumbToolTipEnabled="True"
                                                    AutomationProperties.Name="Display brightness in percent"
                                                    Value="{x:Bind BrightnessSliderValue, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanChangeBrightness, Mode=OneWay}"
                                                    Loaded="OnDisplayBrightnessSliderLoaded"
                                                    Unloaded="OnDisplayBrightnessSliderUnloaded"
                                                    ValueChanged="OnDisplayBrightnessSliderValueChanged" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value, ElementName=DisplayBrightnessSlider}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="%" Style="{StaticResource CardTitleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Uid="MainWindow_DisplayBrightnessUnavailableText" Grid.Column="1"
                                                   Text="Unavailable" Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsBrightnessUnavailable, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" />
                        </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="OpenBlade"
                  Background="Transparent" />

        <NavigationView x:Uid="MainWindow_MainNavigationText" x:Name="MainNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <!-- The stock indicator can be clipped while traveling between
                     distant items. The selected Fluent background stays clear
                     and changes immediately without that motion artifact. -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow_HomeNavigationItemText" x:Name="HomeNavigationItem"
                                    Content="Dashboard"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeDashboardHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasDashboardProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="Dashboard has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfilesNavigationItem" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Uid="MainWindow_TextBlockProfiles" Text="Profiles" />
                    </NavigationViewItem.Content>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeProfilesHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasUnsavedProfileChanges, Mode=OneWay}"
                                   AutomationProperties.Name="Profiles has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_DisplayNavigationItemText" x:Name="DisplayNavigationItem" Content="Display" Tag="display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeDisplayHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}"
                                   AutomationProperties.Name="Display has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_LaptopNavigationItemText" x:Name="LaptopNavigationItem"
                                    Content="Laptop"
                                    Tag="laptop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeLaptopHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLaptopPageProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="Laptop has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_ThxAudioNavigationItemText" x:Name="ThxAudioNavigationItem"
                                    Content="THX Audio" Tag="thx-audio"
                                    Visibility="{x:Bind ThxAudioNavigationVisibility, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <!-- Product736 THX mark; provenance in docs/thx-audio.md.
                             The vector inherits the navigation foreground in both themes. -->
                        <PathIcon x:Name="ThxAudioNavigationLogo" Width="20" Height="20"
                                  Data="M20,0 L20,1 L3.5,1 L3.5,6.5 L2.5,6.5 L2.5,1 L0,1 L0.01,0 Z M0,8 L20,8 L20,7 L0,7 Z M5.25,6.5 L6.25,6.5 L6.25,4.5 L10.25,4.5 L10.25,6.5 L11.25,6.5 L11.25,1.5 L10.25,1.5 L10.25,3.5 L6.25,3.5 L6.25,1.5 L5.25,1.5 Z M13.5,6.5 L15.522,4.443 L17.5,6.5 L19,6.5 L16.317,3.776 L18.624,1.5 L17.131,1.5 L15.431,3.166 L13.75,1.5 L12.25,1.5 L14.612,3.823 L12,6.5">
                            <!-- Center the 20x8 mark inside the 20x20 icon canvas. -->
                            <PathIcon.RenderTransform>
                                <TranslateTransform Y="6" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_LightingNavigationItemText" x:Name="LightingNavigationItem"
                                    Content="Lighting"
                                    Tag="lighting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE781;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeLightingHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLightingProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="Lighting has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Telemetry_Navigation" x:Name="TelemetryNavigationItem" Content="Telemetry" Tag="telemetry">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_SettingsNavigationItemText" x:Name="SettingsNavigationItem"
                                    Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="MainWindow_AboutNavigationItemText" x:Name="AboutNavigationItem"
                                    Content="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="HomePage"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=HomePage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <local:ResponsivePageHeader x:Name="DashboardPageHeader"
                                                    Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="MainWindow_TextBlockDashboard"
                                       Text="Dashboard"
                                       Style="{StaticResource PageHeaderTitleStyle}"
                                       local:ResponsivePageHeader.Role="Title" />
                            <StackPanel x:Name="DashboardProfileSaveActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.HasDashboardProfileActionOpportunity, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        local:ResponsivePageHeader.Role="ProfileActions">
                                <Button Content="{x:Bind ViewModel.DashboardProfileSaveLabel, Mode=OneWay}"
                                        Style="{StaticResource ProfileSaveButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasDashboardProfileSaveOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SaveProfilesCommand}" />
                                <Button x:Uid="MainWindow_ButtonUseProfileSettings" Content="Use profile settings"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasDashboardProfileRestoreOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.DiscardProfileDraftCommand}" />
                            </StackPanel>
                            <Button x:Uid="MainWindow_ButtonCustomize"
                                    Grid.Column="2"
                                    Content="Customize"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    AutomationProperties.Name="Customize dashboard"
                                    Click="OnCustomizeDashboard"
                                    local:ResponsivePageHeader.Role="Customize" />
                        </local:ResponsivePageHeader>

                        <Grid x:Name="DashboardCardHost">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Border x:Name="DeviceStatusCard"
                                Style="{StaticResource CardStyle}"
                                Padding="22">
                            <Grid x:Name="HeroLayout" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Uid="MainWindow_ProfileStateBadgeText" x:Name="ProfileStateBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Click="OnProfileStateBadgeClick"
                                                AutomationProperties.Name="Open troubleshooting details"
                                                 ToolTipService.ToolTip="View device status">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessReady, Mode=OneWay}" />
                                                    <ProgressRing Width="12" Height="12"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                             </StackPanel>
                                         </Button>
                                        <Button x:Uid="MainWindow_TestedPlatformWarningBadgeText" x:Name="TestedPlatformWarningBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasUntestedPlatformVersion, Mode=OneWay}"
                                                Click="OnTestedPlatformWarningClick"
                                                AutomationProperties.Name="Review untested system versions"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.DashboardTestedPlatformWarningMessage, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.PlatformCompatibilityWarningTitle, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Uid="MainWindow_AttentionIndicatorText" x:Name="AttentionIndicator"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                                AutomationProperties.Name="Show warning details"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}">
                                            <Button.Flyout>
                                                <Flyout x:Name="AttentionFlyout"
                                                        Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel MaxWidth="360" Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <Button x:Uid="MainWindow_ButtonReapplyOpenBladeSettings" HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanReapplyChangedSettings, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.ShowReapplyChangedSettings, Mode=OneWay}"
                                                                Click="OnReapplyChangedSettingsClick"
                                                                AutomationProperties.Name="Reapply OpenBlade settings">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}" />
                                                                <TextBlock x:Uid="MainWindow_TextBlockReapplyOpenBladeSettings" Text="Reapply OpenBlade settings" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Uid="MainWindow_ButtonCheckCurrentState" HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanCheckCurrentState, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.HasUnconfirmedWrites, Mode=OneWay}"
                                                                Click="OnCheckCurrentStateClick"
                                                                AutomationProperties.Name="Check current state">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsCheckCurrentStateOperationInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsCheckCurrentStateOperationInProgress, Mode=OneWay}" />
                                                                <TextBlock x:Uid="MainWindow_TextBlockCheckCurrentState" Text="Check current state" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Uid="MainWindow_ButtonRecoverHyperBoostRestoreAttention" HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanRecoverHyperBoostRestore, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.HasPendingHyperBoostRestore, Mode=OneWay}"
                                                                Click="OnRecoverHyperBoostRestoreClick"
                                                                AutomationProperties.Name="Retry saved HyperBoost restore">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsHyperBoostRestoreRecoveryInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsHyperBoostRestoreRecoveryInProgress, Mode=OneWay}" />
                                                                <TextBlock x:Uid="MainWindow_TextBlockRecoverHyperBoostRestoreAttention" Text="Retry saved setting" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="AttentionIndicatorLabel"
                                                           Text="{x:Bind ViewModel.AttentionBadgeLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ActivePerformanceLabel, Mode=OneWay}"
                                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveFanModeLabel, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBatterySettingLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="HeroReadings"
                                        Grid.Row="1"
                                        Margin="0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.LiveReadingsRefreshToolTip, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ShowDashboardLiveReadings, Mode=OneWay}">
                                    <Grid Background="Transparent">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="340"
                                                           Text="{x:Bind ViewModel.LiveReadingsRefreshToolTip, Mode=OneWay}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleDashboardTelemetryGroups, Mode=OneWay}"
                                                       HorizontalAlignment="Stretch">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout Orientation="Horizontal"
                                                                   MinItemWidth="100"
                                                                   MinItemHeight="48"
                                                                   MinColumnSpacing="0"
                                                                   MaximumRowsOrColumns="3"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:LiveReadingGroupDisplayItem">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                                                   Style="{StaticResource SecondaryTextStyle}" />
                                                        <TextBlock Text="{x:Bind Value, Mode=OneTime}"
                                                                   Style="{StaticResource CardTitleStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>

                        <InfoBar x:Uid="MainWindow_OperationErrorInfoBarText" x:Name="OperationErrorInfoBar"
                                 IsOpen="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.OperationFeedbackMessage, Mode=OneWay}"
                                 Severity="Error"
                                 IsClosable="True"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Operation error" />

                        <InfoBar x:Uid="MainWindow_HardwareControlUnavailableInfoBarText"
                                 IsOpen="{x:Bind ViewModel.HasHardwareControlUnavailableMessage, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasHardwareControlUnavailableMessage, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.HardwareControlUnavailableMessage, Mode=OneWay}"
                                 Severity="Warning"
                                 IsClosable="False"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Laptop control availability">
                            <InfoBar.ActionButton>
                                <Button x:Uid="MainWindow_BlockedControlsCheckCurrentStateButton"
                                        IsEnabled="{x:Bind ViewModel.CanCheckCurrentState, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ShowHardwareControlStateCheck, Mode=OneWay}"
                                        Click="OnCheckCurrentStateClick"
                                        AutomationProperties.Name="Check current state">
                                    <TextBlock x:Uid="MainWindow_BlockedControlsCheckCurrentStateLabel" Text="Check current state" />
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <InfoBar x:Uid="MainWindow_ExperimentalSupportInfoBar" x:Name="ExperimentalSupportInfoBar"
                                 IsOpen="{x:Bind ViewModel.IsExperimentalDevice, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsExperimentalDevice, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ExperimentalSupportNotice, Mode=OneWay}"
                                 Severity="Informational"
                                 IsClosable="False"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Experimental laptop support">
                            <InfoBar.ActionButton>
                                <Button x:Uid="MainWindow_ResumeExperimentalWritesButton"
                                        Command="{x:Bind ViewModel.ResumeExperimentalWritesCommand}"
                                        Visibility="{x:Bind ViewModel.ExperimentalWritesPaused, Mode=OneWay}"
                                        AutomationProperties.Name="Resume experimental controls">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing Width="16"
                                                      Height="16"
                                                      IsActive="{x:Bind ViewModel.IsResumeExperimentalWritesOperationInProgress, Mode=OneWay}"
                                                      Visibility="{x:Bind ViewModel.IsResumeExperimentalWritesOperationInProgress, Mode=OneWay}" />
                                        <TextBlock x:Uid="MainWindow_ResumeExperimentalWritesLabel"
                                                   Text="Resume experimental controls" />
                                    </StackPanel>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Uid="MainWindow_UnsupportedLaptopInfoBarText"
                                 IsOpen="{x:Bind ViewModel.IsUnsupportedLaptop, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsUnsupportedLaptop, Mode=OneWay}"
                                 Title="This laptop isn’t supported yet"
                                 Message="{x:Bind ViewModel.UnsupportedLaptopMessage}"
                                 Severity="Informational"
                                 IsClosable="False"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Unsupported laptop">
                            <InfoBar.ActionButton>
                                <Button x:Uid="MainWindow_UnsupportedLaptopHelpAddSupportButton"
                                        Command="{x:Bind ViewModel.HelpAddSupportCommand}"
                                        AutomationProperties.Name="Help add support">
                                    <TextBlock x:Uid="MainWindow_UnsupportedLaptopHelpAddSupportLabel" Text="Help add support" />
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Border x:Name="DashboardEmptyState"
                                Style="{StaticResource CardStyle}"
                                Padding="22"
                                Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="MainWindow_TextBlockYourDashboardIsEmpty" Text="Your Dashboard is empty"
                                           Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Uid="MainWindow_TextBlockUseCustomizeToAddTheCardsYou" Text="Use Customize to add the cards you want to see here."
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProfilesPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=ProfilesPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <local:ResponsivePageHeader x:Name="ProfilesPageHeader"
                                                    Margin="0,0,0,20">
                            <local:ResponsivePageHeader.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </local:ResponsivePageHeader.RowDefinitions>
                            <local:ResponsivePageHeader.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </local:ResponsivePageHeader.ColumnDefinitions>
                            <TextBlock x:Uid="MainWindow_TextBlockProfiles2" Text="Profiles"
                                       Style="{StaticResource PageHeaderTitleStyle}"
                                       local:ResponsivePageHeader.Role="Title" />
                            <StackPanel x:Name="ProfilesHeaderActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        local:ResponsivePageHeader.Role="ProfileActions">
                                <Button x:Uid="MainWindow_ButtonImportProfiles" Content="Import profiles"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Click="OnImportProfiles"
                                        ToolTipService.ToolTip="Import saved profiles from JSON"
                                        AutomationProperties.Name="Import profiles from JSON" />
                                <Button x:Uid="MainWindow_ButtonExportProfiles" Content="Export profiles"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Click="OnExportProfiles"
                                        ToolTipService.ToolTip="Export saved profiles as JSON"
