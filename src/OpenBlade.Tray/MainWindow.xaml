                                                <DataTemplate x:DataType="local:TrayHoverLabelItemOption">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE76F;"
                                                                  FontSize="14"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="1"
                                                                  Content="{x:Bind Label, Mode=OneTime}"
                                                                  IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Spacing="4" Margin="4,4,4,0">
                                            <TextBlock Text="Preview"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.TrayHoverLabelText, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8"
                                                  Visibility="{x:Bind ViewModel.HasTrayHoverLabelOverflow, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind ViewModel.TrayHoverLabelOverflowMessage, Mode=OneWay}"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsUpdatesSection">
