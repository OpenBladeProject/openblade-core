                                    <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                        <StackPanel Spacing="3" Margin="16,14,60,14">
                                            <TextBlock x:Uid="MainWindow_TextBlockTaskbarHoverLabel" Text="Taskbar hover label" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChooseWhetherToShowTheAppName" Text="Choose whether to show the app name, profile, and live details when you point at the tray icon."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Expander.Header>
                                <Border Style="{StaticResource SettingsLastEmphasizedSubcardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Uid="MainWindow_TextBlockCheckItemsToIncludeDragThemInto" Text="Check items to include. Drag them into the order you want."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <ListView x:Uid="MainWindow_ListViewTaskbarHoverLabelContents" ItemsSource="{x:Bind ViewModel.TrayHoverLabelItems, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  CanDragItems="True"
                                                  CanReorderItems="True"
                                                  ReorderMode="Enabled"
                                                  AllowDrop="True"
                                                  ItemContainerStyle="{StaticResource SettingsReorderListItemStyle}"
                                                  AutomationProperties.Name="Taskbar hover label contents">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:TrayHoverLabelItemOption">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE76F;"
                                                                  FontSize="14"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="1"
                                                                  Content="{x:Bind Label, Mode=OneTime}"
                                                                  IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" />
