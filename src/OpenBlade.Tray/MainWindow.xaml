                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind FirmwareUpdateViewModel.SelectedIntervalOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind FirmwareUpdateViewModel.SelectedIntervalOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="FirmwareVersionsSection"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
