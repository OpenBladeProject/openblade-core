                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Detected laptop" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutDetectedLaptopStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Battery health" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutBatteryHealthStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="BIOS" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutBiosVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="EC" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutEcVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="MCU" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutMcuVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="VBIOS" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutVbiosVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="USB device" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingUsbDeviceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Platform" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="Windows 11 x64" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OfficialFirmwareUpdatesCard"
                                Style="{StaticResource SettingsGroupStyle}"
