                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Update channel"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Stable offers normal releases. Nightly offers the newest automated test build."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="160"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Update channel"
                                                  ItemsSource="{x:Bind UpdateViewModel.ChannelOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind UpdateViewModel.SelectedChannelOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind UpdateViewModel.SelectedChannelOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Check interval"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Checks at startup when due."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="160"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Update check interval"
                                                  ItemsSource="{x:Bind UpdateViewModel.IntervalOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind UpdateViewModel.SelectedIntervalOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind UpdateViewModel.SelectedIntervalOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Latest release"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind UpdateViewModel.StatusText, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <ProgressRing Width="20"
                                                          Height="20"
                                                          IsActive="{x:Bind UpdateViewModel.IsChecking, Mode=OneWay}"
                                                          Visibility="{x:Bind UpdateViewModel.IsChecking, Mode=OneWay}"
                                                          AutomationProperties.Name="Checking GitHub for updates" />
                                            <HyperlinkButton Content="View release"
                                                             NavigateUri="{x:Bind UpdateViewModel.ReleasePageUri, Mode=OneWay}"
                                                             Visibility="{x:Bind UpdateViewModel.HasReleasePage, Mode=OneWay}"
                                                             AutomationProperties.Name="View available OpenBlade release" />
                                            <Button Content="Check now"
                                                    Command="{x:Bind UpdateViewModel.CheckForUpdatesCommand}"
                                                    AutomationProperties.Name="Check GitHub for OpenBlade updates" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsShutdownSection">
                        <TextBlock Text="Shutdown" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Border Style="{StaticResource SettingsLastRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Shut down OpenBlade"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Stop the app, display helper, and hardware service. You can start OpenBlade again from troubleshooting."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource DestructiveButtonStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                            Click="OnShutdownOpenBlade"
                                            AutomationProperties.Name="Shut down OpenBlade">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                                            <TextBlock Text="Shut down" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Border>
                        </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=AboutPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid Margin="0,0,0,20" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="About" Style="{StaticResource PageHeaderTitleStyle}" />
                            <Button Grid.Column="1"
                                    Content="Customize"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    Tag="About"
                                    Click="OnCustomizePageSections"
                                    AutomationProperties.Name="Customize About page" />
                        </Grid>

                        <StackPanel x:Name="AboutSectionHost">
                        <StackPanel x:Name="AboutOverviewSection">
                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="80"
                                       Height="80"
                                       Source="ms-appx:///Assets/Brand/OpenBlade.png"
                                       AutomationProperties.Name="OpenBlade app icon" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="OpenBlade"
                                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <TextBlock Text="Lightweight controls for Razer Blade laptops"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="Independent open-source project; not affiliated with Razer."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutVersionsSection">
                        <TextBlock Text="Versions" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="OpenBlade app" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutUiVersionStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Session agent" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutSessionAgentVersionStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}"
                                                   AutomationProperties.Name="OpenBlade session agent version" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Service" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutServiceVersionStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}"
                                                   AutomationProperties.Name="OpenBlade service version" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutDeviceInformationSection">
