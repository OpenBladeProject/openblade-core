                                        </Grid>
                                        <TextBlock Grid.Row="3" Text="MCU" Style="{StaticResource CardTitleStyle}" />
                                        <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.InstalledMcuVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FirmwareUpdateViewModel.PublishedMcuVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="FirmwareFooterSection"
                                        Style="{StaticResource SettingsLastRowStyle}"
                                        Padding="0">
                                    <HyperlinkButton NavigateUri="{x:Bind FirmwareUpdateViewModel.OfficialSupportUri, Mode=OneWay}"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     CornerRadius="0,0,8,8"
                                                     AutomationProperties.Name="Open official Razer firmware support page"
                                                     ToolTipService.ToolTip="Open official Razer firmware support page">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Open official Razer page"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="View firmware downloads and release details on Razer's site."
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1"
                                                      Glyph="&#xE8A7;"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource CardActionIconStyle}" />
                                        </Grid>
                                    </HyperlinkButton>
                                </Border>
                            </StackPanel>
                        </Border>

