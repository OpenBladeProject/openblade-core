                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28" HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="SettingsPageHeader"
                              Margin="0,0,0,20">
                            <TextBlock Text="Settings"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                        </Grid>

                        <TextBlock Text="Behavior" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Live readings" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose how often OpenBlade checks temperatures, fan speed, and net battery power."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="170"
                                              Style="{StaticResource SettingsPickerStyle}"
                                              AutomationProperties.Name="Live readings refresh interval"
                                              ItemsSource="{x:Bind ViewModel.LiveReadingsRefreshOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedLiveReadingsRefreshOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Shown on Dashboard"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose which live readings appear in the Dashboard summary."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.DashboardTelemetryItems, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal"
                                                               ItemWidth="190"
                                                               ItemHeight="40" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:LiveReadingVisibilityOption">
                                                <CheckBox Content="{x:Bind Label, Mode=OneTime}"
                                                          IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Start at sign-in" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.StartupDescription, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Start OpenBlade when I sign in"
                                                  OffContent=""
                                                  OnContent=""
                                                  IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=OneWay}"
                                                  Toggled="OnStartAtSignInToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Start minimized"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Open in the notification area without showing the window."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartMinimizedToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Start OpenBlade minimized"
                                                      OffContent=""
                                                      OnContent=""
                                                      Toggled="OnStartMinimizedToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Override external lighting changes"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Reapply the last OpenBlade lighting effect after OpenBlade confirms it was changed elsewhere."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Always override external lighting changes"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind ViewModel.AlwaysOverrideExternalLightingChanges, Mode=OneWay}"
                                                      Toggled="OnExternalLightingOverridePolicyToggled" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="App theme" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Follow Windows, or always use light or dark mode."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="170"
                                              Style="{StaticResource SettingsPickerStyle}"
                                              AutomationProperties.Name="App theme"
                                              ItemsSource="{x:Bind ViewModel.ThemeSelectionOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="App accent color"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Use OpenBlade green, the Windows accent, or a color you choose."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="{x:Bind AccentColorPreviewBrush, Mode=OneWay}"
                                                 Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="1" />
                                        <ComboBox MinWidth="160"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="App accent color"
                                                  ItemsSource="{x:Bind AccentColorOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedAccentColorOption, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsSubcardStyle}"
                                    Visibility="{x:Bind CustomAccentColorVisibility, Mode=OneWay}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Custom color"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind AccentColorSummary, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Choose color"
                                            VerticalAlignment="Center"
                                            Click="OnChooseCustomAccentColor" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Expander x:Name="NavigationMenuExpander"
                                          Style="{StaticResource CardContentExpanderStyle}"
                                          IsExpanded="False"
                                          AutomationProperties.Name="Navigation menu order">
                                    <Expander.Resources>
                                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    </Expander.Resources>
                                    <Expander.Header>
                                        <StackPanel Spacing="3" Margin="0,14">
                                            <TextBlock Text="Navigation menu"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose the order of pages in the left menu."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SettingsSubcardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Drag pages into the order you want. Dashboard stays first and About stays last."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <ListView ItemsSource="{x:Bind PrimaryNavigationItems, Mode=OneWay}"
                                                      SelectionMode="None"
                                                      CanDragItems="True"
                                                      CanReorderItems="True"
                                                      ReorderMode="Enabled"
                                                      AllowDrop="True"
                                                      ItemTemplate="{StaticResource NavigationItemOptionTemplate}"
                                                      ItemContainerStyle="{StaticResource SettingsReorderListItemStyle}"
                                                      AutomationProperties.Name="Navigation menu pages" />
                                            <Button Content="Reset to default"
                                                    HorizontalAlignment="Left"
                                                    Click="OnResetNavigationOrder" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </Border>
                            <Expander x:Name="TaskbarHoverLabelExpander"
                                      Style="{StaticResource CardContentExpanderStyle}"
                                      IsExpanded="False"
                                      AutomationProperties.Name="Taskbar hover label settings">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <StackPanel Spacing="3" Margin="0,14">
                                        <TextBlock Text="Taskbar hover label" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose whether to show the app name, profile, and live details when you point at the tray icon."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>
                                <Border Style="{StaticResource SettingsLastSubcardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Check items to include. Drag them into the order you want."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <ListView ItemsSource="{x:Bind ViewModel.TrayHoverLabelItems, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  CanDragItems="True"
                                                  CanReorderItems="True"
                                                  ReorderMode="Enabled"
                                                  AllowDrop="True"
                                                  ItemContainerStyle="{StaticResource SettingsReorderListItemStyle}"
                                                  AutomationProperties.Name="Taskbar hover label contents">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:TrayHoverLabelItemOption">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE76F;"
                                                                  FontSize="14"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="1"
                                                                  Content="{x:Bind Label, Mode=OneTime}"
                                                                  IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Spacing="4" Margin="4,4,4,0">
                                            <TextBlock Text="Preview"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.TrayHoverLabelText, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8"
                                                  Visibility="{x:Bind ViewModel.HasTrayHoverLabelOverflow, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind ViewModel.TrayHoverLabelOverflowMessage, Mode=OneWay}"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Shutdown" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Border Style="{StaticResource SettingsLastRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Shut down OpenBlade"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Stop the app, display helper, and hardware service until Windows restarts."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource DestructiveButtonStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                            Click="OnShutdownOpenBlade"
                                            AutomationProperties.Name="Shut down OpenBlade">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                                            <TextBlock Text="Shut down" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Border>

                    </StackPanel>
                </ScrollView>

                <ScrollView x:Name="AboutPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28" HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="80"
                                       Height="80"
                                       Source="ms-appx:///Assets/Brand/OpenBlade.png"
                                       AutomationProperties.Name="OpenBlade app icon" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="OpenBlade"
                                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <TextBlock Text="Lightweight controls for Razer Blade laptops"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="Independent open-source project; not affiliated with Razer."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Versions" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="OpenBlade app" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutUiVersionStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="OpenBlade service" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutServiceVersionStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}"
                                                   AutomationProperties.Name="OpenBlade service version" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Device information" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Detected laptop" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.AboutDetectedLaptopStatus, Mode=OneWay}"
                                                   Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="BIOS" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutBiosVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="EC" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutEcVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="MCU" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutMcuVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="VBIOS" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AboutVbiosVersionStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="USB device" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="VID 1532 · PID 02E0" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Platform" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Grid.Column="1" Text="Windows 11 x64" Style="{StaticResource TroubleshootingValueStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Support" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Export diagnostics" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Save logs and system details with sensitive information removed." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconActionButtonStyle}"
                                                Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                                                AutomationProperties.Name="Export diagnostics"
                                                ToolTipService.ToolTip="Export diagnostics">
                                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Report a problem" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Open GitHub Issues to report a bug or request an improvement." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1"
                                                         NavigateUri="https://github.com/OSSBlade/openblade-core/issues"
                                                         Style="{StaticResource ExternalLinkButtonStyle}"
                                                         AutomationProperties.Name="Open GitHub Issues"
                                                         ToolTipService.ToolTip="Open GitHub Issues">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                        </HyperlinkButton>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Documentation" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Read setup, usage, and compatibility information." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1"
                                                         NavigateUri="https://github.com/OSSBlade/openblade-docs"
                                                         Style="{StaticResource ExternalLinkButtonStyle}"
                                                         AutomationProperties.Name="Open documentation"
                                                         ToolTipService.ToolTip="Open documentation">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                        </HyperlinkButton>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Release notes" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="See what changed in each OpenBlade build." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1"
                                                         NavigateUri="https://github.com/OSSBlade/openblade-core/blob/main/CHANGELOG.md"
                                                         Style="{StaticResource ExternalLinkButtonStyle}"
                                                         AutomationProperties.Name="Open release notes"
                                                         ToolTipService.ToolTip="Open release notes">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                        </HyperlinkButton>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Source code" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="View and contribute to OpenBlade on GitHub." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1"
                                                         NavigateUri="https://github.com/OSSBlade/openblade-core"
                                                         Style="{StaticResource ExternalLinkButtonStyle}"
                                                         AutomationProperties.Name="Open source code"
                                                         ToolTipService.ToolTip="Open source code">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                        </HyperlinkButton>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Expander x:Name="TroubleshootingExpander"
                                      Style="{StaticResource CardContentExpanderStyle}"
                                      AutomationProperties.Name="Troubleshooting details">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <StackPanel Spacing="3" Margin="0,14,0,14">
                                        <TextBlock Text="Service and device status" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="View live connection and control details." Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="OpenBlade service" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1" ColumnSpacing="7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ViewModel.IsServiceUnavailable, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingServiceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Laptop behavior" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1" ColumnSpacing="7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsReadinessReady, Mode=OneWay}" />
                                                    <ProgressRing Width="12" Height="12"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingControlsStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Power source" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingPowerSourceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Other Razer software running" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingOtherRazerSoftwareStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}" Visibility="{x:Bind ViewModel.HasTroubleshootingRecentError, Mode=OneWay}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Recent error" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingRecentErrorStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollView>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
