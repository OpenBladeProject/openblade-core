                                <Expander x:Uid="MainWindow_NavigationMenuExpanderText" x:Name="NavigationMenuExpander"
                                          Style="{StaticResource CardContentExpanderStyle}"
                                          IsExpanded="False"
                                          AutomationProperties.Name="Navigation menu order">
                                    <Expander.Resources>
                                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    </Expander.Resources>
                                    <Expander.Header>
                                        <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                            <StackPanel Spacing="3" Margin="16,14,60,14">
                                                <TextBlock x:Uid="MainWindow_TextBlockNavigationMenu" Text="Navigation menu"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock x:Uid="MainWindow_TextBlockChooseTheOrderOfPagesInThe" Text="Choose the order of pages in the left menu."
                                                           Style="{StaticResource SecondaryTextStyle}" />
