                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="App accent color"
                                                                        ItemsSource="{x:Bind AccentColorOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        SelectedItem="{x:Bind SelectedAccentColorOption, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border local:CardReorder.CardId="MainWindow_TextBlockCustomColor" Style="{StaticResource SettingsEmphasizedSubcardStyle}"
                                    Visibility="{x:Bind CustomAccentColorVisibility, Mode=OneWay}">
