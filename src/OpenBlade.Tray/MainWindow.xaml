                                            <ToggleSwitch x:Name="TouchpadToggle" x:Uid="Touchpad_Toggle"
                                                          Grid.Column="1" VerticalAlignment="Center"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          AutomationProperties.Name="Touchpad"
                                                          IsOn="{x:Bind TouchpadViewModel.IsOn, Mode=OneWay}"
                                                          IsEnabled="{x:Bind TouchpadViewModel.CanEdit, Mode=OneWay}"
                                                          Toggled="OnTouchpadToggled" />
                                        </Grid>
                                    </Border>
                                    <Border local:CardReorder.CardId="SnapTapRow" x:Name="SnapTapRow" Style="{StaticResource SettingsLastExpanderRowStyle}">
                                        <Expander x:Name="SnapTapExpander" x:Uid="KeyboardBackend_SnapTapExpander"
                                                  Style="{StaticResource CardContentExpanderStyle}"
                                                  IsExpanded="False" AutomationProperties.Name="SnapTap (A/D)">
                                            <Expander.Resources>
                                                <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                                <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                            </Expander.Resources>
                                            <Expander.Header>
                                                <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                                    <Grid ColumnSpacing="20" Margin="16,14,60,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock x:Uid="SnapTap_Title" Text="SnapTap (A/D)" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                                                <Button x:Name="SnapTapInfoButton" x:Uid="SnapTap_InfoButton"
                                                                        Width="20" Height="20" MinWidth="0" MinHeight="0"
                                                                        Padding="0" Background="Transparent" BorderThickness="0"
                                                                        VerticalAlignment="Center"
                                                                        AutomationProperties.Name="About SnapTap"
                                                                        ToolTipService.ToolTip="About SnapTap">
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                                                                <StackPanel MaxWidth="320" Spacing="12">
                                                                                    <TextBlock x:Uid="SnapTap_InfoTitle" Text="About SnapTap" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                                                                    <TextBlock x:Uid="SnapTap_InfoInput" Text="Razer driver handles the built-in keyboard. Windows hook applies to all keyboards." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                                                    <TextBlock x:Uid="SnapTap_InfoCompatibility" Text="Game compatibility has not been verified." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                            </ScrollViewer>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                                                </Button>
                                                            </StackPanel>
                                                            <TextBlock x:Uid="SnapTap_Description" Text="When A and D overlap, the last pressed key wins." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="SnapTapStatusText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                                            <StackPanel x:Name="SnapTapDriverActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                                <Button x:Name="SnapTapInstallDriverButton" x:Uid="SnapTap_InstallDriver"
                                                                        Content="Install driver" HorizontalAlignment="Left"
                                                                        Style="{StaticResource AccentButtonStyle}"
                                                                        Click="OnInstallSnapTapDriver"
                                                                        AutomationProperties.Name="Install the Razer keyboard driver" />
                                                                <HyperlinkButton x:Name="SnapTapDriverLink" x:Uid="SnapTap_DriverLink"
                                                                                 Style="{StaticResource ExternalLinkButtonStyle}"
                                                                                 Width="32" Height="32" Padding="0"
                                                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                 ToolTipService.ToolTip="Setup guide"
                                                                                  NavigateUri="https://github.com/OpenBladeProject/blade-driver-catalog"
                                                                                 AutomationProperties.Name="Razer keyboard driver setup guide">
                                                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                                                </HyperlinkButton>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ToggleSwitch x:Name="SnapTapToggle" x:Uid="SnapTap_Toggle" Grid.Column="1" Style="{StaticResource CompactCardToggleSwitchStyle}" Toggled="OnSnapTapToggled" AutomationProperties.Name="SnapTap (A/D)" />
                                                    </Grid>
                                                </Border>
                                            </Expander.Header>
                                            <Border x:Name="SnapTapBackendRow" Style="{StaticResource SettingsLastNeutralSubcardStyle}">
                                                <Grid ColumnSpacing="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock x:Uid="KeyboardBackend_SnapTapTitle" Text="SnapTap input" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Uid="KeyboardBackend_SnapTapDescription"
                                                                   Text="Razer driver uses the built-in keyboard. Windows hook uses all keyboards."
                                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="SnapTapWindowsHookHelp" x:Uid="KeyboardBackend_SnapTapWindowsHelp"
                                                                   Text="Applies to all keyboards. Some games may ignore Windows hook input." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <local:ResponsiveChoiceSelector x:Name="SnapTapBackendSelector" x:Uid="KeyboardBackend_SnapTapSelector"
                                                                                    Grid.Column="1" VerticalAlignment="Center" CompactMinWidth="150" ExpandedMinWindowWidth="800"
                                                                                    AccessibleName="SnapTap input" DisplayMemberPath="Label"
                                                                                    PlaceholderText="Choose input method" SelectionChanged="OnSnapTapBackendChanged" />
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ContentControl x:Name="StartupAnimationCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardStartupAnimationCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <StackPanel x:Name="ShortcutKeysSection"
                                    Visibility="{x:Bind ViewModel.IsSpecialKeyBindingsEditable, Mode=OneWay}">
                            <TextBlock local:CardReorder.IsHeader="True" x:Uid="MainWindow_TextBlockShortcutKeys" Text="Shortcut keys"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,10" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <ItemsRepeater ItemsSource="{x:Bind SpecialKeyBindings, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:SpecialKeyBindingViewModel">
                                            <Border Style="{StaticResource SettingsRowStyle}"
                                                    Visibility="{x:Bind IsEditable, Mode=OneWay}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="280" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind SlotLabel, Mode=OneWay}"
                                                                       Style="{StaticResource CardTitleStyle}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                  MinWidth="200"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  ItemsSource="{x:Bind AvailableActions, Mode=OneWay}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedItem="{x:Bind SelectedAction, Mode=OneWay}"
                                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedAction, Mode=OneWay}"
                                                                  Tag="{x:Bind Slot}"
                                                                  SelectionChanged="OnSpecialKeyActionSelectionChanged"
                                                                  AutomationProperties.Name="{x:Bind ActionAccessibleName, Mode=OneWay}" />
                                                    </Grid>
                                                    <Grid Visibility="{x:Bind ValueEditorVisibility, Mode=OneWay}"
                                                          ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="280" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind ValueLabel, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                     PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                                                                     MaxLength="2048"
                                                                     AutomationProperties.Name="{x:Bind ValueLabel, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                                                       Visibility="{x:Bind ValidationMessageVisibility, Mode=OneWay}"
                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ThxAudioPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ThxAudioPageContent"
                                Padding="28,20,28,28"
                                Width="{Binding ElementName=ThxAudioPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                        <StackPanel x:Name="ThxAudioSection">
                            <TextBlock x:Uid="MainWindow_ThxAudioHeading" Text="THX Audio"
                                       Style="{StaticResource PageTitleStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Uid="MainWindow_ThxAudioIntegrationTitle" Text="Use installed THX audio"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock x:Uid="MainWindow_ThxAudioDescription"
                                                           Text="Experimental. Requires compatible THX components for this laptop."
                                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Uid="MainWindow_ThxAudioIntegrationToggle" Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ThxViewModel.IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind ThxViewModel.CanToggleIntegration, Mode=OneWay}"
                                                          AutomationProperties.Name="Use installed THX audio"
                                                          Toggled="OnThxIntegrationToggled" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16,14,16,18" Spacing="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_ThxAudioOutputTitle" Text="Output"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                            <local:ResponsiveChoiceSelector x:Uid="MainWindow_ThxAudioOutput" Grid.Column="1"
                                                      ExpandedMinWindowWidth="720"
                                                      ItemsSource="{x:Bind ThxViewModel.Endpoints, Mode=OneWay}"
                                                      SelectedItem="{x:Bind ThxViewModel.SelectedEndpoint, Mode=OneWay}"
                                                      DisplayMemberPath="Label" AccessibleName="THX audio output"
                                                      IsEnabled="{x:Bind ThxViewModel.CanRead, Mode=OneWay}"
                                                      SelectionChanged="OnThxEndpointChanged" />
                                            <Button x:Uid="MainWindow_ThxAudioReadSettings" Grid.Column="2" Content="Read settings"
                                                    Visibility="{x:Bind ThxViewModel.IsReadSettingsVisible, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ThxViewModel.CanRead, Mode=OneWay}" Click="OnThxReadSettings" />
                                        </Grid>
                                        <Grid x:Name="ThxAudioStatusArea" MinHeight="20">
                                            <!-- Retain the wrapped status height while the visible text is replaced by progress. -->
                                            <TextBlock Text="{x:Bind ThxViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                                       Style="{StaticResource SecondaryTextStyle}" Opacity="0" IsHitTestVisible="False"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Text="{x:Bind ThxViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                                       Visibility="{x:Bind ThxViewModel.ShowStatusMessage, Mode=OneWay}"
                                                       VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar x:Name="ThxAudioProgress" IsIndeterminate="True" Height="3" VerticalAlignment="Center"
                                                         Visibility="{x:Bind ThxViewModel.IsBusy, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel x:Name="ThxAudioComponentDownload" Spacing="8"
                                                    Visibility="{x:Bind ThxViewModel.IsComponentDownloadVisible, Mode=OneWay}">
                                            <TextBlock x:Uid="MainWindow_ThxAudioComponentDownloadDescription"
                                                       Text="Download the THX component from Razer. The THX audio driver must already be installed."
                                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                            <Button x:Name="ThxAudioDownloadComponent" HorizontalAlignment="Left"
                                                    Content="{x:Bind ThxViewModel.DownloadComponentButtonLabel, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ThxViewModel.CanDownloadComponent, Mode=OneWay}"
                                                    Click="OnThxDownloadComponent" />
                                        </StackPanel>
                                        <StackPanel x:Name="ThxAudioStackInstallation" Spacing="8"
                                                    Visibility="{x:Bind ThxViewModel.IsStackInstallationVisible, Mode=OneWay}">
                                            <TextBlock x:Uid="MainWindow_ThxAudioStackInstallationDescription"
                                                       Text="Install the matching audio drivers and THX components. Setup may interrupt playback and require a restart."
                                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                            <Button x:Name="ThxAudioInstallStack" HorizontalAlignment="Left"
                                                    Content="{x:Bind ThxViewModel.InstallStackButtonLabel, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ThxViewModel.CanInstallStack, Mode=OneWay}"
                                                    Click="OnThxInstallStack" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_ThxAudioSpatialTitle" Text="Spatial audio"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Uid="MainWindow_ThxAudioSpatial" Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ThxViewModel.SpatialEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind ThxViewModel.CanEdit, Mode=OneWay}"
                                                          AutomationProperties.Name="THX Spatial Audio" Toggled="OnThxSpatialToggled" />
                                        </Grid>
                                        <Grid ColumnSpacing="24" Visibility="{x:Bind ThxViewModel.ShowEqualizerControls, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_ThxAudioEqualizerTitle" Text="Equalizer"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Uid="MainWindow_ThxAudioEqualizer" Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ThxViewModel.EqualizerEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind ThxViewModel.CanEditEqualizer, Mode=OneWay}"
                                                          AutomationProperties.Name="THX equalizer" Toggled="OnThxEqualizerToggled" />
                                        </Grid>
                                        <Grid ColumnSpacing="16" Visibility="{x:Bind ThxViewModel.ShowEqualizerControls, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="MainWindow_ThxAudioPresetTitle" Text="Equalizer preset"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <local:ResponsiveChoiceSelector x:Uid="MainWindow_ThxAudioPreset" Grid.Column="1"
                                                      ExpandedMinWindowWidth="800"
                                                      DisplayMemberPath="Name" AccessibleName="THX equalizer preset"
                                                      ItemsSource="{x:Bind ThxViewModel.Presets, Mode=OneWay}"
                                                      SelectedItem="{x:Bind ThxViewModel.SelectedPreset, Mode=OneWay}"
                                                      IsEnabled="{x:Bind ThxViewModel.CanEdit, Mode=OneWay}" SelectionChanged="OnThxPresetChanged" />
                                        </Grid>
                                        <TextBlock x:Uid="MainWindow_ThxAudioLegacyEqualizerLimit"
                                                   Text="Only spatial audio control is available for this THX version."
                                                   Visibility="{x:Bind ThxViewModel.ShowEqualizerLimit, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ThxViewModel.ActiveProfileMessage, Mode=OneWay}"
                                                   Visibility="{x:Bind ThxViewModel.HasActiveApplicationProfile, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <StackPanel Spacing="10" Visibility="{x:Bind ThxViewModel.HasEqualizerBands, Mode=OneWay}">
                                            <ItemsRepeater ItemsSource="{x:Bind ThxViewModel.EqualizerBands, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="52" MinColumnSpacing="4" ItemsJustification="SpaceBetween" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:ThxEqualizerBandViewModel">
                                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{x:Bind GainLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                                            <Slider Orientation="Vertical" Height="124" Minimum="-12" Maximum="12"
                                                                    SmallChange="1" LargeChange="1" StepFrequency="1"
                                                                    Value="{x:Bind DraftGainDb, Mode=TwoWay}"
                                                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                                    AutomationProperties.Name="{x:Bind AccessibleName}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind FrequencyLabel}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock Text="{x:Bind ThxViewModel.EqualizerDraftHint, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            <Grid x:Name="ThxEqualizerActions" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Uid="MainWindow_ThxAudioResetEqualizer" Content="Reset to factory"
                                                            IsEnabled="{x:Bind ThxViewModel.CanResetEqualizer, Mode=OneWay}" Click="OnThxResetEqualizer" />
                                                    <Button x:Uid="MainWindow_ThxAudioFlattenEqualizer" Content="Flatten"
                                                            IsEnabled="{x:Bind ThxViewModel.CanEditEqualizerBands, Mode=OneWay}" Click="OnThxFlattenEqualizer" />
                                                </StackPanel>
                                                <StackPanel x:Name="ThxEqualizerCommitActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                    <Button x:Uid="MainWindow_ThxAudioDiscard" Content="Discard changes"
                                                            IsEnabled="{x:Bind ThxViewModel.CanDiscardEqualizerChanges, Mode=OneWay}" Click="OnThxDiscardEqualizer" />
                                                    <Button x:Uid="MainWindow_ThxAudioApplyEqualizer" Content="Apply EQ" Style="{StaticResource AccentButtonStyle}"
                                                            IsEnabled="{x:Bind ThxViewModel.CanApplyEqualizer, Mode=OneWay}" Click="OnThxApplyEqualizer" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                                        <Expander x:Name="ThxAudioEnhancements" x:Uid="MainWindow_ThxAudioEnhancements"
                                                  Visibility="{x:Bind ThxViewModel.HasEnhancements, Mode=OneWay}"
                                                  Style="{StaticResource CardContentExpanderStyle}"
                                                  IsExpanded="False" AutomationProperties.Name="Enhancements">
                                            <Expander.Resources>
                                                <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                                <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                            </Expander.Resources>
                                            <Expander.Header>
                                                <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                                    <TextBlock x:Uid="MainWindow_ThxAudioEnhancementsTitle" Text="Enhancements"
                                                               Style="{StaticResource CardTitleStyle}" Margin="16,14,60,14" TextWrapping="Wrap" />
                                                </Border>
                                            </Expander.Header>
                                            <StackPanel>
                                                <Border x:Name="ThxNormalizationCell" Style="{StaticResource SettingsNeutralSubcardStyle}"
                                                        Padding="{StaticResource DashboardSingleLineRowPadding}"
                                                        Visibility="{x:Bind ThxViewModel.HasSoundNormalization, Mode=OneWay}">
                                                    <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="120" />
                                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="MainWindow_ThxAudioNormalizationTitle" Text="Sound normalization"
                                                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                                        <Slider x:Uid="MainWindow_ThxAudioNormalizationLevel" Grid.Column="1"
                                                                Style="{StaticResource InlineCardSliderStyle}"
                                                                Minimum="0" Maximum="100" StepFrequency="1" Tag="SoundNormalization"
                                                                Value="{x:Bind ThxViewModel.SoundNormalizationLevel, Mode=TwoWay}"
                                                                IsEnabled="{x:Bind ThxViewModel.CanEditSoundNormalizationLevel, Mode=OneWay}"
                                                                AutomationProperties.Name="Sound normalization level"
                                                                PointerPressed="OnThxEnhancementPointerPressed"
                                                                PointerReleased="OnThxEnhancementPointerCompleted"
                                                                PointerCaptureLost="OnThxEnhancementPointerCompleted"
                                                                PointerWheelChanged="OnThxEnhancementPointerWheelChanged"
                                                                KeyUp="OnThxEnhancementKeyUp" LostFocus="OnThxEnhancementLostFocus" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ThxViewModel.SoundNormalizationLevelLabel, Mode=OneWay}"
                                                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Uid="MainWindow_ThxAudioNormalization" Grid.Column="3"
                                                                      Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                                      IsOn="{x:Bind ThxViewModel.SoundNormalizationEnabled, Mode=OneWay}"
                                                                      IsEnabled="{x:Bind ThxViewModel.CanEditSoundNormalization, Mode=OneWay}"
                                                                      AutomationProperties.Name="Sound normalization" Toggled="OnThxNormalizationToggled" />
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="ThxVoiceClarityCell" Style="{StaticResource SettingsNeutralSubcardStyle}"
                                                        Padding="{StaticResource DashboardSingleLineRowPadding}"
                                                        Visibility="{x:Bind ThxViewModel.HasVoiceClarity, Mode=OneWay}">
                                                    <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="120" />
                                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="MainWindow_ThxAudioVoiceClarityTitle" Text="Voice clarity"
                                                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                                        <Slider x:Uid="MainWindow_ThxAudioVoiceClarityLevel" Grid.Column="1"
                                                                Style="{StaticResource InlineCardSliderStyle}"
                                                                Minimum="0" Maximum="100" StepFrequency="1" Tag="VoiceClarity"
                                                                Value="{x:Bind ThxViewModel.VoiceClarityLevel, Mode=TwoWay}"
                                                                IsEnabled="{x:Bind ThxViewModel.CanEditVoiceClarityLevel, Mode=OneWay}"
                                                                AutomationProperties.Name="Voice clarity level"
                                                                PointerPressed="OnThxEnhancementPointerPressed"
                                                                PointerReleased="OnThxEnhancementPointerCompleted"
                                                                PointerCaptureLost="OnThxEnhancementPointerCompleted"
                                                                PointerWheelChanged="OnThxEnhancementPointerWheelChanged"
                                                                KeyUp="OnThxEnhancementKeyUp" LostFocus="OnThxEnhancementLostFocus" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ThxViewModel.VoiceClarityLevelLabel, Mode=OneWay}"
                                                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Uid="MainWindow_ThxAudioVoiceClarity" Grid.Column="3"
                                                                      Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                                      IsOn="{x:Bind ThxViewModel.VoiceClarityEnabled, Mode=OneWay}"
                                                                      IsEnabled="{x:Bind ThxViewModel.CanEditVoiceClarity, Mode=OneWay}"
                                                                      AutomationProperties.Name="Voice clarity" Toggled="OnThxVoiceClarityToggled" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <Expander x:Name="ThxAudioApplications" x:Uid="MainWindow_ThxAudioApplications"
                                              Style="{StaticResource CardContentExpanderStyle}"
