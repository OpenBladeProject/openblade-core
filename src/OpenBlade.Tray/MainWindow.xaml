                                 Margin="0,0,0,18"
                                 IsOpen="{x:Bind IsLightingControlUnavailableNoticeVisible, Mode=OneWay}"
                                 Visibility="{x:Bind IsLightingControlUnavailableNoticeVisible, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Lighting controls unavailable"
                                 Message="{x:Bind LightingControlUnavailableMessage, Mode=OneWay}" />
                        <TextBlock Text="Keyboard"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}"
                                Margin="0,0,0,10"
                                Visibility="{x:Bind IsWindowsDynamicLightingAvailable, Mode=OneWay}">
                            <Border Style="{StaticResource SettingsLastRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Windows Dynamic Lighting"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Use Windows for keyboard effects and brightness."
