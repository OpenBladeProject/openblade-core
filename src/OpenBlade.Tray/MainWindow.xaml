                                            VerticalAlignment="Center"
                                            Click="OnCustomizeTrayDashboard"
                                            AutomationProperties.Name="Customize tray dashboard" />
                                </Grid>
                            </Border>
                            <Border local:CardReorder.CardId="MainWindow_TextBlockAppTheme" Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
