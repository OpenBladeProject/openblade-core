                                    </Button>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-core/issues"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="Open GitHub Issues"
                                                     ToolTipService.ToolTip="Open GitHub Issues">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Report a problem" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Open GitHub Issues to report a bug or request an improvement." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-docs"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="Open documentation"
                                                     ToolTipService.ToolTip="Open documentation">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Documentation" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Read setup, usage, and compatibility information." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-core/blob/main/CHANGELOG.md"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="Open release notes"
                                                     ToolTipService.ToolTip="Open release notes">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Release notes" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="See what changed in each OpenBlade build." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-core"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     CornerRadius="0,0,8,8"
                                                     AutomationProperties.Name="Open source code"
                                                     ToolTipService.ToolTip="Open source code">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Source code" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="View and contribute to OpenBlade on GitHub." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutTroubleshootingSection">
                        <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Expander x:Name="TroubleshootingExpander"
                                      Style="{StaticResource CardContentExpanderStyle}"
                                      PointerEntered="OnTroubleshootingHeaderPointerEntered"
                                      PointerMoved="OnTroubleshootingHeaderPointerMoved"
                                      PointerExited="OnTroubleshootingHeaderPointerExited"
                                      PointerPressed="OnTroubleshootingHeaderPointerPressed"
                                      PointerReleased="OnTroubleshootingHeaderPointerReleased"
                                      PointerCanceled="OnTroubleshootingHeaderPointerCanceled"
                                      PointerCaptureLost="OnTroubleshootingHeaderPointerCanceled"
                                      AutomationProperties.Name="Troubleshooting details">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Grid x:Name="TroubleshootingHeaderSurface"
                                          Margin="-16,0,-60,0">
                                        <Border x:Name="TroubleshootingHeaderHoverBackground"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <Border x:Name="TroubleshootingHeaderPressedBackground"
                                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <StackPanel Spacing="3" Margin="16,14,60,14">
                                            <TextBlock Text="Service and device status" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="View live connection and control details." Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="OpenBlade service" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Margin="0,0,7,0"
                                                             Visibility="{x:Bind ViewModel.IsServiceUnavailable, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingServiceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                                <Button x:Name="StartOpenBladeButton"
                                                        Grid.Column="2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.IsServiceUnavailable, Mode=OneWay}"
                                                        Click="OnStartOpenBlade"
                                                        AutomationProperties.LiveSetting="Polite"
                                                        AutomationProperties.Name="Start OpenBlade">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ProgressRing x:Name="StartOpenBladeProgressRing"
                                                                      Width="14"
                                                                      Height="14"
                                                                      IsActive="False"
                                                                      Opacity="0"
                                                                      AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="Start OpenBlade" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Laptop behavior" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <ProgressRing Width="12" Height="12"
                                                                  Margin="0,0,7,0"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Margin="0,0,7,0"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Style="{StaticResource TroubleshootingStatusDotStyle}"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Margin="0,0,7,0"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingControlsStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Keyboard driver mode" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ViewModel.TroubleshootingKeyboardDriverModeStatus, Mode=OneWay}"
                                                       Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Power source" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingPowerSourceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Other Razer software running" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingOtherRazerSoftwareStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}" Visibility="{x:Bind ViewModel.HasTroubleshootingRecentError, Mode=OneWay}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Recent error" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingRecentErrorStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
