<Window
    x:Class="OpenBlade.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade">
    <Grid x:Name="Root" Padding="20">
        <Grid.Resources>
            <local:BooleanNegationToVisibilityConverter x:Key="BooleanNegationToVisibility" />
        </Grid.Resources>
        <ScrollViewer>
            <StackPanel Spacing="10">
                <TextBlock Text="OpenBlade" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Razer Blade controls" Opacity="0.7" />
                <TextBlock Text="{Binding ConnectionStatus}" />
                <TextBlock Text="{Binding OperationStatusMessage}" />
                <Button Content="Silent" Command="{Binding SetPerformanceCommand}" />
                <Button Content="Automatic fans" Command="{Binding SetFanModeCommand}" />
                <Button Content="Apply charge limit" Command="{Binding SetChargeLimitCommand}" />
                <Button Content="Charge to 100%"
                        Command="{Binding ToggleFullChargeCommand}"
                        CommandParameter="{Binding EnableFullChargeOverride}" />
                <ComboBox ItemsSource="{Binding AvailablePerformancePresets}" />
                <ComboBox ItemsSource="{Binding AvailableFanModes}" />
                <StackPanel Visibility="{Binding IsLightingVisible, Converter={StaticResource BooleanNegationToVisibility}}">
                    <TextBlock Text="Lighting controls unavailable" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding AvailableLightingEffects}" />
                <Button Content="Apply lighting" Command="{Binding SetLightingCommand}" />
                <TextBlock Text="PluggedInPerformanceEditor" Visibility="Collapsed" />
                <TextBlock Text="BatteryPerformanceEditor" Visibility="Collapsed" />
                <ItemsControl ItemsSource="{Binding ConflictNames}" />
                <Button Content="Save profiles" Command="{Binding SaveProfilesCommand}" />
                <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" />
                <TextBlock Text="{Binding OperationStatusMessage}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
