                                                                    DisplayMemberPath="Label"
                                                                    SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border local:CardReorder.CardId="AppLanguageHeading" Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock x:Uid="MainWindow_TextBlockAppLanguage" x:Name="AppLanguageHeading" Text="App language"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="MainWindow_TextBlockUseYourWindowsDisplayLanguageOrChooseA" x:Name="AppLanguageDescription" Text="Use your Windows display language, or choose a language. Changes apply immediately."
