<Window
    x:Class="OpenBlade.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <local:BooleanNegationToVisibilityConverter x:Key="BooleanNegationToVisibility" />

            <Style x:Key="PageTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="SectionHeaderStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="SettingsGroupStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="SettingsLastRowStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsRowStyle}">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="CardContentExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="TroubleshootingSectionStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,12,44,12" />
            </Style>
            <Style x:Key="CardTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="SecondaryTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <NavigationView x:Name="MainNavigation"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem"
                                    Content="Dashboard"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="28,20,28,28" HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="HomePage"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <Grid x:Name="HeroLayout" ColumnSpacing="24" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="12"
                                                Padding="10,3">
                                            <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <Button x:Name="AttentionIndicator"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                                AutomationProperties.Name="Show warning details"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel MaxWidth="360" Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE7BA;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ActivePerformanceLabel, Mode=OneWay}"
                                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveFanModeLabel, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBatterySettingLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="HeroReadings"
                                            Grid.Row="1"
                                            Spacing="6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.LiveReadingsEnabled, Mode=OneWay}">
                                    <TextBlock Text="Live readings" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.BatteryPowerFlowLabel, Mode=OneWay}"
                                               Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.Fan1RpmLabel, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.Fan2RpmLabel, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.HasActiveChanges, Mode=OneWay}">
                            <Grid x:Name="ActiveChangesLayout" ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Active changes" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveChangesText, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button x:Name="UseProfileSettingsButton"
                                        Grid.Row="1"
                                        Content="Use profile settings"
                                        Command="{x:Bind ViewModel.ClearManualOverridesCommand}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Performance and fans" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}"
                                    Visibility="{x:Bind ViewModel.IsPerformanceVisible, Mode=OneWay}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Performance" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Balance speed, power use, and noise."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="DashboardPerformanceSelector"
                                              Grid.Column="1"
                                              MinWidth="150"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Performance mode"
                                              IsEnabled="{x:Bind ViewModel.CanControlHardware, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.AvailablePerformancePresets, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedPerformance, Mode=OneWay}"
                                              SelectionChanged="OnDashboardPerformanceChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsLastRowStyle}"
                                    Visibility="{x:Bind ViewModel.IsFanControlVisible, Mode=OneWay}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Fans" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Automatic is recommended for everyday use."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="DashboardFanModeSelector"
                                              Grid.Column="1"
                                              MinWidth="150"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Fan mode"
                                              IsEnabled="{x:Bind ViewModel.CanControlHardware, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.AvailableFanModes, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFanMode, Mode=OneWay}"
                                              SelectionChanged="OnDashboardFanModeSelectionChanged" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>

                        <Grid MinHeight="28" Margin="4,0,4,2">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}">
                                <SymbolIcon Symbol="Accept" />
                                <TextBlock Text="{x:Bind ViewModel.OperationFeedbackMessage, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Battery" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Battery protection" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Limit charging to help preserve battery health."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="BatteryProtectionToggle"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Battery protection"
                                                  OffContent=""
                                                  OnContent=""
                                                  IsEnabled="{x:Bind ViewModel.CanChangeBatteryProtection, Mode=OneWay}"
                                                  IsOn="{x:Bind ViewModel.BatteryProtectionEnabled, Mode=OneWay}"
                                                  Toggled="OnBatteryProtectionToggled" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Charge limit" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose the maximum charge level while protection is on."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="4"
                                                HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind ViewModel.ChargeLimitPercent, Mode=OneWay}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="%" Style="{StaticResource CardTitleStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="DashboardChargeLimitSlider"
                                                HorizontalAlignment="Stretch"
                                                Minimum="50"
                                                Maximum="80"
                                                StepFrequency="5"
                                                SmallChange="5"
                                                LargeChange="5"
                                                SnapsTo="StepValues"
                                                IsThumbToolTipEnabled="True"
                                                IsEnabled="{x:Bind ViewModel.CanAdjustChargeLimit, Mode=OneWay}"
                                                AutomationProperties.Name="Charge limit"
                                                Value="{Binding ChargeLimitPercent, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                                PointerPressed="OnDashboardChargeLimitPointerPressed"
                                                PointerReleased="OnDashboardChargeLimitPointerCaptureLost"
                                                PointerCaptureLost="OnDashboardChargeLimitPointerCaptureLost"
                                                KeyUp="OnDashboardChargeLimitKeyUp" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsLastRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Temporary full charge" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Charge to 100%, then restore the limit after unplugging."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Content="{x:Bind ViewModel.FullChargeActionLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleFullChargeCommand}"
                                            CommandParameter="{x:Bind ViewModel.EnableFullChargeOverride, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProfilesPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <TextBlock Text="Profiles" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="OpenBlade switches between these settings when the power source changes."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,16" />

                        <Grid x:Name="ProfilesLayout" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ProfilesSecondColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="Plugged in" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind ViewModel.IsPluggedInProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </Grid>
                                    <ComboBox Header="Performance"
                                              ItemsSource="{x:Bind ViewModel.AvailablePerformancePresets, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.PluggedInPerformanceEditor, Mode=TwoWay}" />
                                    <ComboBox Header="Fans"
                                              ItemsSource="{x:Bind ViewModel.AvailableFanModes, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.PluggedInFanModeEditor, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="BatteryProfileCard"
                                    Grid.Row="1"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="On battery" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding IsPluggedInProfileActive, Converter={StaticResource BooleanNegationToVisibility}}">
                                            <TextBlock Text="Active"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </Grid>
                                    <ComboBox Header="Performance"
                                              ItemsSource="{x:Bind ViewModel.AvailablePerformancePresets, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.BatteryPerformanceEditor, Mode=TwoWay}" />
                                    <ComboBox Header="Fans"
                                              ItemsSource="{x:Bind ViewModel.AvailableFanModes, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.BatteryFanModeEditor, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Profile changes" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Unsaved changes"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Visibility="{x:Bind ViewModel.HasUnsavedProfileChanges, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Content="Save profiles"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveProfilesCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

                        <TextBlock Text="Behavior" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Manual changes" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose when Dashboard changes return to the active profile."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="230"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Manual change duration"
                                              ItemsSource="{x:Bind ViewModel.ManualChangeDurationOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedManualChangeDurationOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Live readings" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Show fan speed and net battery power in OpenBlade."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Live readings"
                                                  OffContent=""
                                                  OnContent=""
                                                  IsOn="{x:Bind ViewModel.LiveReadingsEnabled, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsLastRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Start at sign-in" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.StartupDescription, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Start OpenBlade when I sign in"
                                                  OffContent=""
                                                  OnContent=""
                                                  IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=OneWay}"
                                                  Toggled="OnStartAtSignInToggled" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="App theme" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Follow Windows, or always use light or dark mode."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="170"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="App theme"
                                              ItemsSource="{x:Bind ViewModel.ThemeSelectionOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsLastRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Taskbar hover label" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose the profile and live details shown when you point at the tray icon."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="190"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Taskbar hover label"
                                              ItemsSource="{x:Bind ViewModel.TrayHoverLabelOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedTrayHoverLabelOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Support" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Export diagnostics" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Save logs and system details with sensitive information removed."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="40"
                                        Height="32"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.ExportDiagnosticsCommand}"
                                        AutomationProperties.Name="Export diagnostics"
                                        ToolTipService.ToolTip="Export diagnostics">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Expander Style="{StaticResource CardContentExpanderStyle}"
                                      AutomationProperties.Name="Troubleshooting details">
                                <Expander.Header>
                                    <StackPanel Spacing="3" Margin="0,10,0,10">
                                        <TextBlock Text="Troubleshooting" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="View service, device, and connection details."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Service" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap"
