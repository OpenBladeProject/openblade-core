                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker MinWidth="320"
                                                                 DataContext="{x:Bind Mode=OneWay}"
                                                                 IsAlphaEnabled="False"
                                                                 IsAlphaSliderVisible="False"
                                                                 IsAlphaTextInputVisible="False"
                                                                 IsColorChannelTextInputVisible="True"
                                                                 IsHexInputVisible="True"
                                                                 Color="{Binding LightingSecondaryColorEditor, Mode=TwoWay, Converter={StaticResource RgbColor}}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsReactiveDuration, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockReactiveDuration" Text="Reactive duration" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChooseHowLongPressedKeysRemainLit" Text="Choose how long pressed keys remain lit."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Uid="MainWindow_ResponsiveChoiceSelectorReactiveLightingDuration" Grid.Column="1"
                                                                        CompactMinWidth="150"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="Reactive lighting duration"
                                                                        ItemsSource="{x:Bind LightingReactiveDurations}"
                                                                        SelectedItem="{x:Bind LightingReactiveDurationEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsStarlightDuration, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockStarlightDuration" Text="Starlight duration" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChooseHowLongEachRandomKeyFades" Text="Choose how long each random key fades in and out."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Uid="MainWindow_ResponsiveChoiceSelectorStarlightLightingDuration" Grid.Column="1"
                                                                        CompactMinWidth="150"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="Starlight lighting duration"
                                                                        ItemsSource="{x:Bind LightingStarlightDurations}"
                                                                        SelectedItem="{x:Bind LightingStarlightDurationEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                        <Border x:Name="ImportKeyboardLightingPresetCard"
                                Style="{StaticResource SettingsGroupStyle}"
                                Margin="0,10,0,0"
                                Visibility="{x:Bind LabFeaturesEnabled, Mode=OneWay}">
                            <Border Style="{StaticResource SettingsLastRowStyle}"
                                    Padding="0">
                                <Button x:Uid="MainWindow_ButtonImportKeyboardLightingPreset" Style="{StaticResource IconActionButtonStyle}"
                                        CornerRadius="8"
                                        IsEnabled="{x:Bind CanControlLighting, Mode=OneWay}"
                                        Click="OnImportKeyboardLighting"
                                        AutomationProperties.Name="Import keyboard lighting preset"
                                        ToolTipService.ToolTip="Import keyboard lighting preset">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock x:Uid="MainWindow_TextBlockImportPreset" Text="Import preset"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockLoadAnOpenBladeOrRazerChromaKeyboard" Text="Load an OpenBlade or Razer Chroma keyboard lighting file."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8E5;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="LightingLogoSection"
                                    Visibility="{x:Bind IsLogoLightingVisible, Mode=OneWay}">
                        <TextBlock x:Uid="MainWindow_TextBlockLaptopLogo" Text="Laptop logo"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,24,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsLastRowStyle}"
                                        Visibility="{x:Bind IsLogoLightingVisible, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockMode" Text="Mode" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChooseTheLightingModeForTheRazer" Text="Choose the lighting mode for the Razer logo on the lid."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Uid="MainWindow_LaptopLogoModeSelectorText" x:Name="LaptopLogoModeSelector"
                                                                        Grid.Column="1"
                                                                        CompactMinWidth="170"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="Laptop logo lighting"
                                                                        ItemsSource="{x:Bind AvailableLogoLightingModeOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        SelectedItem="{x:Bind SelectedLogoLightingModeOption, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="LightingPowerSavingSection"
                                    Visibility="{x:Bind ShowOpenBladeKeyboardLightingControls, Mode=OneWay}">
                        <TextBlock x:Uid="MainWindow_TextBlockSwitchOffLighting" Text="Switch off lighting"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,24,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockWhenTheDisplayTurnsOff" Text="When the display turns off"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockSwitchOffKeyboardLightingUntilTheDisplay" Text="Switch off keyboard lighting until the display turns on again."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Uid="MainWindow_LightingDisplayOffToggleText" x:Name="LightingDisplayOffToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Turn off keyboard lighting with the display"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind LightingTurnOffWithDisplayEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockAfterInactivity" Text="After inactivity"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockSwitchOffKeyboardLightingWhenYouHave" Text="Switch off keyboard lighting when you have not used the laptop."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Uid="MainWindow_LightingIdleTimeoutToggleText" x:Name="LightingIdleTimeoutToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Turn off keyboard lighting after inactivity"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind LightingIdleTimeoutEnabledEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockInactivityTimeout" Text="Inactivity timeout"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChooseFrom1To60Minutes" Text="Choose from 1 to 60 minutes."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <NumberBox x:Uid="MainWindow_LightingIdleTimeoutNumberBoxText" x:Name="LightingIdleTimeoutNumberBox"
                                                   Grid.Column="1"
                                                   Width="120"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Minimum="1"
                                                   Maximum="60"
                                                   SmallChange="1"
                                                   LargeChange="5"
                                                   SpinButtonPlacementMode="Compact"
                                                   IsEnabled="{x:Bind LightingIdleTimeoutEnabledEditor, Mode=OneWay}"
                                                   AutomationProperties.Name="Keyboard lighting inactivity timeout in minutes"
                                                   Value="{Binding LightingIdleTimeoutMinutesEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                            </StackPanel>
                        </ContentControl>
                        </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DashboardDisplayCardTemplate" x:DataType="local:DisplaySettingsViewModel">
                        <StackPanel>
                        <TextBlock x:Uid="MainWindow_TextBlockBuiltInDisplay" Text="Built-in display"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockRefreshRate" Text="Refresh rate"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockChooseARefreshRateReportedByWindows" Text="Choose a refresh rate reported by Windows or use dynamic refresh rate."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Uid="MainWindow_DisplayRefreshRatePickerText" x:Name="DisplayRefreshRatePicker"
                                                                        Grid.Column="1"
                                                                        CompactMinWidth="180"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="Display refresh rate"
                                                                        ItemsSource="{x:Bind RefreshRateOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        SelectedItem="{x:Bind SelectedRefreshRate, Mode=OneWay}"
                                                                        IsEnabled="{x:Bind CanChangeRefreshRate, Mode=OneWay}"
                                                                        DropDownOpened="OnDisplayPickerOpened"
                                                                        DropDownClosed="OnDisplayPickerClosed"
                                                                        SelectionChanged="OnDisplayRefreshRateChanged" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockUseHDR" Text="Use HDR"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="MainWindow_TextBlockShowAWiderRangeOfColorsAnd" Text="Show a wider range of colors and brightness in supported content."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Uid="MainWindow_DisplayHdrToggleText" x:Name="DisplayHdrToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Use HDR"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind IsHdrEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind CanChangeHdr, Mode=OneWay}"
                                                      Toggled="OnDisplayHdrToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Uid="MainWindow_TextBlockColorProfile" Text="Color profile"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ColorProfileDescription, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Uid="MainWindow_DisplayColorProfilePickerText" x:Name="DisplayColorProfilePicker"
                                                                        Grid.Column="1"
                                                                        CompactMinWidth="180"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="Display color profile"
                                                                        ItemsSource="{x:Bind ColorProfileOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        SelectedItem="{x:Bind SelectedColorProfile, Mode=OneWay}"
                                                                        IsEnabled="{x:Bind CanChangeColorProfile, Mode=OneWay}"
                                                                        DropDownOpened="OnDisplayPickerOpened"
                                                                        DropDownClosed="OnDisplayPickerClosed"
                                                                        SelectionChanged="OnDisplayColorProfileChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" />
                        </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="OpenBlade"
                  Background="Transparent" />

        <NavigationView x:Uid="MainWindow_MainNavigationText" x:Name="MainNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <!-- The stock indicator can be clipped while traveling between
                     distant items. The selected Fluent background stays clear
                     and changes immediately without that motion artifact. -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow_HomeNavigationItemText" x:Name="HomeNavigationItem"
                                    Content="Dashboard"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeDashboardHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasDashboardProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="Dashboard has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfilesNavigationItem" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Uid="MainWindow_TextBlockProfiles" Text="Profiles" />
                    </NavigationViewItem.Content>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeProfilesHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasUnsavedProfileChanges, Mode=OneWay}"
                                   AutomationProperties.Name="Profiles has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_DisplayNavigationItemText" x:Name="DisplayNavigationItem" Content="Display" Tag="display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeDisplayHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}"
                                   AutomationProperties.Name="Display has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_LaptopNavigationItemText" x:Name="LaptopNavigationItem"
                                    Content="Laptop"
                                    Tag="laptop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeLaptopHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLaptopPageProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="Laptop has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_LightingNavigationItemText" x:Name="LightingNavigationItem"
                                    Content="Lighting"
                                    Tag="lighting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE781;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Uid="MainWindow_InfoBadgeLightingHasUnsavedChanges" Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLightingProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="Lighting has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_SettingsNavigationItemText" x:Name="SettingsNavigationItem"
                                    Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="MainWindow_AboutNavigationItemText" x:Name="AboutNavigationItem"
                                    Content="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="HomePage"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=HomePage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="DashboardPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="MainWindow_TextBlockDashboard" Text="Dashboard" Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="DashboardProfileSaveActions"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasDashboardProfileActionOpportunity, Mode=OneWay}">
                                    <Button Content="{x:Bind ViewModel.DashboardProfileSaveLabel, Mode=OneWay}"
                                            Style="{StaticResource ProfileSaveButtonStyle}"
                                            Visibility="{x:Bind ViewModel.HasDashboardProfileSaveOpportunity, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SaveProfilesCommand}" />
                                    <Button x:Uid="MainWindow_ButtonUseProfileSettings" Content="Use profile settings"
                                            Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                            Visibility="{x:Bind ViewModel.HasDashboardProfileRestoreOpportunity, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.DiscardProfileDraftCommand}" />
                                </StackPanel>
                                <Button x:Uid="MainWindow_ButtonCustomize" Content="Customize"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        AutomationProperties.Name="Customize dashboard"
                                        Click="OnCustomizeDashboard" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="DashboardCardHost">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Border x:Name="DeviceStatusCard"
                                Style="{StaticResource CardStyle}"
                                Padding="22">
                            <Grid x:Name="HeroLayout" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Uid="MainWindow_ProfileStateBadgeText" x:Name="ProfileStateBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Click="OnProfileStateBadgeClick"
                                                AutomationProperties.Name="Open troubleshooting details"
                                                 ToolTipService.ToolTip="View device status">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessReady, Mode=OneWay}" />
                                                    <ProgressRing Width="12" Height="12"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                             </StackPanel>
                                         </Button>
                                        <Button x:Uid="MainWindow_TestedPlatformWarningBadgeText" x:Name="TestedPlatformWarningBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasUntestedPlatformVersion, Mode=OneWay}"
                                                Click="OnTestedPlatformWarningClick"
                                                AutomationProperties.Name="Review untested system versions"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.DashboardTestedPlatformWarningMessage, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.PlatformCompatibilityWarningTitle, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Uid="MainWindow_AttentionIndicatorText" x:Name="AttentionIndicator"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                                AutomationProperties.Name="Show warning details"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}">
                                            <Button.Flyout>
                                                <Flyout x:Name="AttentionFlyout"
                                                        Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel MaxWidth="360" Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <Button x:Uid="MainWindow_ButtonReapplyOpenBladeSettings" HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanReapplyChangedSettings, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.ShowReapplyChangedSettings, Mode=OneWay}"
                                                                Click="OnReapplyChangedSettingsClick"
                                                                AutomationProperties.Name="Reapply OpenBlade settings">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}" />
                                                                <TextBlock x:Uid="MainWindow_TextBlockReapplyOpenBladeSettings" Text="Reapply OpenBlade settings" />
                                                            </StackPanel>
                                                        </Button>
