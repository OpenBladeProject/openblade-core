                                        <NumberBox x:Name="LightingIdleTimeoutNumberBox"
                                                   Grid.Column="1"
                                                   Width="120"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Minimum="1"
                                                   Maximum="60"
                                                   SmallChange="1"
                                                   LargeChange="5"
                                                   SpinButtonPlacementMode="Compact"
                                                   IsEnabled="{x:Bind LightingIdleTimeoutEnabledEditor, Mode=OneWay}"
                                                   AutomationProperties.Name="Keyboard lighting inactivity timeout in minutes"
                                                   Value="{Binding LightingIdleTimeoutMinutesEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </ContentControl>
                        </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DashboardDisplayCardTemplate" x:DataType="local:DisplaySettingsViewModel">
                        <StackPanel>
                        <TextBlock Text="Built-in display"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Refresh rate"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose a refresh rate reported by Windows or use dynamic refresh rate."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="DisplayRefreshRatePicker"
                                                  Grid.Column="1"
                                                  MinWidth="180"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Display refresh rate"
                                                  ItemsSource="{x:Bind RefreshRateOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedRefreshRate, Mode=OneWay}"
                                                  IsEnabled="{x:Bind CanChangeRefreshRate, Mode=OneWay}"
                                                  DropDownOpened="OnDisplayPickerOpened"
                                                  DropDownClosed="OnDisplayPickerClosed"
                                                  SelectionChanged="OnDisplayRefreshRateChanged" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Use HDR"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Show a wider range of colors and brightness in supported content."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DisplayHdrToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Use HDR"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind IsHdrEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind CanChangeHdr, Mode=OneWay}"
                                                      Toggled="OnDisplayHdrToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Color profile"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ColorProfileDescription, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="DisplayColorProfilePicker"
                                                  Grid.Column="1"
                                                  MinWidth="180"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Display color profile"
                                                  ItemsSource="{x:Bind ColorProfileOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedColorProfile, Mode=OneWay}"
                                                  IsEnabled="{x:Bind CanChangeColorProfile, Mode=OneWay}"
                                                  DropDownOpened="OnDisplayPickerOpened"
                                                  DropDownClosed="OnDisplayPickerClosed"
                                                  SelectionChanged="OnDisplayColorProfileChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" />
                        </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="OpenBlade"
                  Background="Transparent" />

        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <!-- The stock indicator can be clipped while traveling between
                     distant items. The selected Fluent background stays clear
                     and changes immediately without that motion artifact. -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem"
                                    Content="Dashboard"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasThermalProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="Dashboard has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfilesNavigationItem" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Profiles" />
                    </NavigationViewItem.Content>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasProfileEditorChanges, Mode=OneWay}"
                                   AutomationProperties.Name="Profiles has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DisplayNavigationItem" Content="Display" Tag="display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}"
                                   AutomationProperties.Name="Display has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LaptopNavigationItem"
                                    Content="Laptop"
                                    Tag="laptop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLaptopPageProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="Laptop has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LightingNavigationItem"
                                    Content="Lighting"
                                    Tag="lighting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE781;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLightingProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="Lighting has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem"
                                    Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem"
                                    Content="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid HorizontalAlignment="Stretch">
                <ScrollView x:Name="HomePage"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28" HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="DashboardPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="DashboardProfileSaveActions"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasLaptopPageProfileDraft, Mode=OneWay}">
                                    <TextBlock Text="Unsaved changes"
                                               Style="{StaticResource ProfileSaveStatusTextStyle}" />
                                    <Button Content="{x:Bind ViewModel.SaveToActiveProfileLabel, Mode=OneWay}"
                                            Style="{StaticResource ProfileSaveButtonStyle}"
                                            Command="{x:Bind ViewModel.SaveLaptopProfileDraftCommand}" />
                                    <Button Style="{StaticResource ProfileSaveOverflowButtonStyle}"
                                            AutomationProperties.Name="More profile actions"
                                            ToolTipService.ToolTip="More profile actions">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Use profile settings"
                                                                Command="{x:Bind ViewModel.DiscardLaptopProfileDraftCommand}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <Button Content="Customize"
                                        AutomationProperties.Name="Customize dashboard"
                                        Click="OnCustomizeDashboard" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="DashboardCardHost">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Border x:Name="DeviceStatusCard"
                                Style="{StaticResource CardStyle}"
                                Padding="22">
                            <Grid x:Name="HeroLayout" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="ProfileStateBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Click="OnProfileStateBadgeClick"
                                                AutomationProperties.Name="Open troubleshooting details"
                                                ToolTipService.ToolTip="View device status">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessReady, Mode=OneWay}" />
                                                    <ProgressRing Width="12" Height="12"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AttentionIndicator"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                                AutomationProperties.Name="Show warning details"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel MaxWidth="360" Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="AttentionIndicatorLabel"
                                                           Text="{x:Bind ViewModel.AttentionBadgeLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ActivePerformanceLabel, Mode=OneWay}"
                                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveFanModeLabel, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBatterySettingLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="HeroReadings"
                                        Grid.Row="1"
                                        Margin="0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.LiveReadingsRefreshToolTip, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ShowDashboardLiveReadings, Mode=OneWay}">
                                    <Grid Background="Transparent">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="340"
                                                           Text="{x:Bind ViewModel.LiveReadingsRefreshToolTip, Mode=OneWay}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleDashboardTelemetryGroups, Mode=OneWay}"
                                                       HorizontalAlignment="Stretch">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout Orientation="Horizontal"
                                                                   MinItemWidth="100"
                                                                   MinItemHeight="48"
                                                                   MinColumnSpacing="0"
                                                                   MaximumRowsOrColumns="3"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:LiveReadingGroupDisplayItem">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                                                   Style="{StaticResource SecondaryTextStyle}" />
                                                        <TextBlock Text="{x:Bind Value, Mode=OneTime}"
                                                                   Style="{StaticResource CardTitleStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>

                        <InfoBar x:Name="OperationErrorInfoBar"
                                 IsOpen="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.OperationFeedbackMessage, Mode=OneWay}"
                                 Severity="Error"
                                 IsClosable="True"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Operation error" />

                        <Border x:Name="DashboardEmptyState"
                                Style="{StaticResource CardStyle}"
                                Padding="22"
                                Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Your Dashboard is empty"
                                           Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Use Customize to add the cards you want to see here."
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <ContentControl x:Name="PowerModeCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardPowerModeCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="FansCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardFansCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="BatteryCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardBatteryCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollView>

                <ScrollView x:Name="ProfilesPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28" HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid Margin="0,0,0,20" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Profiles"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="Import profiles"
                                        Click="OnImportProfiles"
                                        ToolTipService.ToolTip="Import saved profiles from JSON"
                                        AutomationProperties.Name="Import profiles from JSON" />
                                <Button Content="Export profiles"
                                        Click="OnExportProfiles"
                                        ToolTipService.ToolTip="Export saved profiles as JSON"
                                        AutomationProperties.Name="Export profiles to JSON" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="These are the settings saved in each profile. Unsaved changes from Laptop, Dashboard, Lighting, or Display appear here only after you save them."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,16" />

                        <StackPanel x:Name="ProfilesComparisonLayout">
                            <Grid Margin="16,0,16,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Setting"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="AC" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource ActiveProfilePillStyle}"
                                                Visibility="{x:Bind ViewModel.IsPluggedInProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Style="{StaticResource ActiveProfilePillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Changes pending"
                                               Style="{StaticResource DraftStatusTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsPluggedInProfileDraft, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="USB-C" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource ActiveProfilePillStyle}"
                                                Visibility="{x:Bind ViewModel.IsUsbCProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Style="{StaticResource ActiveProfilePillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Changes pending"
                                               Style="{StaticResource DraftStatusTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsUsbCProfileDraft, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="Battery" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource ActiveProfilePillStyle}"
                                                Visibility="{x:Bind ViewModel.IsBatteryProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Style="{StaticResource ActiveProfilePillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Changes pending"
                                               Style="{StaticResource DraftStatusTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsBatteryProfileDraft, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Power and cooling" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,10" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Power mode" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PluggedInProfilePresentation.PowerMode, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UsbCProfilePresentation.PowerMode, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.BatteryProfilePresentation.PowerMode, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsLastRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fans" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PluggedInProfilePresentation.Fans, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UsbCProfilePresentation.Fans, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.BatteryProfilePresentation.Fans, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Keyboard lighting" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Effect" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PluggedInProfilePresentation.LightingEffect, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UsbCProfilePresentation.LightingEffect, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.BatteryProfilePresentation.LightingEffect, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PluggedInProfilePresentation.LightingBrightness, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UsbCProfilePresentation.LightingBrightness, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.BatteryProfilePresentation.LightingBrightness, Mode=OneWay}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Color" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PluggedInProfilePresentation.LightingColor, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UsbCProfilePresentation.LightingColor, Mode=OneWay}" TextWrapping="Wrap" />
