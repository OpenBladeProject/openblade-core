                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-core/issues"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="{CustomResource MainWindow_HyperlinkButtonOpenGitHubIssues.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                     ToolTipService.ToolTip="{CustomResource MainWindow_HyperlinkButtonOpenGitHubIssues.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockReportAProblem.Text}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockOpenGitHubIssuesToReportABug.Text}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border local:CardReorder.CardId="MainWindow_HyperlinkButtonOpenDocumentation" Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-docs"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="{CustomResource MainWindow_HyperlinkButtonOpenDocumentation.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                     ToolTipService.ToolTip="{CustomResource MainWindow_HyperlinkButtonOpenDocumentation.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockDocumentation.Text}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockReadSetupUsageAndCompatibilityInformation.Text}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border local:CardReorder.CardId="MainWindow_HyperlinkButtonOpenReleaseNotes" Style="{StaticResource SettingsRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-core/blob/main/CHANGELOG.md"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     AutomationProperties.Name="{CustomResource MainWindow_HyperlinkButtonOpenReleaseNotes.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                     ToolTipService.ToolTip="{CustomResource MainWindow_HyperlinkButtonOpenReleaseNotes.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockReleaseNotes.Text}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockSeeWhatChangedInEachOpenBladeBuild.Text}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                                <Border local:CardReorder.CardId="MainWindow_HyperlinkButtonOpenSourceCode" Style="{StaticResource SettingsLastRowStyle}" Padding="0">
                                    <HyperlinkButton NavigateUri="https://github.com/OSSBlade/openblade-core"
                                                     Style="{StaticResource ExternalLinkButtonStyle}"
                                                     CornerRadius="0,0,8,8"
                                                     AutomationProperties.Name="{CustomResource MainWindow_HyperlinkButtonOpenSourceCode.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                     ToolTipService.ToolTip="{CustomResource MainWindow_HyperlinkButtonOpenSourceCode.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockSourceCode.Text}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockViewAndContributeToOpenBladeOnGitHub.Text}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE8A7;"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CardActionIconStyle}" />
                                    </Grid>
                                    </HyperlinkButton>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutTroubleshootingSection">
                        <TextBlock local:CardReorder.IsHeader="True" Text="{CustomResource MainWindow_TextBlockTroubleshooting.Text}" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Expander x:Name="TroubleshootingExpander"
                                      Style="{StaticResource CardContentExpanderStyle}"
                                      PointerEntered="OnTroubleshootingHeaderPointerEntered"
                                      PointerMoved="OnTroubleshootingHeaderPointerMoved"
                                      PointerExited="OnTroubleshootingHeaderPointerExited"
                                      PointerPressed="OnTroubleshootingHeaderPointerPressed"
                                      PointerReleased="OnTroubleshootingHeaderPointerReleased"
                                      PointerCanceled="OnTroubleshootingHeaderPointerCanceled"
                                      PointerCaptureLost="OnTroubleshootingHeaderPointerCanceled"
                                      AutomationProperties.Name="{CustomResource MainWindow_TroubleshootingExpanderText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Grid x:Name="TroubleshootingHeaderSurface"
                                          Margin="-16,0,-60,0">
                                        <Border x:Name="TroubleshootingHeaderHoverBackground"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <Border x:Name="TroubleshootingHeaderPressedBackground"
                                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <StackPanel Spacing="3" Margin="16,14,60,14">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockServiceAndDeviceStatus.Text}" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockViewLiveConnectionAndControlDetails.Text}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockOpenBladeService.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind ViewModel.TroubleshootingServiceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                                <Button x:Name="StartOpenBladeButton"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.IsServiceUnavailable, Mode=OneWay}"
                                                        Click="OnStartOpenBlade"
                                                        AutomationProperties.LiveSetting="Polite"
                                                        AutomationProperties.Name="{CustomResource MainWindow_StartServiceButtonText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                                    <Grid>
                                                        <TextBlock
                                                                   x:Name="StartOpenBladeButtonLabel"
                                                                   Text="{CustomResource MainWindow_TextBlockStartService.Text}"
                                                                   Opacity="1" />
                                                        <ProgressRing x:Name="StartOpenBladeProgressRing"
                                                                      Width="14"
                                                                      Height="14"
                                                                      IsActive="False"
                                                                      Visibility="Collapsed"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      AutomationProperties.AccessibilityView="Raw" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}"
                                            Visibility="{x:Bind ViewModel.HasPendingHyperBoostRestore, Mode=OneWay}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockSavedHyperBoostRestore.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.HyperBoostRestoreRecoveryText, Mode=OneWay}"
                                                           Style="{StaticResource TroubleshootingValueStyle}"
                                                           TextWrapping="Wrap" />
                                                <Button
                                                        HorizontalAlignment="Left"
                                                        IsEnabled="{x:Bind ViewModel.CanRecoverHyperBoostRestore, Mode=OneWay}"
                                                        Click="OnRecoverHyperBoostRestoreClick"
                                                        AutomationProperties.Name="{CustomResource MainWindow_ButtonRecoverHyperBoostRestoreTroubleshooting.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ProgressRing Width="14"
                                                                      Height="14"
                                                                      IsActive="{x:Bind ViewModel.IsHyperBoostRestoreRecoveryInProgress, Mode=OneWay}"
                                                                      Visibility="{x:Bind ViewModel.IsHyperBoostRestoreRecoveryInProgress, Mode=OneWay}" />
                                                        <TextBlock Text="{CustomResource MainWindow_TextBlockRecoverHyperBoostRestoreTroubleshooting.Text}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockLaptopBehavior2.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <ProgressRing Width="12" Height="12"
                                                                  Margin="0,0,7,0"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingControlsStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockKeyboardDriverMode.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ViewModel.TroubleshootingKeyboardDriverModeStatus, Mode=OneWay}"
                                                       Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockPowerSource.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingPowerSourceStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockOtherRazerSoftwareRunning.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind ViewModel.TroubleshootingOtherRazerSoftwareStatus, Mode=OneWay}"
                                                           Style="{StaticResource TroubleshootingValueStyle}"
                                                           TextWrapping="Wrap" />
                                                <Button x:Name="StopRazerServicesButton"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Style="{StaticResource DestructiveButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Click="OnStopRazerServices"
                                                        AutomationProperties.Name="{CustomResource MainWindow_StopRazerServicesButtonText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                        AutomationProperties.LiveSetting="Polite">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <ProgressRing x:Name="StopRazerServicesProgressRing"
                                                                      Width="14"
                                                                      Height="14"
                                                                      IsIndeterminate="True"
                                                                      IsActive="False"
                                                                      Visibility="Collapsed" />
                                                        <FontIcon x:Name="StopRazerServicesIcon"
                                                                  Glyph="&#xE71A;"
                                                                  FontSize="14" />
                                                        <TextBlock x:Name="StopRazerServicesButtonLabel"
                                                                   Text="{CustomResource MainWindow_StopRazerServicesButtonLabelText.Text}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource TroubleshootingSectionStyle}" Visibility="{x:Bind ViewModel.HasTroubleshootingRecentError, Mode=OneWay}">
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockRecentError.Text}" Style="{StaticResource TroubleshootingLabelStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TroubleshootingRecentErrorStatus, Mode=OneWay}" Style="{StaticResource TroubleshootingValueStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <Canvas x:Name="GlobalSearchArrivalOverlay" Grid.RowSpan="2" IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="GlobalSearchArrivalOutline" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</UserControl>
