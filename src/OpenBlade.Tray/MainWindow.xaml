                                    </StackPanel>
                                    <ToggleSwitch x:Name="WindowsDynamicLightingToggle"
                                                  Grid.Column="1"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Let Windows Dynamic Lighting control the keyboard"
                                                  OffContent=""
                                                  OnContent=""
                                                  IsOn="{x:Bind UseWindowsDynamicLighting, Mode=OneWay}"
                                                  Toggled="OnWindowsDynamicLightingToggled" />
                                </Grid>
                            </Border>
                        </Border>
                        <ContentControl x:Name="LightingControls"
                                        HorizontalContentAlignment="Stretch"
                                        IsEnabled="{x:Bind CanRequestHardwareControl, Mode=OneWay}">
                            <StackPanel x:Name="LightingSectionHost">
                        <StackPanel x:Name="LightingKeyboardSection"
                                    Visibility="{x:Bind ShowOpenBladeKeyboardLightingControls, Mode=OneWay}">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Effect" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind KeyboardEffectDescription, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LightingEffectPicker"
                                                  Grid.Column="1"
                                                  MinWidth="190"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Keyboard lighting effect"
                                                  ItemsSource="{x:Bind AvailableLightingEffectOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  PlaceholderText="Current effect unavailable"
                                                  SelectedItem="{x:Bind SelectedLightingEffectOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedLightingEffectOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsBrightness, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Brightness" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Adjust the keyboard lighting level."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1"
                                              ColumnSpacing="12"
                                              VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="DashboardLightingBrightnessSlider"
                                                    Style="{StaticResource InlineCardSliderStyle}"
                                                    Minimum="1"
                                                    Maximum="100"
                                                    StepFrequency="1"
                                                    SmallChange="1"
                                                    LargeChange="10"
                                                    IsThumbToolTipEnabled="True"
                                                    AutomationProperties.Name="Keyboard lighting brightness"
                                                    Value="{Binding LightingBrightnessEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind LightingBrightnessEditor, Mode=OneWay}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="%" Style="{StaticResource CardTitleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsAmbientAwarenessRegion, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Screen region" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose which part of the display colors the keyboard."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="150"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Ambient Awareness screen region"
                                                  ItemsSource="{x:Bind AvailableAmbientAwarenessRegionOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedAmbientAwarenessRegionOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedAmbientAwarenessRegionOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsAudioMeterControls, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Color boost" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Increase how strongly audio levels drive the keyboard colors."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid Grid.Column="1"
                                              ColumnSpacing="12"
                                              VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="DashboardAudioMeterColorBoostSlider"
                                                    Style="{StaticResource InlineCardSliderStyle}"
                                                    Minimum="1"
                                                    Maximum="4"
                                                    StepFrequency="0.25"
                                                    SmallChange="0.25"
                                                    LargeChange="1"
                                                    IsThumbToolTipEnabled="True"
                                                    AutomationProperties.Name="Audio Meter color boost"
                                                    Value="{x:Bind LightingAudioMeterColorBoostEditor, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind LightingAudioMeterColorBoostEditor, Mode=OneWay}"
                                                       Style="{StaticResource InlineCardSliderValueStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsAudioMeterControls, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Smooth quiet changes" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Keeps the keyboard lit for up to the selected time when sound gets quieter or pauses. Louder sounds still respond immediately."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid Grid.Column="1"
                                              ColumnSpacing="12"
                                              VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="DashboardAudioMeterDecaySlider"
                                                    Style="{StaticResource InlineCardSliderStyle}"
                                                    Minimum="0"
                                                    Maximum="2000"
                                                    StepFrequency="250"
                                                    SmallChange="250"
                                                    LargeChange="500"
                                                    IsThumbToolTipEnabled="False"
                                                    AutomationProperties.Name="Audio Meter quiet-change smoothing"
                                                    Value="{x:Bind LightingAudioMeterDecayMillisecondsEditor, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind LightingAudioMeterDecayValue, Mode=OneWay}"
                                                       Style="{StaticResource InlineCardSliderValueStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsBreathingColorMode, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Breathing colors" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Use one color, alternate between two, or choose random colors."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="150"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Breathing color mode"
                                                  ItemsSource="{x:Bind LightingBreathingColorModes}"
                                                  SelectedItem="{x:Bind LightingBreathingColorModeEditor, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind LightingBreathingColorModeEditor, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsStarlightColorMode, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Starlight colors" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Use one color, alternate between two, or choose random colors."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="150"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Starlight color mode"
                                                  ItemsSource="{x:Bind LightingStarlightColorModes}"
                                                  SelectedItem="{x:Bind LightingStarlightColorModeEditor, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind LightingStarlightColorModeEditor, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsRandomColors, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Random colors" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose a new color pair for each Tidal cycle."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Random Tidal colors"
                                                      IsOn="{x:Bind LightingRandomColorsEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsDirection, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Direction" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose which way the effect moves."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="150"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Lighting direction"
                                                  ItemsSource="{x:Bind LightingDirectionOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedLightingDirectionOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedLightingDirectionOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsRotationDirection, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Rotation" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose which way the Wheel effect rotates."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="170"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Wheel rotation direction"
                                                  ItemsSource="{x:Bind LightingRotationDirections}"
                                                  SelectedItem="{x:Bind LightingRotationDirectionEditor, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind LightingRotationDirectionEditor, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsPrimaryColor, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind LightingPrimaryColorLabel, Mode=OneWay}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind LightingPrimaryColorDescription, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                MinWidth="150"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Choose keyboard color">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="18"
                                                        Height="18"
                                                        CornerRadius="9"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding LightingPrimaryColorEditor, Mode=OneWay, Converter={StaticResource RgbColor}, ConverterParameter=Brush}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding LightingPrimaryColorEditor, Mode=OneWay, Converter={StaticResource RgbColor}, ConverterParameter=Hex}" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker MinWidth="320"
                                                                 DataContext="{x:Bind Mode=OneWay}"
                                                                 IsAlphaEnabled="False"
                                                                 IsAlphaSliderVisible="False"
                                                                 IsAlphaTextInputVisible="False"
                                                                 IsColorChannelTextInputVisible="True"
                                                                 IsHexInputVisible="True"
                                                                 Color="{Binding LightingPrimaryColorEditor, Mode=TwoWay, Converter={StaticResource RgbColor}}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsSecondaryColor, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Second color" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose the effect's second color."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                MinWidth="150"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Choose second keyboard color">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="18"
                                                        Height="18"
                                                        CornerRadius="9"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding LightingSecondaryColorEditor, Mode=OneWay, Converter={StaticResource RgbColor}, ConverterParameter=Brush}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding LightingSecondaryColorEditor, Mode=OneWay, Converter={StaticResource RgbColor}, ConverterParameter=Hex}" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker MinWidth="320"
                                                                 DataContext="{x:Bind Mode=OneWay}"
                                                                 IsAlphaEnabled="False"
                                                                 IsAlphaSliderVisible="False"
                                                                 IsAlphaTextInputVisible="False"
                                                                 IsColorChannelTextInputVisible="True"
                                                                 IsHexInputVisible="True"
                                                                 Color="{Binding LightingSecondaryColorEditor, Mode=TwoWay, Converter={StaticResource RgbColor}}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsReactiveDuration, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Reactive duration" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose how long pressed keys remain lit."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="150"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Reactive lighting duration"
                                                  ItemsSource="{x:Bind LightingReactiveDurations}"
                                                  SelectedItem="{x:Bind LightingReactiveDurationEditor, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind LightingReactiveDurationEditor, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsRowStyle}"
                                        Visibility="Collapsed"
                                        local:AnimatedVisibility.IsVisible="{x:Bind LightingShowsStarlightDuration, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Starlight duration" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose how long each random key fades in and out."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="150"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Starlight lighting duration"
                                                  ItemsSource="{x:Bind LightingStarlightDurations}"
                                                  SelectedItem="{x:Bind LightingStarlightDurationEditor, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind LightingStarlightDurationEditor, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="LightingLogoSection"
                                    Visibility="{x:Bind IsLogoLightingVisible, Mode=OneWay}">
                        <TextBlock Text="Laptop logo"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,24,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsLastRowStyle}"
                                        Visibility="{x:Bind IsLogoLightingVisible, Mode=OneWay}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Mode" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose the lighting mode for the Razer logo on the lid."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="170"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Laptop logo lighting"
                                                  ItemsSource="{x:Bind AvailableLogoLightingModeOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedLogoLightingModeOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedLogoLightingModeOption, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="LightingPowerSavingSection"
                                    Visibility="{x:Bind ShowOpenBladeKeyboardLightingControls, Mode=OneWay}">
                        <TextBlock Text="Switch off lighting"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,24,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="When the display turns off"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Switch off keyboard lighting until the display turns on again."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LightingDisplayOffToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Turn off keyboard lighting with the display"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind LightingTurnOffWithDisplayEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="After inactivity"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Switch off keyboard lighting when you have not used the laptop."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LightingIdleTimeoutToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Turn off keyboard lighting after inactivity"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind LightingIdleTimeoutEnabledEditor, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Inactivity timeout"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose from 1 to 60 minutes."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <NumberBox x:Name="LightingIdleTimeoutNumberBox"
                                                   Grid.Column="1"
                                                   Width="120"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Minimum="1"
                                                   Maximum="60"
                                                   SmallChange="1"
                                                   LargeChange="5"
                                                   SpinButtonPlacementMode="Compact"
                                                   IsEnabled="{x:Bind LightingIdleTimeoutEnabledEditor, Mode=OneWay}"
                                                   AutomationProperties.Name="Keyboard lighting inactivity timeout in minutes"
                                                   Value="{Binding LightingIdleTimeoutMinutesEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                            </StackPanel>
                        </ContentControl>
                        </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DashboardDisplayCardTemplate" x:DataType="local:DisplaySettingsViewModel">
                        <StackPanel>
                        <TextBlock Text="Built-in display"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Refresh rate"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose a refresh rate reported by Windows or use dynamic refresh rate."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="DisplayRefreshRatePicker"
                                                  Grid.Column="1"
                                                  MinWidth="180"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Display refresh rate"
                                                  ItemsSource="{x:Bind RefreshRateOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedRefreshRate, Mode=OneWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedRefreshRate, Mode=OneWay}"
                                                  IsEnabled="{x:Bind CanChangeRefreshRate, Mode=OneWay}"
                                                  DropDownOpened="OnDisplayPickerOpened"
                                                  DropDownClosed="OnDisplayPickerClosed"
                                                  SelectionChanged="OnDisplayRefreshRateChanged" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Use HDR"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Show a wider range of colors and brightness in supported content."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DisplayHdrToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Use HDR"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind IsHdrEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind CanChangeHdr, Mode=OneWay}"
                                                      Toggled="OnDisplayHdrToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Color profile"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ColorProfileDescription, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="DisplayColorProfilePicker"
                                                  Grid.Column="1"
                                                  MinWidth="180"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="Display color profile"
                                                  ItemsSource="{x:Bind ColorProfileOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedColorProfile, Mode=OneWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedColorProfile, Mode=OneWay}"
                                                  IsEnabled="{x:Bind CanChangeColorProfile, Mode=OneWay}"
                                                  DropDownOpened="OnDisplayPickerOpened"
                                                  DropDownClosed="OnDisplayPickerClosed"
                                                  SelectionChanged="OnDisplayColorProfileChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" />
                        </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="OpenBlade"
                  Background="Transparent" />

        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <!-- The stock indicator can be clipped while traveling between
                     distant items. The selected Fluent background stays clear
                     and changes immediately without that motion artifact. -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem"
                                    Content="Dashboard"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasDashboardProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="Dashboard has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfilesNavigationItem" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Profiles" />
                    </NavigationViewItem.Content>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasUnsavedProfileChanges, Mode=OneWay}"
                                   AutomationProperties.Name="Profiles has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DisplayNavigationItem" Content="Display" Tag="display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}"
                                   AutomationProperties.Name="Display has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LaptopNavigationItem"
                                    Content="Laptop"
                                    Tag="laptop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLaptopPageProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="Laptop has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LightingNavigationItem"
                                    Content="Lighting"
                                    Tag="lighting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE781;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLightingProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="Lighting has unsaved changes" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem"
                                    Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem"
                                    Content="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="HomePage"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=HomePage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="DashboardPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="DashboardProfileSaveActions"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasDashboardProfileActionOpportunity, Mode=OneWay}">
                                    <Button Content="{x:Bind ViewModel.DashboardProfileSaveLabel, Mode=OneWay}"
                                            Style="{StaticResource ProfileSaveButtonStyle}"
                                            Visibility="{x:Bind ViewModel.HasDashboardProfileSaveOpportunity, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SaveProfilesCommand}" />
                                    <Button Content="Use profile settings"
                                            Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                            Visibility="{x:Bind ViewModel.HasDashboardProfileRestoreOpportunity, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.DiscardProfileDraftCommand}" />
                                </StackPanel>
                                <Button Content="Customize"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        AutomationProperties.Name="Customize dashboard"
                                        Click="OnCustomizeDashboard" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="DashboardCardHost">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Border x:Name="DeviceStatusCard"
                                Style="{StaticResource CardStyle}"
                                Padding="22">
                            <Grid x:Name="HeroLayout" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="ProfileStateBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Click="OnProfileStateBadgeClick"
                                                AutomationProperties.Name="Open troubleshooting details"
                                                 ToolTipService.ToolTip="View device status">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessReady, Mode=OneWay}" />
                                                    <ProgressRing Width="12" Height="12"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                             </StackPanel>
                                         </Button>
                                        <Button x:Name="TestedPlatformWarningBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasUntestedPlatformVersion, Mode=OneWay}"
                                                Click="OnTestedPlatformWarningClick"
                                                AutomationProperties.Name="Review untested system versions"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.DashboardTestedPlatformWarningMessage, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.PlatformCompatibilityWarningTitle, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AttentionIndicator"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                                AutomationProperties.Name="Show warning details"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}">
                                            <Button.Flyout>
                                                <Flyout x:Name="AttentionFlyout"
                                                        Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel MaxWidth="360" Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <Button HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanReapplyChangedSettings, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.ShowReapplyChangedSettings, Mode=OneWay}"
                                                                Click="OnReapplyChangedSettingsClick"
                                                                AutomationProperties.Name="Reapply OpenBlade settings">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}" />
                                                                <TextBlock Text="Reapply OpenBlade settings" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanCheckCurrentState, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.HasUnconfirmedWrites, Mode=OneWay}"
                                                                Click="OnCheckCurrentStateClick"
                                                                AutomationProperties.Name="Check current state">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsCheckCurrentStateOperationInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsCheckCurrentStateOperationInProgress, Mode=OneWay}" />
                                                                <TextBlock Text="Check current state" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="AttentionIndicatorLabel"
                                                           Text="{x:Bind ViewModel.AttentionBadgeLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ActivePerformanceLabel, Mode=OneWay}"
                                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveFanModeLabel, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBatterySettingLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="HeroReadings"
                                        Grid.Row="1"
                                        Margin="0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.LiveReadingsRefreshToolTip, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ShowDashboardLiveReadings, Mode=OneWay}">
                                    <Grid Background="Transparent">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="340"
                                                           Text="{x:Bind ViewModel.LiveReadingsRefreshToolTip, Mode=OneWay}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleDashboardTelemetryGroups, Mode=OneWay}"
                                                       HorizontalAlignment="Stretch">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout Orientation="Horizontal"
                                                                   MinItemWidth="100"
                                                                   MinItemHeight="48"
                                                                   MinColumnSpacing="0"
                                                                   MaximumRowsOrColumns="3"
                                                                   ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:LiveReadingGroupDisplayItem">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                                                   Style="{StaticResource SecondaryTextStyle}" />
                                                        <TextBlock Text="{x:Bind Value, Mode=OneTime}"
                                                                   Style="{StaticResource CardTitleStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>

                        <InfoBar x:Name="OperationErrorInfoBar"
                                 IsOpen="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.OperationFeedbackMessage, Mode=OneWay}"
                                 Severity="Error"
                                 IsClosable="True"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Operation error" />

                        <Border x:Name="DashboardEmptyState"
                                Style="{StaticResource CardStyle}"
                                Padding="22"
                                Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Your Dashboard is empty"
                                           Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Use Customize to add the cards you want to see here."
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <ContentControl x:Name="PowerModeCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardPowerModeCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="FansCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardFansCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="BatteryCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardBatteryCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProfilesPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=ProfilesPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid Margin="0,0,0,20" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Profiles"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="Import profiles"
                                        Click="OnImportProfiles"
                                        ToolTipService.ToolTip="Import saved profiles from JSON"
                                        AutomationProperties.Name="Import profiles from JSON" />
                                <Button Content="Export profiles"
                                        Click="OnExportProfiles"
                                        ToolTipService.ToolTip="Export saved profiles as JSON"
                                        AutomationProperties.Name="Export profiles to JSON" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ProfilesSectionHost">
                        <StackPanel x:Name="ProfilesComparisonSection">
                        <TextBlock Text="These are the settings saved in each profile. A dot marks a value with a pending change; point to it to preview the new value."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,16" />

                        <StackPanel x:Name="ProfilesComparisonLayout">
                            <Grid Margin="16,0,16,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Setting"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="AC" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource ActiveProfilePillStyle}"
                                                Visibility="{x:Bind ViewModel.IsPluggedInProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Style="{StaticResource ActiveProfilePillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Changes pending"
                                               Style="{StaticResource DraftStatusTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsPluggedInProfileDraft, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="USB-C" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource ActiveProfilePillStyle}"
                                                Visibility="{x:Bind ViewModel.IsUsbCProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Style="{StaticResource ActiveProfilePillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Changes pending"
                                               Style="{StaticResource DraftStatusTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsUsbCProfileDraft, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="Battery" Style="{StaticResource CardTitleStyle}" />
                                        <Border Style="{StaticResource ActiveProfilePillStyle}"
                                                Visibility="{x:Bind ViewModel.IsBatteryProfileActive, Mode=OneWay}">
                                            <TextBlock Text="Active"
                                                       Style="{StaticResource ActiveProfilePillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Changes pending"
                                               Style="{StaticResource DraftStatusTextStyle}"
                                               Visibility="{x:Bind ViewModel.IsBatteryProfileDraft, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Power and cooling" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,10" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Power mode" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.PluggedInProfilePresentation.PowerMode, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.UsbCProfilePresentation.PowerMode, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryProfilePresentation.PowerMode, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GPU tuning" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.PluggedInProfilePresentation.GpuTuning, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.UsbCProfilePresentation.GpuTuning, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryProfilePresentation.GpuTuning, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsLastRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fans" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.PluggedInProfilePresentation.Fans, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.UsbCProfilePresentation.Fans, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryProfilePresentation.Fans, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Battery" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Battery protection" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.PluggedInProfilePresentation.BatteryProtection, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.UsbCProfilePresentation.BatteryProtection, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryProfilePresentation.BatteryProtection, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsLastRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Charge limit" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.BatteryPolicyPresentation, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.BatteryPolicyPresentation, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryPolicyPresentation, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Keyboard lighting" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Effect" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.PluggedInProfilePresentation.LightingEffect, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.UsbCProfilePresentation.LightingEffect, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryProfilePresentation.LightingEffect, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" Style="{StaticResource CardTitleStyle}" />
                                            <ContentControl Grid.Column="1" Content="{x:Bind ViewModel.PluggedInProfilePresentation.LightingBrightness, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{x:Bind ViewModel.UsbCProfilePresentation.LightingBrightness, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="3" Content="{x:Bind ViewModel.BatteryProfilePresentation.LightingBrightness, Mode=OneWay}" ContentTemplate="{StaticResource ProfileValuePresentationTemplate}" HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Color" Style="{StaticResource CardTitleStyle}" />
