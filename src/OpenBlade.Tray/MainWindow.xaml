<Window
    x:Class="OpenBlade.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <x:Double x:Key="DashboardSingleLineRowContentMinHeight">40</x:Double>
            <Thickness x:Key="DashboardSingleLineRowPadding">16,4</Thickness>
            <Thickness x:Key="DashboardWrappedTitleRowPadding">16,14</Thickness>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <local:RgbColorConverter x:Key="RgbColor" />

            <Style x:Key="PageTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource AppPageTitleTextStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="PageHeaderTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource PageTitleStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionHeaderStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource AppSectionTitleTextStyle}">
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="SettingsGroupStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="local:SettingsCardPointerVisual.IsEnabled" Value="True" />
                <Setter Property="local:SettingsCardPointerVisual.PointerOverBackground"
                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SettingsLastRowStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsRowStyle}">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Expanders let their headers and child rows own pointer feedback. -->
            <Style x:Key="SettingsExpanderRowStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsRowStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="local:SettingsCardPointerVisual.IsEnabled" Value="False" />
            </Style>
            <Style x:Key="SettingsLastExpanderRowStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsLastRowStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="local:SettingsCardPointerVisual.IsEnabled" Value="False" />
            </Style>
            <Style x:Key="SettingsSubcardBaseStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="SettingsEmphasizedSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsSubcardBaseStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SettingsLastEmphasizedSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsEmphasizedSubcardStyle}">
                <Setter Property="CornerRadius" Value="0,0,8,8" />
            </Style>
            <Style x:Key="SettingsNeutralSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsSubcardBaseStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="local:SettingsCardPointerVisual.IsEnabled" Value="True" />
                <Setter Property="local:SettingsCardPointerVisual.PointerOverBackground"
                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SettingsLastNeutralSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsNeutralSubcardStyle}">
                <Setter Property="CornerRadius" Value="0,0,8,8" />
            </Style>
            <Style x:Key="SettingsEditorSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsSubcardBaseStyle}">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="SettingsLastEditorSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsEditorSubcardStyle}">
                <Setter Property="CornerRadius" Value="0,0,8,8" />
            </Style>
            <Style x:Key="InlineCardSliderStyle"
                   TargetType="Slider"
                   BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CompactCardToggleSwitchStyle"
                   TargetType="ToggleSwitch"
                   BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="OnContent" Value="" />
            </Style>
            <Style x:Key="InlineCardSliderValueStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CardTitleStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusPillButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusPillTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="ActiveProfilePillStyle" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="ActiveProfilePillTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="CardContentExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SettingsExpanderHeaderStyle" TargetType="Border">
                <Setter Property="Margin" Value="-16,0,-60,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="local:SettingsCardPointerVisual.IsEnabled" Value="True" />
                <Setter Property="local:SettingsCardPointerVisual.PointerOverBackground"
                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground"
                             Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderChevronPressedBackground"
                             Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderChevronBorderPointerOverBrush"
                             Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderChevronBorderPressedBrush"
                             Color="Transparent" />
            <Style x:Key="TroubleshootingSectionStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,11" />
            </Style>
            <Style x:Key="TroubleshootingLabelStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TroubleshootingValueStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CardTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource AppBodyStrongTextStyle}" />
            <Style x:Key="SecondaryTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource AppBodyTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DraftStatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <DataTemplate x:Key="PageHeaderButtonContentTemplate">
                <TextBlock Text="{Binding}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </DataTemplate>
            <Style x:Key="ProfileSaveButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="ContentTemplate" Value="{StaticResource PageHeaderButtonContentTemplate}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PageHeaderSecondaryButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="ContentTemplate" Value="{StaticResource PageHeaderButtonContentTemplate}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <ControlTemplate x:Key="CardActionButtonTemplate"
                             TargetType="Button">
                <Border x:Name="CardActionBackground"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="CardActionBackground.Background"
                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="CardActionBackground.Background"
                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="CardActionBackground.Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="CardActionHyperlinkButtonTemplate"
                             TargetType="HyperlinkButton">
                <Border x:Name="CardActionBackground"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="CardActionBackground.Background"
                                            Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="CardActionBackground.Background"
                                            Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="CardActionBackground.Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Border>
            </ControlTemplate>
            <Style x:Key="ExternalLinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template"
                        Value="{StaticResource CardActionHyperlinkButtonTemplate}" />
            </Style>
            <Style x:Key="IconActionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template"
                        Value="{StaticResource CardActionButtonTemplate}" />
            </Style>
            <Style x:Key="CardActionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{ThemeResource ExpanderChevronGlyphSize}" />
            </Style>
            <Style x:Key="DestructiveButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="UnsavedNavigationBadgeStyle" TargetType="InfoBadge">
                <Setter Property="Value" Value="-1" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <!-- Keep Run and InlineUIContainer adjacent in both templates; whitespace between them renders as an extra gap. -->
            <DataTemplate x:Key="ProfileValuePresentationTemplate"
                          x:DataType="local:ProfileValuePresentation">
                <ContentControl HorizontalContentAlignment="Stretch"
                                IsTabStop="{x:Bind IsPending, Mode=OneTime}"
                                ToolTipService.ToolTip="{x:Bind PendingDescription, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind AccessibilityDescription, Mode=OneTime}"
                                AutomationProperties.HelpText="{x:Bind PendingDescription, Mode=OneTime}">
                    <RichTextBlock TextWrapping="Wrap"
                                   IsTextSelectionEnabled="False"
                                   AutomationProperties.AccessibilityView="Raw">
                        <Paragraph><Run Text="{x:Bind Text, Mode=OneTime}" /><InlineUIContainer>
                            <InfoBadge Margin="6,0,0,0"
                                       Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                       Visibility="{x:Bind IsPending, Mode=OneTime}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </InlineUIContainer></Paragraph>
                    </RichTextBlock>
                </ContentControl>
            </DataTemplate>
            <DataTemplate x:Key="CompactProfileValuePresentationTemplate"
                          x:DataType="local:ProfileValuePresentation">
                <ContentControl HorizontalContentAlignment="Stretch"
                                IsTabStop="{x:Bind IsPending, Mode=OneTime}"
                                ToolTipService.ToolTip="{x:Bind PendingDescription, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind AccessibilityDescription, Mode=OneTime}"
                                AutomationProperties.HelpText="{x:Bind PendingDescription, Mode=OneTime}">
                    <RichTextBlock TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   IsTextSelectionEnabled="False"
                                   AutomationProperties.AccessibilityView="Raw">
                        <Paragraph><Run Text="{x:Bind Text, Mode=OneTime}" /><InlineUIContainer>
                            <InfoBadge Margin="6,0,0,0"
                                       Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                       Visibility="{x:Bind IsPending, Mode=OneTime}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </InlineUIContainer></Paragraph>
                    </RichTextBlock>
                </ContentControl>
            </DataTemplate>
            <Style x:Key="FirmwareProgressRingStyle" TargetType="ProgressRing">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="IsIndeterminate" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="FanCurveItemContainerStyle" TargetType="ContentPresenter">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="DashboardReorderListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="58" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SettingsReorderListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <DataTemplate x:Key="DashboardCardOptionTemplate"
                          x:DataType="local:DashboardCardOption">
                <Grid ColumnSpacing="10"
                      Padding="2,6,8,6"
                      MinWidth="580"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              IsChecked="{x:Bind IsPinned, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TrayDashboardControlOptionTemplate"
                          x:DataType="local:TrayDashboardControlOption">
                <Grid ColumnSpacing="10"
                      Padding="16,10"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Padding="8"
                            MinWidth="0"
                            Click="OnRemoveTrayDashboardControl"
                            AutomationProperties.Name="{x:Bind Label, Mode=OneTime}">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TrayDashboardStatusItemOptionTemplate"
                          x:DataType="local:TrayDashboardStatusItemOption">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1"
                                      Style="{StaticResource CompactCardToggleSwitchStyle}"
                                      IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="TrayDashboardSliderOptionTemplate"
                          x:DataType="local:TrayDashboardSliderOption">
                <Grid ColumnSpacing="10"
                      Padding="16,10"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Label, Mode=OneTime}"
                               Style="{StaticResource CardTitleStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Padding="8"
                            MinWidth="0"
                            Click="OnRemoveTrayDashboardSlider"
                            AutomationProperties.Name="{x:Bind Label, Mode=OneTime}">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="PageSectionOptionTemplate"
                          x:DataType="local:PageSectionOption">
                <Grid ColumnSpacing="10"
                      Padding="2,6,8,6"
                      MinWidth="580"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="NavigationItemOptionTemplate"
                          x:DataType="local:PrimaryNavigationItemOption">
                <Grid ColumnSpacing="12"
                      Padding="6,4"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Label, Mode=OneTime}"
                               Style="{StaticResource CardTitleStyle}"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DashboardPowerModeCardTemplate" x:DataType="local:MainViewModel">
                        <StackPanel>
                        <TextBlock local:CardReorder.IsHeader="True" x:Uid="MainWindow_TextBlockPerformance" Text="Performance"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel local:CardReorder.GroupId="DashboardPerformanceSelectorRows">
                            <Border local:CardReorder.CardId="DashboardPerformanceSelector" Style="{StaticResource SettingsRowStyle}"
                                    Padding="{StaticResource DashboardSingleLineRowPadding}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsPerformanceVisible}">
                                <StackPanel>
                                    <Grid MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}"
                                          ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center"
                                                    SizeChanged="OnDashboardTextStackSizeChanged">
                                            <TextBlock x:Uid="MainWindow_TextBlockLaptopPerformance" Text="Laptop performance"
                                                       Style="{StaticResource CardTitleStyle}" />
