                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8"
                                                  Visibility="{x:Bind ViewModel.HasTrayHoverLabelOverflow, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind ViewModel.TrayHoverLabelOverflowMessage, Mode=OneWay}"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            </StackPanel>
                        </Border>
                        </StackPanel>

