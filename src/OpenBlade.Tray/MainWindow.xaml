<Window
    x:Class="OpenBlade.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <local:RgbColorConverter x:Key="RgbColor" />

            <Style x:Key="PageTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="PageHeaderTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource PageTitleStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionHeaderStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="SettingsGroupStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="SettingsLastRowStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsRowStyle}">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SettingsSubcardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="SettingsLastSubcardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource SettingsSubcardStyle}">
                <Setter Property="CornerRadius" Value="0,0,8,8" />
            </Style>
            <Style x:Key="SettingsPickerStyle"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusPillButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusPillTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="ActiveProfilePillStyle" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="ActiveProfilePillTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="CardContentExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="TroubleshootingSectionStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,11" />
            </Style>
            <Style x:Key="TroubleshootingLabelStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TroubleshootingValueStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TroubleshootingStatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CardTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="SecondaryTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ProfileSaveStatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource SecondaryTextStyle}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DraftStatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ProfileSaveButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ExternalLinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="IconActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="ProfileSaveOverflowButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource IconActionButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>
            <Style x:Key="DestructiveButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="UnsavedNavigationBadgeStyle" TargetType="InfoBadge">
                <Setter Property="Value" Value="-1" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="FirmwareProgressRingStyle" TargetType="ProgressRing">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="IsIndeterminate" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="FanCurveItemContainerStyle" TargetType="ContentPresenter">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="DashboardReorderListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="58" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="SettingsReorderListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <DataTemplate x:Key="DashboardCardOptionTemplate"
                          x:DataType="local:DashboardCardOption">
                <Grid ColumnSpacing="10"
                      Padding="2,6,8,6"
                      MinWidth="580"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Label, Mode=OneTime}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              IsChecked="{x:Bind IsPinned, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="NavigationItemOptionTemplate"
                          x:DataType="local:PrimaryNavigationItemOption">
                <Grid ColumnSpacing="12"
                      Padding="6,4"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Label, Mode=OneTime}"
                               Style="{StaticResource CardTitleStyle}"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DashboardPowerModeCardTemplate" x:DataType="local:MainViewModel">
                        <StackPanel>
                        <TextBlock Text="Power mode"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsLastRowStyle}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsPerformanceVisible}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Power mode" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Balance speed, power use, and noise."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <ProgressRing Style="{StaticResource FirmwareProgressRingStyle}"
                                                      IsActive="{Binding IsPerformanceOperationInProgress}"
                                                      AutomationProperties.Name="Applying power mode" />
                                        <ComboBox x:Name="DashboardPerformanceSelector"
                                                  MinWidth="150"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Power mode"
                                                  IsEnabled="{Binding CanRequestHardwareControl}"
                                                  ItemsSource="{Binding AvailableActivePerformanceOptions}"
                                                  SelectedItem="{Binding SelectedPerformanceOption}"
                                                  SelectionChanged="OnDashboardPerformanceChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsSubcardStyle}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsCustomPerformanceVisible}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="CPU" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose the processor power level for Custom mode."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="DashboardCustomCpuSelector"
                                              Grid.Column="1"
                                              MinWidth="150"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Custom CPU level"
                                              IsEnabled="{Binding CanRequestHardwareControl}"
                                              ItemsSource="{Binding AvailableCustomCpuLevels}"
                                              SelectedItem="{Binding SelectedCustomCpuLevel}"
                                              SelectionChanged="OnDashboardCustomCpuChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsSubcardStyle}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsCustomPerformanceVisible}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="GPU" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose the graphics power level for Custom mode."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="DashboardCustomGpuSelector"
                                              Grid.Column="1"
                                              MinWidth="150"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="Custom GPU level"
                                              IsEnabled="{Binding CanRequestHardwareControl}"
                                              ItemsSource="{Binding AvailableCustomGpuLevels}"
                                              SelectedItem="{Binding SelectedCustomGpuLevel}"
                                              SelectionChanged="OnDashboardCustomGpuChanged" />
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DashboardFansCardTemplate" x:DataType="local:MainViewModel">
                        <StackPanel>
                        <TextBlock Text="Fans"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsLastRowStyle}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsFanControlVisible}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Fans" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Automatic is recommended for everyday use."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <ProgressRing Width="16"
                                                      Height="16"
                                                      IsActive="{Binding IsFanControlOperationInProgress}"
                                                      Visibility="Collapsed"
                                                      local:AnimatedVisibility.IsVisible="{Binding IsFanControlOperationInProgress}"
                                                      AutomationProperties.Name="Applying fan mode" />
                                        <ComboBox x:Name="DashboardFanModeSelector"
                                                  MinWidth="150"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="Fan mode"
                                                  IsEnabled="{Binding CanEditFanControl}"
                                                  ItemsSource="{Binding AvailableActiveFanModeOptions}"
                                                  SelectedItem="{Binding SelectedFanModeOption}"
                                                  SelectionChanged="OnDashboardFanModeSelectionChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsLastSubcardStyle}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsFixedFanSpeedVisible}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Fan speed" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Set both fans to a fixed speed."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock HorizontalAlignment="Right"
                                                   Style="{StaticResource CardTitleStyle}">
                                            <Run Text="{Binding FixedFanSpeedRpm}" />
                                            <Run Text=" RPM" />
                                        </TextBlock>
                                        <Slider x:Name="FixedFanSpeedSlider"
                                                Minimum="2000"
                                                Maximum="5400"
                                                StepFrequency="100"
                                                SmallChange="100"
                                                LargeChange="500"
                                                SnapsTo="StepValues"
                                                IsThumbToolTipEnabled="True"
                                                IsEnabled="{Binding CanEditFanControl}"
                                                AutomationProperties.Name="Fixed fan speed"
                                                Value="{Binding FixedFanSpeedRpm, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                                PointerCaptureLost="OnFixedFanSpeedCommit"
                                                KeyUp="OnFixedFanSpeedKeyUp" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsLastSubcardStyle}"
                                    Visibility="Collapsed"
                                    local:AnimatedVisibility.IsVisible="{Binding IsManualFanCurveVisible}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Use the hotter sensor for both fans"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Keeps both fans together when either processor is hot."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      MinWidth="0"
                                                      OffContent=""
                                                      OnContent=""
                                                      HorizontalAlignment="Right"
                                                      IsEnabled="{Binding CanEditFanControl}"
                                                      IsOn="{Binding UseHigherFanTemperature, Mode=TwoWay}"
                                                      Toggled="OnManualFanCurveSettingChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Expander Header="CPU curve"
                                                  IsExpanded="True"
                                                  HorizontalContentAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding CpuFanCurveEditorPoints}"
                                                          HorizontalContentAlignment="Stretch"
                                                          IsEnabled="{Binding CanEditFanControl}"
                                                          ItemContainerStyle="{StaticResource FanCurveItemContainerStyle}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:FanCurveEditorPoint">
                                                        <Grid ColumnSpacing="10"
                                                              Margin="0,5"
                                                              HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="78" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind TemperatureLabel, Mode=OneTime}" VerticalAlignment="Center" />
                                                            <Slider Grid.Column="1"
                                                                    MinWidth="120"
                                                                    Minimum="2000" Maximum="5400"
                                                                    StepFrequency="100" SnapsTo="StepValues"
                                                                    Tag="{x:Bind Mode=OneTime}"
                                                                    Value="{Binding SpeedRpm, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                                                    PointerCaptureLost="OnFanCurvePointCommit"
                                                                    KeyUp="OnFanCurvePointKeyUp" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SpeedLabel}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        <Expander Grid.Column="1"
                                                  Header="GPU curve"
                                                  IsExpanded="True"
                                                  HorizontalContentAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding GpuFanCurveEditorPoints}"
                                                          HorizontalContentAlignment="Stretch"
                                                          IsEnabled="{Binding CanEditFanControl}"
                                                          ItemContainerStyle="{StaticResource FanCurveItemContainerStyle}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:FanCurveEditorPoint">
                                                        <Grid ColumnSpacing="10"
                                                              Margin="0,5"
                                                              HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="78" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind TemperatureLabel, Mode=OneTime}" VerticalAlignment="Center" />
                                                            <Slider Grid.Column="1"
                                                                    MinWidth="120"
                                                                    Minimum="2000" Maximum="5400"
                                                                    StepFrequency="100" SnapsTo="StepValues"
                                                                    Tag="{x:Bind Mode=OneTime}"
                                                                    Value="{Binding SpeedRpm, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                                                    PointerCaptureLost="OnFanCurvePointCommit"
                                                                    KeyUp="OnFanCurvePointKeyUp" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SpeedLabel}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Grid>
                                    <TextBlock Text="OpenBlade uses the laptop firmware temperature and NVIDIA GPU temperature. If either reading is unavailable, it uses maximum fan speed."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DashboardBatteryCardTemplate" x:DataType="local:MainViewModel">
                        <StackPanel>
                        <TextBlock Text="Battery"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Battery protection" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Limit charging to help preserve battery health."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ProgressRing Style="{StaticResource FirmwareProgressRingStyle}"
                                                      IsActive="{Binding IsBatteryProtectionOperationInProgress}"
                                                      AutomationProperties.Name="Applying battery protection" />
                                        <ToggleSwitch x:Name="BatteryProtectionToggle"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Battery protection"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsEnabled="{Binding CanChangeBatteryProtection}"
                                                      IsOn="{Binding BatteryProtectionEnabled}"
                                                      Toggled="OnBatteryProtectionToggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Charge limit" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose the maximum charge level while protection is on."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="4"
                                                HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <ProgressRing Style="{StaticResource FirmwareProgressRingStyle}"
                                                          IsActive="{Binding IsChargeLimitOperationInProgress}"
                                                          AutomationProperties.Name="Applying charge limit" />
                                            <TextBlock Text="{Binding ChargeLimitPercent}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="%" Style="{StaticResource CardTitleStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="DashboardChargeLimitSlider"
                                                HorizontalAlignment="Stretch"
                                                Minimum="50"
                                                Maximum="80"
                                                StepFrequency="5"
                                                SmallChange="5"
                                                LargeChange="5"
                                                SnapsTo="StepValues"
