                                                                    SelectedItem="{x:Bind ViewModel.SelectedLanguageOption, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border local:CardReorder.CardId="MainWindow_TextBlockAppAccentColor" Style="{StaticResource SettingsRowStyle}">
