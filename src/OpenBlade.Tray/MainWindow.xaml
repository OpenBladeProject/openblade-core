                                                    HorizontalAlignment="Left"
                                                    Click="OnResetNavigationOrder" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </Border>
                            <Expander x:Name="TaskbarHoverLabelExpander"
                                      Style="{StaticResource CardContentExpanderStyle}"
                                      IsExpanded="False"
                                      AutomationProperties.Name="Taskbar hover label settings">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                </Expander.Resources>
                                <Expander.Header>
                                    <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                        <StackPanel Spacing="3" Margin="16,14,60,14">
                                            <TextBlock Text="Taskbar hover label" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Choose whether to show the app name, profile, and live details when you point at the tray icon."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Expander.Header>
                                <Border Style="{StaticResource SettingsLastSubcardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Check items to include. Drag them into the order you want."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <ListView ItemsSource="{x:Bind ViewModel.TrayHoverLabelItems, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  CanDragItems="True"
                                                  CanReorderItems="True"
                                                  ReorderMode="Enabled"
                                                  AllowDrop="True"
                                                  ItemContainerStyle="{StaticResource SettingsReorderListItemStyle}"
                                                  AutomationProperties.Name="Taskbar hover label contents">
