                <ScrollViewer x:Name="LaptopPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LaptopPageContent"
                                Padding="28,20,28,28"
                                Width="{Binding ElementName=LaptopPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="LaptopPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16"
                              RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="LaptopHeaderWide">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="900" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="LaptopHeaderActions.(Grid.Row)" Value="0" />
                                            <Setter Target="LaptopHeaderActions.(Grid.Column)" Value="1" />
                                            <Setter Target="LaptopHeaderActions.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="LaptopHeaderActions.HorizontalAlignment" Value="Right" />
                                            <Setter Target="LaptopHeaderActions.Margin" Value="0,2,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="LaptopHeaderCompact">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="LaptopHeaderActions.(Grid.Row)" Value="1" />
                                            <Setter Target="LaptopHeaderActions.(Grid.Column)" Value="0" />
                                            <Setter Target="LaptopHeaderActions.(Grid.ColumnSpan)" Value="2" />
                                            <Setter Target="LaptopHeaderActions.HorizontalAlignment" Value="Left" />
                                            <Setter Target="LaptopHeaderActions.Margin" Value="0,2,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock x:Uid="MainWindow_TextBlockLaptop" Text="Laptop"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                            <StackPanel x:Name="LaptopHeaderActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                            <StackPanel x:Name="LaptopProfileSaveActions"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.HasLaptopPageProfileActionOpportunity, Mode=OneWay}">
                                <Button Content="{x:Bind ViewModel.SaveToActiveProfileLabel, Mode=OneWay}"
                                        Style="{StaticResource ProfileSaveButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasLaptopPageProfileSaveOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SaveLaptopProfileDraftCommand}" />
                                <Button x:Uid="MainWindow_ButtonUseProfileSettings2" Content="Use profile settings"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasLaptopPageProfileDifference, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.DiscardLaptopProfileDraftCommand}" />
                            </StackPanel>
                            <Button x:Uid="MainWindow_ButtonCustomize2" Content="Customize"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    Tag="Laptop"
                                    Click="OnCustomizePageSections"
                                    AutomationProperties.Name="Customize Laptop page" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="LaptopCardsHost" Spacing="18">
                        <ContentControl x:Name="KeyboardBehaviorCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardKeyboardBehaviorCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="StartupAnimationCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardStartupAnimationCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

