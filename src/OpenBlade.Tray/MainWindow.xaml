                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        Click="OnStartTelemetryRecording">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7C8;" Style="{StaticResource AppToolbarIconStyle}" />
                                        <TextBlock x:Name="TelemetryRecordLabel" Grid.Column="1"
                                                   Style="{StaticResource AppBodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                                <Button x:Name="TelemetryStopButton"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        Click="OnStopTelemetryRecording">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE71A;" Style="{StaticResource AppToolbarIconStyle}" />
                                        <TextBlock x:Name="TelemetryStopLabel" Grid.Column="1"
                                                   Style="{StaticResource AppBodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                                <Button x:Name="TelemetryLiveButton"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        Click="OnCloseTelemetryReplay">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE72B;" Style="{StaticResource AppToolbarIconStyle}" />
                                        <TextBlock x:Name="TelemetryLiveLabel" Grid.Column="1"
                                                   Style="{StaticResource AppBodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                                <Button x:Name="TelemetryOpenButton"
                                        Style="{StaticResource AppToolbarButtonStyle}"
                                        Click="OnOpenTelemetryReplay">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8E5;" Style="{StaticResource AppToolbarIconStyle}" />
                                        <TextBlock x:Name="TelemetryOpenLabel" Grid.Column="1"
                                                   Style="{StaticResource AppBodyTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </local:ContentWrapPanel>
                        </local:ContextualToolbar>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Border Style="{StaticResource SettingsEditorSubcardStyle}">
                                <local:TelemetryChart x:Name="TelemetryPlot" PlotStroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      GridStroke="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Border>
                        </Border>
                        <TextBlock Text="{CustomResource Telemetry_EventsTitle.Text}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="TelemetryEventsText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Expander x:Name="BatteryHistorySection" Header="{CustomResource BatteryHistory_Report.Header}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{CustomResource BatteryHistory_Description.Text}"
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <local:ContentWrapPanel>
                                    <Button x:Name="BatteryHistoryLoadButton" Click="OnLoadBatteryHistory" Style="{StaticResource AppToolbarButtonStyle}">
                                        <TextBlock Text="{CustomResource BatteryHistory_LoadLabel.Text}" TextWrapping="Wrap" Style="{StaticResource AppBodyTextStyle}" />
                                    </Button>
                                    <ProgressRing x:Name="BatteryHistoryProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                                </local:ContentWrapPanel>
                                <TextBlock x:Name="BatteryHistoryError" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                <StackPanel x:Name="BatteryHistoryReportBody" Spacing="12" Visibility="Collapsed">
                                    <TextBlock x:Name="BatteryHistorySummary" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{CustomResource BatteryHistory_PowerSource.Text}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                        <local:BatteryTimeline x:Name="BatteryHistoryTimeline"
                                                               AccentStroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               UnknownStroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                               SegmentBackground="{ThemeResource ControlFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="BatteryHealthText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    <Expander x:Name="BatteryHistoryDetails" Header="{CustomResource BatteryHistory_Details.Header}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                        <ListView x:Name="BatteryHistoryRows" MaxHeight="280" SelectionMode="None"
                                                  AutomationProperties.Name="{CustomResource MainWindow_BatteryHistoryRowsText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" Style="{StaticResource SecondaryTextStyle}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CoolingPadPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=CoolingPadPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel x:Name="CoolingPadSection" Visibility="{x:Bind ViewModel.CoolingPad.IsVisible, Mode=OneWay}">
                            <TextBlock x:Name="CoolingPadHeading" Text="{CustomResource MainWindow_CoolingPadHeadingText.Text}" Style="{StaticResource PageTitleStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsLastRowStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="CoolingPadExperimental" Text="{CustomResource MainWindow_CoolingPadExperimentalText.Text}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.CoolingPad.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="{x:Bind ViewModel.CoolingPad.ConfiguredTargetText, Mode=OneWay}" Style="{StaticResource AppDataTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.CoolingPad.ConfiguredLightingText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CoolingPadFanRow" Style="{StaticResource SettingsNeutralSubcardStyle}" Padding="{StaticResource DashboardSingleLineRowPadding}">
                                        <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CoolingPadFanLabel" Text="{CustomResource MainWindow_CoolingPadFanLabelText.Text}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                            <local:ResponsiveChoiceSelector x:Name="CoolingPadFanSelector" Grid.Column="1"
                                                                            CompactMinWidth="150" ExpandedMinWindowWidth="800"
                                                                            AccessibleName="{CustomResource MainWindow_CoolingPadFanSelectorText.AccessibleName}"
                                                                            ItemsSource="{x:Bind ViewModel.CoolingPad.FanModes}" DisplayMemberPath="Label"
                                                                            SelectedItem="{x:Bind ViewModel.CoolingPad.FanMode, Mode=TwoWay}"
                                                                            IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsEditorSubcardStyle}" Visibility="{x:Bind ViewModel.CoolingPad.ShowFixedSpeed, Mode=OneWay}">
                                        <NumberBox x:Name="CoolingPadFixedRpm" Header="{CustomResource MainWindow_CoolingPadFixedRpmText.Header}" Minimum="500" Maximum="3200" SmallChange="50" LargeChange="500" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CoolingPad.FixedRpm, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}" />
                                    </Border>
                                    <Border x:Name="CoolingPadDemandRow" Style="{StaticResource SettingsNeutralSubcardStyle}"
                                            Padding="{StaticResource DashboardSingleLineRowPadding}"
                                            Visibility="{x:Bind ViewModel.CoolingPad.ShowDemandApiOption, Mode=OneWay}">
                                        <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CoolingPadDemandLabel" Text="{CustomResource MainWindow_CoolingPadDemandLabelText.Text}"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                            <ToggleSwitch x:Name="CoolingPadDemandToggle" Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ViewModel.CoolingPad.AllowDemandApi, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.CoolingPad.CanApply, Mode=OneWay}"
                                                          AutomationProperties.Name="{CustomResource MainWindow_CoolingPadDemandToggleText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsEditorSubcardStyle}" Visibility="{x:Bind ViewModel.CoolingPad.ShowCurves, Mode=OneWay}">
                                        <Expander x:Name="CoolingPadCurves" Header="{CustomResource MainWindow_CoolingPadCurvesText.Header}" Style="{StaticResource CardContentExpanderStyle}" IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}">
                                            <StackPanel Spacing="12">
                                                <TextBlock x:Name="CoolingPadCurveHelp" Text="{CustomResource MainWindow_CoolingPadCurveHelpText.Text}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                <StackPanel Spacing="6">
                                                    <TextBlock x:Name="CoolingPadTemperatureSourceLabel" Text="{CustomResource MainWindow_CoolingPadTemperatureSourceLabel.Text}" Style="{StaticResource AppBodyTextStyle}" />
                                                    <local:ResponsiveChoiceSelector x:Name="CoolingPadTemperatureSource" HorizontalAlignment="Left"
                                                                                    CompactMinWidth="150" ExpandedMinWindowWidth="800"
                                                                                    AccessibleName="{CustomResource MainWindow_CoolingPadTemperatureSourceText.AccessibleName}"
                                                                                    ItemsSource="{x:Bind ViewModel.CoolingPad.TemperatureSources}" DisplayMemberPath="Label"
                                                                                    SelectedItem="{x:Bind ViewModel.CoolingPad.TemperatureSource, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CoolingPad.ShowCpuCurve, Mode=OneWay}">
                                                <TextBlock x:Name="CoolingPadCpuCurve" Text="{CustomResource MainWindow_CoolingPadCpuCurveText.Text}" Style="{StaticResource CardTitleStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CoolingPad.CpuCurve, Mode=OneWay}" ItemTemplate="{StaticResource CoolingPadCurvePointTemplate}" />
                                                </StackPanel>
                                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CoolingPad.ShowGpuCurve, Mode=OneWay}">
                                                <TextBlock x:Name="CoolingPadGpuCurve" Text="{CustomResource MainWindow_CoolingPadGpuCurveText.Text}" Style="{StaticResource CardTitleStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CoolingPad.GpuCurve, Mode=OneWay}" ItemTemplate="{StaticResource CoolingPadCurvePointTemplate}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <Border Style="{StaticResource SettingsNeutralSubcardStyle}" Padding="{StaticResource DashboardSingleLineRowPadding}">
                                        <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="CoolingPadLightingLabel" Text="{CustomResource MainWindow_CoolingPadLightingLabelText.Text}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                            <local:ResponsiveChoiceSelector x:Name="CoolingPadLightingSelector" Grid.Column="1"
                                                                            CompactMinWidth="150" ExpandedMinWindowWidth="800"
                                                                            AccessibleName="{CustomResource MainWindow_CoolingPadLightingSelectorText.AccessibleName}"
                                                                            ItemsSource="{x:Bind ViewModel.CoolingPad.LightingModes}" DisplayMemberPath="Label"
                                                                            SelectedItem="{x:Bind ViewModel.CoolingPad.LightingMode, Mode=TwoWay}"
                                                                            IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsEditorSubcardStyle}">
                                        <StackPanel Spacing="12">
                                            <NumberBox x:Name="CoolingPadBrightness" IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}" Header="{CustomResource MainWindow_CoolingPadBrightnessText.Header}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.CoolingPad.Brightness, Mode=TwoWay}" />
                                            <TextBox x:Name="CoolingPadPrimaryColor" IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}" Header="{CustomResource MainWindow_CoolingPadPrimaryColorText.Header}" Text="{x:Bind ViewModel.CoolingPad.PrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Visibility="{x:Bind ViewModel.CoolingPad.ShowPrimaryColor, Mode=OneWay}" />
                                            <TextBox x:Name="CoolingPadSecondaryColor" IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}" Header="{CustomResource MainWindow_CoolingPadSecondaryColorText.Header}" Text="{x:Bind ViewModel.CoolingPad.SecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Visibility="{x:Bind ViewModel.CoolingPad.ShowSecondaryColor, Mode=OneWay}" />
                                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.CoolingPad.ShowWaveDirection, Mode=OneWay}">
                                                <TextBlock x:Name="CoolingPadWaveDirectionLabel" Text="{CustomResource MainWindow_CoolingPadWaveDirectionLabel.Text}" Style="{StaticResource AppBodyTextStyle}" />
                                                <local:ResponsiveChoiceSelector x:Name="CoolingPadWaveDirection" HorizontalAlignment="Left"
                                                                                CompactMinWidth="150" ExpandedMinWindowWidth="800"
                                                                                AccessibleName="{CustomResource MainWindow_CoolingPadWaveDirectionText.AccessibleName}"
                                                                                IsEnabled="{x:Bind ViewModel.CoolingPad.CanEdit, Mode=OneWay}"
                                                                                ItemsSource="{x:Bind ViewModel.CoolingPad.WaveDirections}" DisplayMemberPath="Label"
                                                                                SelectedItem="{x:Bind ViewModel.CoolingPad.WaveDirection, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SettingsLastEditorSubcardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="CoolingPadApplyHelp" Text="{CustomResource MainWindow_CoolingPadApplyHelpText.Text}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            <local:ContentWrapPanel>
                                                <Button x:Name="CoolingPadApply" Content="{CustomResource MainWindow_CoolingPadApplyText.Content}" Style="{StaticResource AppCommandButtonStyle}" Command="{x:Bind ViewModel.CoolingPad.ApplyCommand}" />
                                                <Button x:Name="CoolingPadRelease" Content="{CustomResource MainWindow_CoolingPadReleaseText.Content}" Style="{StaticResource AppCommandButtonStyle}" Command="{x:Bind ViewModel.CoolingPad.ReleaseCommand}" />
                                                <Button x:Name="CoolingPadRefresh" Content="{CustomResource MainWindow_CoolingPadRefreshText.Content}" Style="{StaticResource AppCommandButtonStyle}" Command="{x:Bind ViewModel.CoolingPad.RefreshCommand}" />
                                            </local:ContentWrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LaptopPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LaptopPageContent"
                                Padding="28,20,28,28"
                                Width="{Binding ElementName=LaptopPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <local:ResponsivePageHeader x:Name="LaptopPageHeader"
                                                    Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{CustomResource MainWindow_TextBlockLaptop.Text}"
                                       Style="{StaticResource PageHeaderTitleStyle}"
                                       local:ResponsivePageHeader.Role="Title" />
                            <StackPanel x:Name="LaptopHeaderActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.HasLaptopPageProfileActionOpportunity, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        local:ResponsivePageHeader.Role="ProfileActions">
                                <Button Content="{x:Bind ViewModel.SaveToActiveProfileLabel, Mode=OneWay}"
                                        Style="{StaticResource ProfileSaveButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasLaptopPageProfileSaveOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SaveLaptopProfileDraftCommand}" />
                                <Button Content="{CustomResource MainWindow_ButtonUseProfileSettings2.Content}"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasLaptopPageProfileDifference, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.DiscardLaptopProfileDraftCommand}" />
                            </StackPanel>
                            <Button
                                    Grid.Column="2"
                                    Content="{CustomResource MainWindow_ButtonCustomize2.Content}"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    Tag="Laptop"
                                    Click="OnCustomizePageSections"
                                    AutomationProperties.Name="{CustomResource MainWindow_ButtonCustomize2.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                    local:ResponsivePageHeader.Role="Customize" />
                        </local:ResponsivePageHeader>

                        <StackPanel x:Name="LaptopCardsHost" Spacing="18">
                        <ContentControl x:Name="PowerModeCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardPowerModeCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="FansCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardFansCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="BatteryCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardBatteryCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <StackPanel x:Name="KeyboardSection">
                            <TextBlock local:CardReorder.IsHeader="True" x:Name="KeyboardHeader"
                                       Text="{CustomResource SnapTap_KeyboardHeader.Text}" Style="{StaticResource SectionHeaderStyle}" />
                            <Border x:Name="SnapTapCard" Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel local:CardReorder.GroupId="SnapTapCardRows">
                                    <ContentControl local:CardReorder.CardId="KeyboardBehaviorCard" x:Name="KeyboardBehaviorCard"
                                                    Content="{x:Bind ViewModel}"
                                                    ContentTemplate="{StaticResource KeyboardBehaviorRowsTemplate}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Visibility="{x:Bind ViewModel.HasKeyboardLaptopControls, Mode=OneWay}" />
                                    <Border local:CardReorder.CardId="TouchpadRow" x:Name="TouchpadRow" Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{CustomResource Touchpad_Title.Text}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="{x:Bind TouchpadViewModel.Description, Mode=OneWay}"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="TouchpadToggle"
                                                          Grid.Column="1" VerticalAlignment="Center"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          AutomationProperties.Name="{CustomResource Touchpad_Toggle.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                          IsOn="{x:Bind TouchpadViewModel.IsOn, Mode=OneWay}"
                                                          IsEnabled="{x:Bind TouchpadViewModel.CanEdit, Mode=OneWay}"
                                                          Toggled="OnTouchpadToggled" />
                                        </Grid>
                                    </Border>
                                    <Border local:CardReorder.CardId="SnapTapRow" x:Name="SnapTapRow" Style="{StaticResource SettingsLastExpanderRowStyle}">
                                        <Expander x:Name="SnapTapExpander"
                                                  Style="{StaticResource CardContentExpanderStyle}"
                                                  IsExpanded="False" AutomationProperties.Name="{CustomResource KeyboardBackend_SnapTapExpander.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                            <Expander.Resources>
                                                <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                                <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                            </Expander.Resources>
                                            <Expander.Header>
                                                <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                                    <Grid ColumnSpacing="20" Margin="16,14,60,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{CustomResource SnapTap_Title.Text}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                                                <Button x:Name="SnapTapInfoButton"
                                                                        Width="20" Height="20" MinWidth="0" MinHeight="0"
                                                                        Padding="0" Background="Transparent" BorderThickness="0"
                                                                        VerticalAlignment="Center"
                                                                        AutomationProperties.Name="{CustomResource SnapTap_InfoButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                                        ToolTipService.ToolTip="{CustomResource SnapTap_InfoButton.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}">
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                                                                <StackPanel MaxWidth="320" Spacing="12">
                                                                                    <TextBlock Text="{CustomResource SnapTap_InfoTitle.Text}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{CustomResource SnapTap_InfoInput.Text}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                                                    <TextBlock Text="{CustomResource SnapTap_InfoCompatibility.Text}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                            </ScrollViewer>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                                                </Button>
                                                            </StackPanel>
                                                            <TextBlock Text="{CustomResource SnapTap_Description.Text}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="SnapTapStatusText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                                            <StackPanel x:Name="SnapTapDriverActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                                <Button x:Name="SnapTapInstallDriverButton"
                                                                        Content="{CustomResource SnapTap_InstallDriver.Content}" HorizontalAlignment="Left"
                                                                        Style="{StaticResource AccentButtonStyle}"
                                                                        Click="OnInstallSnapTapDriver"
                                                                        AutomationProperties.Name="{CustomResource SnapTap_InstallDriver.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                                                                <HyperlinkButton x:Name="SnapTapDriverLink"
                                                                                 Style="{StaticResource ExternalLinkButtonStyle}"
                                                                                 Width="32" Height="32" Padding="0"
                                                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                 ToolTipService.ToolTip="{CustomResource SnapTap_DriverLink.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}"
                                                                                  NavigateUri="https://github.com/OpenBladeProject/blade-driver-catalog"
                                                                                 AutomationProperties.Name="{CustomResource SnapTap_DriverLink.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                                                </HyperlinkButton>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ToggleSwitch x:Name="SnapTapToggle" Grid.Column="1" Style="{StaticResource CompactCardToggleSwitchStyle}" Toggled="OnSnapTapToggled" AutomationProperties.Name="{CustomResource SnapTap_Toggle.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                                                    </Grid>
                                                </Border>
                                            </Expander.Header>
                                            <Border x:Name="SnapTapBackendRow" Style="{StaticResource SettingsLastNeutralSubcardStyle}">
                                                <Grid ColumnSpacing="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{CustomResource KeyboardBackend_SnapTapTitle.Text}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                                        <TextBlock
                                                                   Text="{CustomResource KeyboardBackend_SnapTapDescription.Text}"
                                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <local:ResponsiveChoiceSelector x:Name="SnapTapBackendSelector"
                                                                                    Grid.Column="1" VerticalAlignment="Center" CompactMinWidth="150" ExpandedMinWindowWidth="800"
                                                                                    AccessibleName="{CustomResource KeyboardBackend_SnapTapSelector.AccessibleName}" DisplayMemberPath="Label"
                                                                                    PlaceholderText="{CustomResource KeyboardBackend_SnapTapSelector.PlaceholderText}" SelectionChanged="OnSnapTapBackendChanged" />
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ContentControl x:Name="StartupAnimationCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardStartupAnimationCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <StackPanel x:Name="ShortcutKeysSection"
                                    Visibility="{x:Bind ViewModel.IsSpecialKeyBindingsEditable, Mode=OneWay}">
                            <TextBlock local:CardReorder.IsHeader="True" Text="{CustomResource MainWindow_TextBlockShortcutKeys.Text}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,10" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <ItemsRepeater ItemsSource="{x:Bind SpecialKeyBindings, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:SpecialKeyBindingViewModel">
                                            <Border Style="{StaticResource SettingsRowStyle}"
                                                    Visibility="{x:Bind IsEditable, Mode=OneWay}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="280" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind SlotLabel, Mode=OneWay}"
                                                                       Style="{StaticResource CardTitleStyle}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                  MinWidth="200"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  ItemsSource="{x:Bind AvailableActions, Mode=OneWay}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedItem="{x:Bind SelectedAction, Mode=OneWay}"
                                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedAction, Mode=OneWay}"
                                                                  Tag="{x:Bind Slot}"
                                                                  SelectionChanged="OnSpecialKeyActionSelectionChanged"
                                                                  AutomationProperties.Name="{x:Bind ActionAccessibleName, Mode=OneWay}" />
                                                    </Grid>
                                                    <Grid Visibility="{x:Bind ValueEditorVisibility, Mode=OneWay}"
                                                          ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="280" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind ValueLabel, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                     PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                                                                     MaxLength="2048"
                                                                     AutomationProperties.Name="{x:Bind ValueLabel, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                                                       Visibility="{x:Bind ValidationMessageVisibility, Mode=OneWay}"
                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ThxAudioPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ThxAudioPageContent"
                                Padding="28,20,28,28"
                                Width="{Binding ElementName=ThxAudioPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                        <StackPanel x:Name="ThxAudioSection">
                            <TextBlock Text="{CustomResource MainWindow_ThxAudioHeading.Text}"
                                       Style="{StaticResource PageTitleStyle}" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid x:Name="ThxAudioIntegrationRow" ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{CustomResource MainWindow_ThxAudioIntegrationTitle.Text}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock
                                                           Text="{CustomResource MainWindow_ThxAudioDescription.Text}"
                                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ThxViewModel.IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind ThxViewModel.CanToggleIntegration, Mode=OneWay}"
                                                          AutomationProperties.Name="{CustomResource MainWindow_ThxAudioIntegrationToggle.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                          Toggled="OnThxIntegrationToggled" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16,14,16,18" Spacing="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_ThxAudioOutputTitle.Text}"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                            <local:ResponsiveChoiceSelector Grid.Column="1"
                                                      ExpandedMinWindowWidth="720"
                                                      ItemsSource="{x:Bind ThxViewModel.Endpoints, Mode=OneWay}"
                                                      SelectedItem="{x:Bind ThxViewModel.SelectedEndpoint, Mode=OneWay}"
                                                      DisplayMemberPath="Label" AccessibleName="{CustomResource MainWindow_ThxAudioOutput.AccessibleName}"
                                                      IsEnabled="{x:Bind ThxViewModel.CanRead, Mode=OneWay}"
                                                      SelectionChanged="OnThxEndpointChanged" />
                                            <Button Grid.Column="2" Content="{CustomResource MainWindow_ThxAudioReadSettings.Content}"
                                                    Visibility="{x:Bind ThxViewModel.IsReadSettingsVisible, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ThxViewModel.CanRead, Mode=OneWay}" Click="OnThxReadSettings" />
                                        </Grid>
                                        <Grid x:Name="ThxAudioStatusArea" MinHeight="20">
                                            <!-- Retain the wrapped status height while the visible text is replaced by progress. -->
                                            <TextBlock Text="{x:Bind ThxViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                                       Style="{StaticResource SecondaryTextStyle}" Opacity="0" IsHitTestVisible="False"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Text="{x:Bind ThxViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                                       Visibility="{x:Bind ThxViewModel.ShowStatusMessage, Mode=OneWay}"
                                                       VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar x:Name="ThxAudioProgress" IsIndeterminate="True" Height="3" VerticalAlignment="Center"
                                                         Visibility="{x:Bind ThxViewModel.IsBusy, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel x:Name="ThxAudioComponentDownload" Spacing="8"
                                                    Visibility="{x:Bind ThxViewModel.IsComponentDownloadVisible, Mode=OneWay}">
                                            <TextBlock
                                                       Text="{CustomResource MainWindow_ThxAudioComponentDownloadDescription.Text}"
                                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                            <Button x:Name="ThxAudioDownloadComponent" HorizontalAlignment="Left"
                                                    Content="{x:Bind ThxViewModel.DownloadComponentButtonLabel, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ThxViewModel.CanDownloadComponent, Mode=OneWay}"
                                                    Click="OnThxDownloadComponent" />
                                        </StackPanel>
                                        <StackPanel x:Name="ThxAudioStackInstallation" Spacing="8"
                                                    Visibility="{x:Bind ThxViewModel.IsStackInstallationVisible, Mode=OneWay}">
                                            <TextBlock
                                                       Text="{CustomResource MainWindow_ThxAudioStackInstallationDescription.Text}"
                                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                            <Button x:Name="ThxAudioInstallStack" HorizontalAlignment="Left"
                                                    Content="{x:Bind ThxViewModel.InstallStackButtonLabel, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ThxViewModel.CanInstallStack, Mode=OneWay}"
                                                    Click="OnThxInstallStack" />
                                        </StackPanel>
                                        <Grid x:Name="ThxAudioSpatialRow" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_ThxAudioSpatialTitle.Text}"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ThxViewModel.SpatialEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind ThxViewModel.CanEdit, Mode=OneWay}"
                                                          AutomationProperties.Name="{CustomResource MainWindow_ThxAudioSpatial.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" Toggled="OnThxSpatialToggled" />
                                        </Grid>
                                        <Grid x:Name="ThxAudioEqualizerRow" ColumnSpacing="24" Visibility="{x:Bind ThxViewModel.ShowEqualizerControls, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_ThxAudioEqualizerTitle.Text}"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1"
                                                          Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                          IsOn="{x:Bind ThxViewModel.EqualizerEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind ThxViewModel.CanEditEqualizer, Mode=OneWay}"
                                                          AutomationProperties.Name="{CustomResource MainWindow_ThxAudioEqualizer.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" Toggled="OnThxEqualizerToggled" />
                                        </Grid>
                                        <Grid x:Name="ThxAudioPresetRow" ColumnSpacing="16" Visibility="{x:Bind ThxViewModel.ShowEqualizerControls, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{CustomResource MainWindow_ThxAudioPresetTitle.Text}"
                                                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <local:ResponsiveChoiceSelector Grid.Column="1"
                                                      ExpandedMinWindowWidth="800"
                                                      DisplayMemberPath="Name" AccessibleName="{CustomResource MainWindow_ThxAudioPreset.AccessibleName}"
                                                      ItemsSource="{x:Bind ThxViewModel.Presets, Mode=OneWay}"
                                                      SelectedItem="{x:Bind ThxViewModel.SelectedPreset, Mode=OneWay}"
                                                      IsEnabled="{x:Bind ThxViewModel.CanEdit, Mode=OneWay}" SelectionChanged="OnThxPresetChanged" />
                                        </Grid>
                                        <TextBlock
                                                   Text="{CustomResource MainWindow_ThxAudioLegacyEqualizerLimit.Text}"
                                                   Visibility="{x:Bind ThxViewModel.ShowEqualizerLimit, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ThxViewModel.ActiveProfileMessage, Mode=OneWay}"
                                                   Visibility="{x:Bind ThxViewModel.HasActiveApplicationProfile, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <StackPanel Spacing="10" Visibility="{x:Bind ThxViewModel.HasEqualizerBands, Mode=OneWay}">
                                            <ItemsRepeater ItemsSource="{x:Bind ThxViewModel.EqualizerBands, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="52" MinColumnSpacing="4" ItemsJustification="SpaceBetween" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:ThxEqualizerBandViewModel">
                                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{x:Bind GainLabel, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                                            <Slider Orientation="Vertical" Height="124" Minimum="-12" Maximum="12"
                                                                    SmallChange="1" LargeChange="1" StepFrequency="1"
                                                                    Value="{x:Bind DraftGainDb, Mode=TwoWay}"
                                                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                                    AutomationProperties.Name="{x:Bind AccessibleName}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind FrequencyLabel}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock Text="{x:Bind ThxViewModel.EqualizerDraftHint, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            <Grid x:Name="ThxEqualizerActions" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="{CustomResource MainWindow_ThxAudioResetEqualizer.Content}"
                                                            IsEnabled="{x:Bind ThxViewModel.CanResetEqualizer, Mode=OneWay}" Click="OnThxResetEqualizer" />
                                                    <Button Content="{CustomResource MainWindow_ThxAudioFlattenEqualizer.Content}"
                                                            IsEnabled="{x:Bind ThxViewModel.CanEditEqualizerBands, Mode=OneWay}" Click="OnThxFlattenEqualizer" />
                                                </StackPanel>
                                                <StackPanel x:Name="ThxEqualizerCommitActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                    <Button Content="{CustomResource MainWindow_ThxAudioDiscard.Content}"
                                                            IsEnabled="{x:Bind ThxViewModel.CanDiscardEqualizerChanges, Mode=OneWay}" Click="OnThxDiscardEqualizer" />
                                                    <Button Content="{CustomResource MainWindow_ThxAudioApplyEqualizer.Content}" Style="{StaticResource AccentButtonStyle}"
                                                            IsEnabled="{x:Bind ThxViewModel.CanApplyEqualizer, Mode=OneWay}" Click="OnThxApplyEqualizer" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                                        <Expander x:Name="ThxAudioEnhancements"
                                                  Visibility="{x:Bind ThxViewModel.HasEnhancements, Mode=OneWay}"
                                                  Style="{StaticResource CardContentExpanderStyle}"
                                                  IsExpanded="False" AutomationProperties.Name="{CustomResource MainWindow_ThxAudioEnhancements.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                            <Expander.Resources>
                                                <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                                <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                            </Expander.Resources>
                                            <Expander.Header>
                                                <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                                    <TextBlock Text="{CustomResource MainWindow_ThxAudioEnhancementsTitle.Text}"
                                                               Style="{StaticResource CardTitleStyle}" Margin="16,14,60,14" TextWrapping="Wrap" />
                                                </Border>
                                            </Expander.Header>
                                            <StackPanel>
                                                <Border x:Name="ThxNormalizationCell" Style="{StaticResource SettingsNeutralSubcardStyle}"
                                                        Padding="{StaticResource DashboardSingleLineRowPadding}"
                                                        Visibility="{x:Bind ThxViewModel.HasSoundNormalization, Mode=OneWay}">
                                                    <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="120" />
                                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{CustomResource MainWindow_ThxAudioNormalizationTitle.Text}"
                                                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                                        <Slider Grid.Column="1"
                                                                Style="{StaticResource InlineCardSliderStyle}"
                                                                Minimum="0" Maximum="100" StepFrequency="1" Tag="SoundNormalization"
                                                                Value="{x:Bind ThxViewModel.SoundNormalizationLevel, Mode=TwoWay}"
                                                                IsEnabled="{x:Bind ThxViewModel.CanEditSoundNormalizationLevel, Mode=OneWay}"
                                                                AutomationProperties.Name="{CustomResource MainWindow_ThxAudioNormalizationLevel.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                                PointerPressed="OnThxEnhancementPointerPressed"
                                                                PointerReleased="OnThxEnhancementPointerCompleted"
                                                                PointerCaptureLost="OnThxEnhancementPointerCompleted"
                                                                PointerWheelChanged="OnThxEnhancementPointerWheelChanged"
                                                                KeyUp="OnThxEnhancementKeyUp" LostFocus="OnThxEnhancementLostFocus" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ThxViewModel.SoundNormalizationLevelLabel, Mode=OneWay}"
                                                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                                                        <ToggleSwitch Grid.Column="3"
                                                                      Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                                      IsOn="{x:Bind ThxViewModel.SoundNormalizationEnabled, Mode=OneWay}"
                                                                      IsEnabled="{x:Bind ThxViewModel.CanEditSoundNormalization, Mode=OneWay}"
                                                                      AutomationProperties.Name="{CustomResource MainWindow_ThxAudioNormalization.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" Toggled="OnThxNormalizationToggled" />
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="ThxVoiceClarityCell" Style="{StaticResource SettingsNeutralSubcardStyle}"
                                                        Padding="{StaticResource DashboardSingleLineRowPadding}"
                                                        Visibility="{x:Bind ThxViewModel.HasVoiceClarity, Mode=OneWay}">
                                                    <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="120" />
                                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{CustomResource MainWindow_ThxAudioVoiceClarityTitle.Text}"
                                                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" SizeChanged="OnDashboardSingleLineTitleSizeChanged" />
                                                        <Slider Grid.Column="1"
                                                                Style="{StaticResource InlineCardSliderStyle}"
                                                                Minimum="0" Maximum="100" StepFrequency="1" Tag="VoiceClarity"
                                                                Value="{x:Bind ThxViewModel.VoiceClarityLevel, Mode=TwoWay}"
                                                                IsEnabled="{x:Bind ThxViewModel.CanEditVoiceClarityLevel, Mode=OneWay}"
                                                                AutomationProperties.Name="{CustomResource MainWindow_ThxAudioVoiceClarityLevel.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                                PointerPressed="OnThxEnhancementPointerPressed"
                                                                PointerReleased="OnThxEnhancementPointerCompleted"
                                                                PointerCaptureLost="OnThxEnhancementPointerCompleted"
                                                                PointerWheelChanged="OnThxEnhancementPointerWheelChanged"
                                                                KeyUp="OnThxEnhancementKeyUp" LostFocus="OnThxEnhancementLostFocus" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind ThxViewModel.VoiceClarityLevelLabel, Mode=OneWay}"
                                                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                                                        <ToggleSwitch Grid.Column="3"
                                                                      Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                                      IsOn="{x:Bind ThxViewModel.VoiceClarityEnabled, Mode=OneWay}"
                                                                      IsEnabled="{x:Bind ThxViewModel.CanEditVoiceClarity, Mode=OneWay}"
                                                                      AutomationProperties.Name="{CustomResource MainWindow_ThxAudioVoiceClarity.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" Toggled="OnThxVoiceClarityToggled" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <Expander x:Name="ThxAudioApplications"
                                              Style="{StaticResource CardContentExpanderStyle}"
                                              IsExpanded="False" AutomationProperties.Name="{CustomResource MainWindow_ThxAudioApplications.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                              IsEnabled="{x:Bind ThxViewModel.SupportsSavedAudio, Mode=OneWay}">
                                        <Expander.Resources>
                                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                        </Expander.Resources>
                                        <Expander.Header>
                                            <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                                <TextBlock Text="{CustomResource MainWindow_ThxAudioApplicationsTitle.Text}"
                                                           Style="{StaticResource CardTitleStyle}" Margin="16,14,60,14" TextWrapping="Wrap" />
                                            </Border>
                                        </Expander.Header>
                                        <StackPanel>
                                            <Border Style="{StaticResource SettingsNeutralSubcardStyle}">
                                                <Grid ColumnSpacing="20">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                                        <TextBlock
                                                                   Text="{CustomResource MainWindow_ThxAudioProfileDescription.Text}"
                                                                   TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ThxViewModel.AudioProfileMessage, Mode=OneWay}"
                                                                   TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
                                                    </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center" Content="{CustomResource MainWindow_ThxAudioCaptureProfile.Content}"
                                                        IsEnabled="{x:Bind ThxViewModel.CanCaptureAudioProfile, Mode=OneWay}" Click="OnThxCaptureAudioProfile" />
                                                </Grid>
                                            </Border>
                                            <Border x:Name="ThxAudioRoutingCell" Style="{StaticResource SettingsNeutralSubcardStyle}"
                                                    Padding="{StaticResource DashboardSingleLineRowPadding}">
                                                <Grid ColumnSpacing="20" MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                                        <ContentControl x:Name="ThxAudioRoutingLabel"
                                                                        Content="{CustomResource MainWindow_ThxAudioRoutingEnabled.Content}" IsTabStop="False"
                                                                        HorizontalContentAlignment="Stretch">
                                                            <ContentControl.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}" SizeChanged="OnDashboardSingleLineTitleSizeChanged" /></DataTemplate></ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                        <TextBlock Text="{x:Bind ThxViewModel.ApplicationRoutingUnavailableHint, Mode=OneWay}"
                                                                   Visibility="{x:Bind ThxViewModel.ApplicationRoutingUnavailable, Mode=OneWay}"
                                                                   TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                                  AutomationProperties.Name="{Binding ElementName=ThxAudioRoutingLabel, Path=Content}"
                                                                  IsOn="{x:Bind ThxViewModel.ApplicationRoutingEnabled, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ThxViewModel.CanConfigureApplicationRouting, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingsEditorSubcardStyle}">
                                                <StackPanel Spacing="12">
                                                    <ItemsRepeater ItemsSource="{x:Bind ThxViewModel.ApplicationRules}"
                                                                   Visibility="{x:Bind ThxViewModel.HasApplicationRules, Mode=OneWay}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="local:ThxApplicationRuleOption">
                                                                <Grid ColumnSpacing="12" Margin="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{x:Bind ExecutableName}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="{CustomResource MainWindow_ThxAudioRemoveRule.Content}"
                                                                            Tag="{x:Bind}" Click="OnThxRemoveApplicationRule" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                    <TextBox Header="{CustomResource MainWindow_ThxAudioApplicationExecutable.Header}" PlaceholderText="{CustomResource MainWindow_ThxAudioApplicationExecutable.PlaceholderText}"
                                                             Text="{x:Bind ThxViewModel.ApplicationExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="260" />
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{CustomResource MainWindow_ThxAudioApplicationModeTitle.Text}"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        <local:ResponsiveChoiceSelector Grid.Column="1" ExpandedMinWindowWidth="1200"
                                                                  AccessibleName="{CustomResource MainWindow_ThxAudioApplicationOutput.AccessibleName}" DisplayMemberPath="Label"
                                                                  ItemsSource="{x:Bind ThxViewModel.ApplicationOutputs, Mode=OneWay}"
                                                                  SelectedItem="{x:Bind ThxViewModel.ApplicationOutput, Mode=OneWay}"
                                                                  SelectionChanged="OnThxApplicationOutputChanged" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="ThxAudioProfileActionsCell" Style="{StaticResource SettingsLastNeutralSubcardStyle}"
                                                    Padding="{StaticResource DashboardSingleLineRowPadding}">
                                                <Grid MinHeight="{StaticResource DashboardSingleLineRowContentMinHeight}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                                        <Button Content="{CustomResource MainWindow_ThxAudioAddRule.Content}"
                                                                IsEnabled="{x:Bind ThxViewModel.CanAddApplicationRule, Mode=OneWay}" Click="OnThxAddApplicationRule" />
                                                        <Button Content="{CustomResource MainWindow_ThxAudioSaveProfile.Content}"
                                                                IsEnabled="{x:Bind ThxViewModel.CanSaveAudioProfile, Mode=OneWay}" Click="OnThxSaveAudioProfile" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LightingPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
