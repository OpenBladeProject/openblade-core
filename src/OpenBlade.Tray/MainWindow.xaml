                                <Border local:CardReorder.CardId="DisplayRefreshRatePicker" Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockRefreshRate.Text}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockChooseARefreshRateReportedByWindows.Text}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Name="DisplayRefreshRatePicker"
                                                                        Grid.Column="1"
                                                                        CompactMinWidth="180"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="{CustomResource MainWindow_DisplayRefreshRatePickerText.AccessibleName}"
                                                                        ItemsSource="{x:Bind RefreshRateOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        SelectedItem="{x:Bind SelectedRefreshRate, Mode=OneWay}"
                                                                        IsEnabled="{x:Bind CanChangeRefreshRate, Mode=OneWay}"
                                                                        DropDownOpened="OnDisplayPickerOpened"
                                                                        DropDownClosed="OnDisplayPickerClosed"
                                                                        SelectionChanged="OnDisplayRefreshRateChanged" />
                                    </Grid>
                                </Border>
                                <Border local:CardReorder.CardId="DisplayHdrToggle" Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockUseHDR.Text}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockShowAWiderRangeOfColorsAnd.Text}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DisplayHdrToggle"
                                                      Style="{StaticResource CompactCardToggleSwitchStyle}"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="{CustomResource MainWindow_DisplayHdrToggleText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                      IsOn="{x:Bind IsHdrEnabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind CanChangeHdr, Mode=OneWay}"
                                                      Toggled="OnDisplayHdrToggled" />
                                    </Grid>
                                </Border>
                                <Border local:CardReorder.CardId="DisplayColorProfilePicker" Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{CustomResource MainWindow_TextBlockColorProfile.Text}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind ColorProfileDescription, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <local:ResponsiveChoiceSelector x:Name="DisplayColorProfilePicker"
                                                                        Grid.Column="1"
                                                                        CompactMinWidth="180"
                                                                        ExpandedMinWindowWidth="800"
                                                                        AccessibleName="{CustomResource MainWindow_DisplayColorProfilePickerText.AccessibleName}"
                                                                        ItemsSource="{x:Bind ColorProfileOptions, Mode=OneWay}"
                                                                        DisplayMemberPath="Label"
                                                                        PlaceholderText="{CustomResource MainWindow_DisplayColorProfilePickerText.PlaceholderText}"
                                                                        SelectedItem="{x:Bind SelectedColorProfile, Mode=OneWay}"
                                                                        IsEnabled="{x:Bind CanChangeColorProfile, Mode=OneWay}"
                                                                        DropDownOpened="OnDisplayPickerOpened"
                                                                        DropDownClosed="OnDisplayPickerClosed"
                                                                        SelectionChanged="OnDisplayColorProfileChanged" />
                                    </Grid>
                                </Border>
                                <Border local:CardReorder.CardId="DisplayBrightnessSlider" Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{CustomResource MainWindow_DisplayBrightnessTitle.Text}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{CustomResource MainWindow_DisplayBrightnessDescription.Text}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" ColumnSpacing="12" Width="240" VerticalAlignment="Center"
                                              Visibility="{x:Bind HasBrightnessReading, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="DisplayBrightnessSlider"
                                                    Style="{StaticResource InlineCardSliderStyle}"
                                                    Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                                                    IsThumbToolTipEnabled="True"
                                                    AutomationProperties.Name="{CustomResource MainWindow_DisplayBrightnessEditor.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                    Value="{x:Bind BrightnessSliderValue, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanChangeBrightness, Mode=OneWay}"
                                                    Loaded="OnDisplayBrightnessSliderLoaded"
                                                    Unloaded="OnDisplayBrightnessSliderUnloaded"
                                                    ValueChanged="OnDisplayBrightnessSliderValueChanged" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value, ElementName=DisplayBrightnessSlider}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="%" Style="{StaticResource CardTitleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{CustomResource MainWindow_DisplayBrightnessUnavailableText.Text}" Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsBrightnessUnavailable, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,2,0,0" />
                        </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="CoolingPadCurvePointTemplate" x:DataType="local:CoolingPadCurvePointEditor">
                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <NumberBox x:Name="CoolingPadCurveTemperature" Header="{CustomResource MainWindow_CoolingPadCurveTemperatureText.Header}" Minimum="0" Maximum="110" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{x:Bind Temperature, Mode=TwoWay}" />
                    <NumberBox x:Name="CoolingPadCurveRpm" Grid.Column="1" Header="{CustomResource MainWindow_CoolingPadCurveRpmText.Header}" Minimum="500" Maximum="3200" SmallChange="50" LargeChange="500" SpinButtonPlacementMode="Inline" Value="{x:Bind Rpm, Mode=TwoWay}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="OpenBlade"
                  Background="Transparent">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <Grid x:Name="GlobalSearchTitleSlot" SizeChanged="OnGlobalSearchTitleSlotSizeChanged">
                    <Grid x:Name="GlobalSearchHost" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <AutoSuggestBox x:Name="GlobalSearchBox"
                                        TitleBar.IsDragRegion="False"
                                        PlaceholderText="{CustomResource GlobalSearchBox.PlaceholderText}"
                                        AutomationProperties.Name="{CustomResource GlobalSearchBox.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                        AutomationProperties.AcceleratorKey="Ctrl+K"
                                        UpdateTextOnSelect="False"
                                        ItemTemplate="{StaticResource GlobalSearchResultTemplate}"
                                        TextBoxStyle="{StaticResource GlobalSearchTextBoxStyle}"
                                        TextChanged="OnGlobalSearchTextChanged"
                                        QuerySubmitted="OnGlobalSearchSubmitted"
                                        PreviewKeyDown="OnGlobalSearchPreviewKeyDown"
                                        GettingFocus="OnGlobalSearchGettingFocus"
                                            GotFocus="OnGlobalSearchGotFocus" />
                        <SymbolIcon Symbol="Find" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="GlobalSearchShortcutHint" Text="{x:Bind GlobalSearchShortcutLabel}" AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource AppCaptionTextStyle}" Margin="0,0,10,0" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="GlobalSearchButton"
                        TitleBar.IsDragRegion="False"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Style="{StaticResource AppToolbarButtonStyle}"
                        AutomationProperties.Name="{CustomResource GlobalSearchButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                        AutomationProperties.AcceleratorKey="Ctrl+K">
                    <FontIcon Glyph="&#xE721;" Style="{StaticResource AppToolbarIconStyle}" />
                    <Button.Flyout>
                        <Flyout x:Name="GlobalSearchFlyout" Placement="BottomEdgeAlignedRight"
                                Opening="OnGlobalSearchFlyoutOpening" Opened="OnGlobalSearchFlyoutOpened"
                                Closed="OnGlobalSearchFlyoutClosed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="760" />
                                    <Setter Property="Padding" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid x:Name="CompactGlobalSearchHost">
                                <AutoSuggestBox x:Name="CompactGlobalSearchBox"
                                                PlaceholderText="{CustomResource GlobalSearchBox.PlaceholderText}"
                                                AutomationProperties.Name="{CustomResource GlobalSearchBox.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                UpdateTextOnSelect="False"
                                                ItemTemplate="{StaticResource GlobalSearchResultTemplate}"
                                                TextBoxStyle="{StaticResource GlobalSearchTextBoxStyle}"
                                                TextChanged="OnGlobalSearchTextChanged"
                                                QuerySubmitted="OnGlobalSearchSubmitted"
                                                PreviewKeyDown="OnGlobalSearchPreviewKeyDown" />
                                <SymbolIcon Symbol="Find" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <!-- The stock indicator can be clipped while traveling between
                     distant items. The selected Fluent background stays clear
                     and changes immediately without that motion artifact. -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                                 Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem"
                                    Content="{CustomResource MainWindow_HomeNavigationItemText.Content}"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasDashboardProfileDraft, Mode=OneWay}"
                                   AutomationProperties.Name="{CustomResource MainWindow_InfoBadgeDashboardHasUnsavedChanges.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfilesNavigationItem" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="{CustomResource MainWindow_TextBlockProfiles.Text}" />
                    </NavigationViewItem.Content>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasUnsavedProfileChanges, Mode=OneWay}"
                                   AutomationProperties.Name="{CustomResource MainWindow_InfoBadgeProfilesHasUnsavedChanges.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DisplayNavigationItem" Content="{CustomResource MainWindow_DisplayNavigationItemText.Content}" Tag="display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}"
                                   AutomationProperties.Name="{CustomResource MainWindow_InfoBadgeDisplayHasUnsavedChanges.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LaptopNavigationItem"
                                    Content="{CustomResource MainWindow_LaptopNavigationItemText.Content}"
                                    Tag="laptop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLaptopPageProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="{CustomResource MainWindow_InfoBadgeLaptopHasUnsavedChanges.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CoolingPadNavigationItem"
                                    Content="{CustomResource MainWindow_CoolingPadNavigationItemText.Content}"
                                    Tag="cooling-pad"
                                    Visibility="{x:Bind ViewModel.CoolingPad.IsVisible, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M3,4 H17 A2,2 0 0 1 19,6 V14 A2,2 0 0 1 17,16 H3 A2,2 0 0 1 1,14 V6 A2,2 0 0 1 3,4 Z M3,5 A1,1 0 0 0 2,6 V14 A1,1 0 0 0 3,15 H17 A1,1 0 0 0 18,14 V6 A1,1 0 0 0 17,5 Z M10,6 A4,4 0 1 1 6,10 A4,4 0 0 1 10,6 Z M10,7 A3,3 0 1 0 13,10 A3,3 0 0 0 10,7 Z M9.5,7 H10.5 V9.5 H13 V10.5 H10.5 V13 H9.5 V10.5 H7 V9.5 H9.5 Z M4,17 H7 V18 H4 Z M13,17 H16 V18 H13 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ThxAudioNavigationItem"
                                    Content="{CustomResource MainWindow_ThxAudioNavigationItemText.Content}" Tag="thx-audio"
                                    Visibility="{x:Bind ThxAudioNavigationVisibility, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <!-- Product736 THX mark; provenance in docs/thx-audio.md.
                             The vector inherits the navigation foreground in both themes. -->
                        <PathIcon x:Name="ThxAudioNavigationLogo" Width="20" Height="20"
                                  Data="M20,0 L20,1 L3.5,1 L3.5,6.5 L2.5,6.5 L2.5,1 L0,1 L0.01,0 Z M0,8 L20,8 L20,7 L0,7 Z M5.25,6.5 L6.25,6.5 L6.25,4.5 L10.25,4.5 L10.25,6.5 L11.25,6.5 L11.25,1.5 L10.25,1.5 L10.25,3.5 L6.25,3.5 L6.25,1.5 L5.25,1.5 Z M13.5,6.5 L15.522,4.443 L17.5,6.5 L19,6.5 L16.317,3.776 L18.624,1.5 L17.131,1.5 L15.431,3.166 L13.75,1.5 L12.25,1.5 L14.612,3.823 L12,6.5">
                            <!-- Center the 20x8 mark inside the 20x20 icon canvas. -->
                            <PathIcon.RenderTransform>
                                <TranslateTransform Y="6" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LightingNavigationItem"
                                    Content="{CustomResource MainWindow_LightingNavigationItemText.Content}"
                                    Tag="lighting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE781;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Style="{StaticResource UnsavedNavigationBadgeStyle}"
                                   Visibility="{x:Bind ViewModel.HasLightingProfileSaveOpportunity, Mode=OneWay}"
                                   AutomationProperties.Name="{CustomResource MainWindow_InfoBadgeLightingHasUnsavedChanges.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TelemetryNavigationItem" Content="{CustomResource Telemetry_Navigation.Content}" Tag="telemetry">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem"
                                    Content="{CustomResource MainWindow_SettingsNavigationItemText.Content}"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LabsNavigationItem"
                                    Content="{CustomResource MainWindow_LabsNavigationItem.Content}"
                                    Tag="labs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF196;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem"
                                    Content="{CustomResource MainWindow_AboutNavigationItemText.Content}"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="HomePage"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=HomePage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <local:ResponsivePageHeader x:Name="DashboardPageHeader"
                                                    Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                       Text="{CustomResource MainWindow_TextBlockDashboard.Text}"
                                       Style="{StaticResource PageHeaderTitleStyle}"
                                       local:ResponsivePageHeader.Role="Title" />
                            <StackPanel x:Name="DashboardProfileSaveActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.HasDashboardProfileActionOpportunity, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        local:ResponsivePageHeader.Role="ProfileActions">
                                <Button Content="{x:Bind ViewModel.DashboardProfileSaveLabel, Mode=OneWay}"
                                        Style="{StaticResource ProfileSaveButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasDashboardProfileSaveOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SaveProfilesCommand}" />
                                <Button Content="{CustomResource MainWindow_ButtonUseProfileSettings.Content}"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasDashboardProfileRestoreOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.DiscardProfileDraftCommand}" />
                            </StackPanel>
                            <Button
                                    Grid.Column="2"
                                    Content="{CustomResource MainWindow_ButtonCustomize.Content}"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    AutomationProperties.Name="{CustomResource MainWindow_ButtonCustomize.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                    Click="OnCustomizeDashboard"
                                    local:ResponsivePageHeader.Role="Customize" />
                        </local:ResponsivePageHeader>

                        <Grid x:Name="DashboardCardHost">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Border x:Name="DeviceStatusCard"
                                Style="{StaticResource CardStyle}"
                                Padding="22">
                            <Grid x:Name="HeroLayout" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="ProfileStateBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Click="OnProfileStateBadgeClick"
                                                AutomationProperties.Name="{CustomResource MainWindow_ProfileStateBadgeText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                 ToolTipService.ToolTip="{CustomResource MainWindow_ProfileStateBadgeText.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessReady, Mode=OneWay}" />
                                                    <ProgressRing Width="12" Height="12"
                                                                  IsActive="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.IsReadinessChecking, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessWarning, Mode=OneWay}" />
                                                    <Ellipse Width="8" Height="8"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                                             Visibility="{x:Bind ViewModel.IsReadinessError, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                             </StackPanel>
                                         </Button>
                                        <Button x:Name="TestedPlatformWarningBadge"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasUntestedPlatformVersion, Mode=OneWay}"
                                                Click="OnTestedPlatformWarningClick"
                                                AutomationProperties.Name="{CustomResource MainWindow_TestedPlatformWarningBadgeText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.DashboardTestedPlatformWarningMessage, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.PlatformCompatibilityWarningTitle, Mode=OneWay}"
                                                           Style="{StaticResource StatusPillTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AttentionIndicator"
                                                Style="{StaticResource StatusPillButtonStyle}"
                                                Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                                AutomationProperties.Name="{CustomResource MainWindow_AttentionIndicatorText.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}">
                                            <Button.Flyout>
                                                <Flyout x:Name="AttentionFlyout"
                                                        Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel MaxWidth="360" Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <Button HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanReapplyChangedSettings, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.ShowReapplyChangedSettings, Mode=OneWay}"
                                                                Click="OnReapplyChangedSettingsClick"
                                                                AutomationProperties.Name="{CustomResource MainWindow_ButtonReapplyOpenBladeSettings.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
                                                                              IsActive="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}"
                                                                              Visibility="{x:Bind ViewModel.IsReapplyChangedSettingsOperationInProgress, Mode=OneWay}" />
                                                                <TextBlock Text="{CustomResource MainWindow_TextBlockReapplyOpenBladeSettings.Text}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button HorizontalAlignment="Left"
                                                                Margin="0,4,0,0"
                                                                IsEnabled="{x:Bind ViewModel.CanCheckCurrentState, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.HasUnconfirmedWrites, Mode=OneWay}"
                                                                Click="OnCheckCurrentStateClick"
                                                                AutomationProperties.Name="{CustomResource MainWindow_ButtonCheckCurrentState.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ProgressRing Width="14"
                                                                              Height="14"
