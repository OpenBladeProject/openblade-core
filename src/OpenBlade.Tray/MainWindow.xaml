<Window
    x:Class="OpenBlade.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade">
    <Grid x:Name="Root"
          Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="NarrowWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FanActionsColumn.Width" Value="Auto" />
                        <Setter Target="FanActions.(Grid.Row)" Value="0" />
                        <Setter Target="FanActions.(Grid.Column)" Value="1" />
                        <Setter Target="PerformanceColumn2.Width" Value="*" />
                        <Setter Target="PerformanceColumn3.Width" Value="*" />
                        <Setter Target="BalancedChoice.(Grid.Row)" Value="0" />
                        <Setter Target="BalancedChoice.(Grid.Column)" Value="1" />
                        <Setter Target="PerformanceChoice.(Grid.Row)" Value="0" />
                        <Setter Target="PerformanceChoice.(Grid.Column)" Value="2" />
                        <Setter Target="BatteryActionColumn2.Width" Value="*" />
                        <Setter Target="BatteryActionColumn3.Width" Value="*" />
                        <Setter Target="BatteryProtectionAction.(Grid.Row)" Value="0" />
                        <Setter Target="BatteryProtectionAction.(Grid.Column)" Value="1" />
                        <Setter Target="FullChargeAction.(Grid.Row)" Value="0" />
                        <Setter Target="FullChargeAction.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <local:BooleanNegationToVisibilityConverter x:Key="BooleanNegationToVisibility" />
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <NavigationView x:Name="MainNavigation"
                        Background="Transparent"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavigationItem"
                                    Content="Home"
                                    Tag="home"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="28,20,28,28"
                  HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="HomePage"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}" />

                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <Grid ColumnSpacing="20" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.ActivePowerSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="12"
                                                Padding="10,3">
                                            <TextBlock Text="{x:Bind ViewModel.ProfileStateLabel, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.ActivePerformanceLabel, Mode=OneWay}"
                                               FontSize="32"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{x:Bind ViewModel.ActiveFanModeLabel, Mode=OneWay}"
                                                   FontSize="16" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentBatterySettingLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="HeroReadings"
                                            Grid.Column="1"
                                            Spacing="7"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.LiveReadingsEnabled, Mode=OneWay}">
                                    <TextBlock Text="Live readings"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.BatteryPowerFlowLabel, Mode=OneWay}"
                                               Style="{StaticResource CardTitleStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind ViewModel.Fan1RpmLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Fan2RpmLabel, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,12"
                                AutomationProperties.Name="Show warning details">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel MaxWidth="420" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.AttentionDetails, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <FontIcon Grid.Column="2"
                                          Glyph="&#xE70D;"
                                          FontSize="12"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{x:Bind ViewModel.HasOperationFeedback, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <SymbolIcon Symbol="Accept" />
                                <TextBlock Text="{x:Bind ViewModel.OperationFeedbackMessage, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.HasActiveChanges, Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Active changes" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveChangesText, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Use profile settings"
                                        Command="{x:Bind ViewModel.ClearManualOverridesCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Performance and fans" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.IsPerformanceVisible, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Performance" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="Choose how the laptop balances noise and speed."
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="PerformanceColumn2" Width="0" />
                                        <ColumnDefinition x:Name="PerformanceColumn3" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <RadioButton Content="Silent"
                                                 HorizontalAlignment="Left"
                                                 IsChecked="{x:Bind ViewModel.IsSilentSelected, Mode=OneWay}"
                                                 Command="{x:Bind ViewModel.SetPerformanceCommand}"
                                                 CommandParameter="{x:Bind SilentPreset}" />
                                    <RadioButton x:Name="BalancedChoice"
                                                 Grid.Row="1"
                                                 Content="Balanced"
                                                 HorizontalAlignment="Left"
                                                 IsChecked="{x:Bind ViewModel.IsBalancedSelected, Mode=OneWay}"
                                                 Command="{x:Bind ViewModel.SetPerformanceCommand}"
                                                 CommandParameter="{x:Bind BalancedPreset}" />
                                    <RadioButton x:Name="PerformanceChoice"
                                                 Grid.Row="2"
                                                 Content="Performance"
                                                 HorizontalAlignment="Left"
                                                 IsChecked="{x:Bind ViewModel.IsPerformanceSelected, Mode=OneWay}"
                                                 Command="{x:Bind ViewModel.SetPerformanceCommand}"
                                                 CommandParameter="{x:Bind PerformancePreset}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{x:Bind ViewModel.IsFanControlVisible, Mode=OneWay}">
                            <Grid ColumnSpacing="18" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="FanActionsColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Fans" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="Automatic is recommended for everyday use."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="FanActions"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <ComboBox x:Name="DashboardFanModeSelector"
                                              AutomationProperties.Name="Fan mode"
                                              MinWidth="140"
                                              ItemsSource="{x:Bind ViewModel.AvailableFanModes, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFanMode, Mode=OneWay}" />
                                    <Button Content="Apply"
                                            Command="{x:Bind ViewModel.SetFanModeCommand}"
                                            CommandParameter="{x:Bind DashboardFanModeSelector.SelectedItem, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Battery protection" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Limit charging to help preserve battery health."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ChargeLimitPercent, Mode=OneWay}" FontWeight="SemiBold" />
                                        <TextBlock Text="%" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="50"
                                        AutomationProperties.Name="Charge limit"
                                        Maximum="80"
                                        StepFrequency="5"
                                        SmallChange="5"
                                        LargeChange="5"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="True"
                                        Value="{Binding ChargeLimitPercent, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="BatteryActionColumn2" Width="0" />
                                        <ColumnDefinition x:Name="BatteryActionColumn3" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Content="Apply limit"
                                            Command="{x:Bind ViewModel.SetChargeLimitCommand}"
                                            CommandParameter="{x:Bind ViewModel.ChargeLimitPercent, Mode=OneWay}" />
                                    <Button x:Name="BatteryProtectionAction"
                                            Grid.Row="1"
                                            Content="{x:Bind ViewModel.BatteryProtectionActionLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleBatteryProtectionCommand}" />
                                    <Button x:Name="FullChargeAction"
                                            Grid.Row="2"
                                            Content="{x:Bind ViewModel.FullChargeActionLabel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleFullChargeCommand}"
                                            CommandParameter="{x:Bind ViewModel.EnableFullChargeOverride, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProfilesPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Profiles" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="OpenBlade switches between these settings when the power source changes."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,16" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="Plugged in" FontSize="20" FontWeight="SemiBold" />
                                    <Border HorizontalAlignment="Right"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind ViewModel.IsPluggedInProfileActive, Mode=OneWay}">
                                        <TextBlock Text="Active"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontSize="12" />
                                    </Border>
                                </Grid>
                                <ComboBox Header="Performance"
                                          ItemsSource="{x:Bind ViewModel.AvailablePerformancePresets, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.PluggedInPerformanceEditor, Mode=TwoWay}" />
                                <ComboBox Header="Fans"
                                          ItemsSource="{x:Bind ViewModel.AvailableFanModes, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.PluggedInFanModeEditor, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="On battery" FontSize="20" FontWeight="SemiBold" />
                                    <Border HorizontalAlignment="Right"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsPluggedInProfileActive, Converter={StaticResource BooleanNegationToVisibility}}">
                                        <TextBlock Text="Active"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontSize="12" />
                                    </Border>
                                </Grid>
                                <ComboBox Header="Performance"
                                          ItemsSource="{x:Bind ViewModel.AvailablePerformancePresets, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.BatteryPerformanceEditor, Mode=TwoWay}" />
                                <ComboBox Header="Fans"
                                          ItemsSource="{x:Bind ViewModel.AvailableFanModes, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.BatteryFanModeEditor, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Charge limit" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Used by both power profiles."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ProfileChargeLimitEditor, Mode=OneWay}" FontWeight="SemiBold" />
                                        <TextBlock Text="%" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="50"
                                        AutomationProperties.Name="Profile charge limit"
                                        Maximum="80"
                                        StepFrequency="5"
                                        SmallChange="5"
                                        LargeChange="5"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="True"
                                        Value="{Binding ProfileChargeLimitEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                                <Button Content="Save profiles"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveProfilesCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Behavior" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <ToggleSwitch Header="Keep selected settings"
                                              OffContent="Reset when the power source changes"
                                              OnContent="Keep until I reset them"
                                              IsOn="{x:Bind ViewModel.KeepManualChangesUntilCleared, Mode=TwoWay}" />
                                <ToggleSwitch Header="Live fan and battery readings"
                                              OffContent="Off"
                                              OnContent="On"
                                              IsOn="{x:Bind ViewModel.LiveReadingsEnabled, Mode=TwoWay}" />
                                <ToggleSwitch Header="Start OpenBlade when I sign in"
                                              IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=OneWay}"
                                              Toggled="OnStartAtSignInToggled" />
                                <TextBlock Text="{x:Bind ViewModel.StartupStatusMessage, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <ComboBox Header="Theme"
                                          ItemsSource="{x:Bind ViewModel.ThemeSelectionOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
                                <ComboBox Header="Tray icon hover label"
                                          ItemsSource="{x:Bind ViewModel.TrayHoverLabelOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{x:Bind ViewModel.SelectedTrayHoverLabelOption, Mode=TwoWay}" />
                                <TextBlock Text="Battery power uses the live readings setting above."
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Support" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Button Content="Export diagnostics"
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" />
                                <Expander Header="Troubleshooting">
                                    <TextBlock Text="{x:Bind ViewModel.TroubleshootingDetails, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Margin="8,4,8,12" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
