                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Installed" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="Latest" Style="{StaticResource SecondaryTextStyle}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="BIOS" Style="{StaticResource CardTitleStyle}" />
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.InstalledBiosVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FirmwareUpdateViewModel.PublishedBiosVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Grid.Row="2" Text="EC" Style="{StaticResource CardTitleStyle}" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FirmwareUpdateViewModel.InstalledEcVersion, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FirmwareUpdateViewModel.PublishedEcVersion, Mode=OneWay}"
