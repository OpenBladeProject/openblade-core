                                        HorizontalContentAlignment="Stretch" />

                        <ContentControl x:Name="StartupAnimationCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardStartupAnimationCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />

                        <StackPanel x:Name="ShortcutKeysSection"
                                    Visibility="{x:Bind ViewModel.IsSpecialKeyBindingsEditable, Mode=OneWay}">
                            <TextBlock Text="Shortcut keys"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,10" />
                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <ItemsRepeater ItemsSource="{x:Bind SpecialKeyBindings, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:SpecialKeyBindingViewModel">
                                            <Border Style="{StaticResource SettingsRowStyle}"
                                                    Visibility="{x:Bind IsEditable, Mode=OneWay}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="280" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind SlotLabel}"
                                                                       Style="{StaticResource CardTitleStyle}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                  MinWidth="200"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  ItemsSource="{x:Bind AvailableActions}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedItem="{x:Bind SelectedAction, Mode=OneWay}"
                                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedAction, Mode=OneWay}"
                                                                  Tag="{x:Bind Slot}"
                                                                  SelectionChanged="OnSpecialKeyActionSelectionChanged"
                                                                  AutomationProperties.Name="{x:Bind SlotLabel}" />
                                                    </Grid>
                                                    <Grid Visibility="{x:Bind ValueEditorVisibility, Mode=OneWay}"
                                                          ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="280" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind ValueLabel, Mode=OneWay}"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                     PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                                                                     MaxLength="2048"
                                                                     AutomationProperties.Name="{x:Bind ValueLabel, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind ValidationMessage, Mode=OneWay}"
                                                                       Visibility="{x:Bind ValidationMessageVisibility, Mode=OneWay}"
                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LightingPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=LightingPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="LightingPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16"
                              RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="LightingHeaderWide">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="900" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="LightingHeaderActions.(Grid.Row)" Value="0" />
                                            <Setter Target="LightingHeaderActions.(Grid.Column)" Value="1" />
                                            <Setter Target="LightingHeaderActions.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="LightingHeaderActions.HorizontalAlignment" Value="Right" />
                                            <Setter Target="LightingHeaderActions.Margin" Value="0,2,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="LightingHeaderCompact">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="LightingHeaderActions.(Grid.Row)" Value="1" />
                                            <Setter Target="LightingHeaderActions.(Grid.Column)" Value="0" />
                                            <Setter Target="LightingHeaderActions.(Grid.ColumnSpan)" Value="2" />
                                            <Setter Target="LightingHeaderActions.HorizontalAlignment" Value="Left" />
                                            <Setter Target="LightingHeaderActions.Margin" Value="0,2,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Lighting" Style="{StaticResource PageHeaderTitleStyle}" />
                                <ProgressRing Style="{StaticResource FirmwareProgressRingStyle}"
                                              IsActive="{x:Bind ViewModel.IsLightingOperationInProgress, Mode=OneWay}"
                                              AutomationProperties.Name="Applying lighting" />
                            </StackPanel>
                            <StackPanel x:Name="LightingHeaderActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                            <ContentControl x:Name="LightingProfileSaveActions"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.CanControlLighting, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasLightingProfileActionOpportunity, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind ViewModel.SaveToActiveProfileLabel, Mode=OneWay}"
                                        Style="{StaticResource ProfileSaveButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasLightingProfileSaveOpportunity, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SaveLightingProfileDraftCommand}" />
                                <Button Content="Use profile settings"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasLightingProfileDifference, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.DiscardLightingProfileDraftCommand}" />
                                </StackPanel>
                            </ContentControl>
                            <Button Content="Customize"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    Tag="Lighting"
                                    Click="OnCustomizePageSections"
                                    AutomationProperties.Name="Customize Lighting page" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="LightingCardsHost">
                        <ContentControl x:Name="LightingCard"
                                        Content="{x:Bind ViewModel}"
                                        ContentTemplate="{StaticResource DashboardLightingCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DisplayPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=DisplayPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="DisplayPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16"
                              RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="DisplayHeaderWide">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="900" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="DisplayHeaderActions.(Grid.Row)" Value="0" />
                                            <Setter Target="DisplayHeaderActions.(Grid.Column)" Value="1" />
                                            <Setter Target="DisplayHeaderActions.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="DisplayHeaderActions.HorizontalAlignment" Value="Right" />
                                            <Setter Target="DisplayHeaderActions.Margin" Value="0,2,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="DisplayHeaderCompact">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="DisplayHeaderActions.(Grid.Row)" Value="1" />
                                            <Setter Target="DisplayHeaderActions.(Grid.Column)" Value="0" />
                                            <Setter Target="DisplayHeaderActions.(Grid.ColumnSpan)" Value="2" />
                                            <Setter Target="DisplayHeaderActions.HorizontalAlignment" Value="Left" />
                                            <Setter Target="DisplayHeaderActions.Margin" Value="0,2,0,0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Display" Style="{StaticResource PageHeaderTitleStyle}" />
                                <ProgressRing Style="{StaticResource FirmwareProgressRingStyle}"
                                              IsActive="{x:Bind DisplayViewModel.IsBusy, Mode=OneWay}"
                                              AutomationProperties.Name="Applying display setting" />
                            </StackPanel>
                            <StackPanel x:Name="DisplayHeaderActions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                            <StackPanel x:Name="DisplayProfileSaveActions"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}">
                                <Button Content="{x:Bind ViewModel.SaveToActiveProfileLabel, Mode=OneWay}"
                                        Style="{StaticResource ProfileSaveButtonStyle}"
                                        IsEnabled="{x:Bind DisplayViewModel.CanSaveCurrentSettingsToProfile, Mode=OneWay}"
                                        Click="OnSaveCurrentDisplaySettingsToProfile" />
                                <Button Content="Use profile settings"
                                        Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                        Visibility="{x:Bind DisplayViewModel.HasProfileDifference, Mode=OneWay}"
                                        Click="OnUseDisplayProfileSettings" />
                            </StackPanel>
                            <Button Content="Customize"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    Tag="Display"
                                    Click="OnCustomizePageSections"
                                    AutomationProperties.Name="Customize Display page" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="DisplayCardsHost">
                        <ContentControl x:Name="DisplayCard"
                                        Content="{x:Bind DisplayViewModel}"
                                        ContentTemplate="{StaticResource DashboardDisplayCardTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28"
                                Width="{Binding ElementName=SettingsPage, Path=ViewportWidth, Mode=OneWay}"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="20" />
                            </TransitionCollection>
                        </StackPanel.Transitions>

                        <Grid x:Name="SettingsPageHeader"
                              Margin="0,0,0,20"
                              ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Settings"
                                       Style="{StaticResource PageHeaderTitleStyle}" />
                            <Button Grid.Column="1"
                                    Content="Customize"
                                    Style="{StaticResource PageHeaderSecondaryButtonStyle}"
                                    Tag="Settings"
                                    Click="OnCustomizePageSections"
                                    AutomationProperties.Name="Customize Settings page" />
                        </Grid>

                        <StackPanel x:Name="SettingsSectionHost">
                        <StackPanel x:Name="SettingsBehaviorSection">
                        <TextBlock Text="Behavior" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Live readings" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose how often OpenBlade refreshes temperatures, fan speed, and net battery power while the window is open or the tray icon is hovered."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="170"
                                              Style="{StaticResource SettingsPickerStyle}"
                                              AutomationProperties.Name="Live readings refresh interval"
                                              ItemsSource="{x:Bind ViewModel.LiveReadingsRefreshOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedLiveReadingsRefreshOption, Mode=TwoWay}"
                                              local:StableComboBoxSelection.Anchor="{x:Bind ViewModel.SelectedLiveReadingsRefreshOption, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Shown on Dashboard"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Choose which live readings appear in the Dashboard summary."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.DashboardTelemetryItems, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal"
                                                               ItemWidth="190"
                                                               ItemHeight="40" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:LiveReadingVisibilityOption">
                                                <CheckBox Content="{x:Bind Label, Mode=OneTime}"
                                                          IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Start at sign-in" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.StartupDescription, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  AutomationProperties.Name="Start OpenBlade when I sign in"
                                                  OffContent=""
                                                  OnContent=""
                                                  IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=OneWay}"
                                                  Toggled="OnStartAtSignInToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Start minimized"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Open in the notification area without showing the window."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartMinimizedToggle"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Start OpenBlade minimized"
                                                      OffContent=""
                                                      OnContent=""
                                                      Toggled="OnStartMinimizedToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Force run on incompatible firmware"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Bypass only the tested firmware check for an exact supported Razer Blade. Other hardware safety checks stay enabled."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Force run on incompatible firmware"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind ViewModel.AllowUntestedFirmware, Mode=OneWay}"
                                                      Toggled="OnFirmwareCompatibilityOverrideToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Override external lighting changes"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="When off, OpenBlade yields keyboard lighting to Synapse. Turn it on to reapply the last OpenBlade effect after an external change."
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      AutomationProperties.Name="Always override external lighting changes"
                                                      OffContent=""
                                                      OnContent=""
                                                      IsOn="{x:Bind ViewModel.AlwaysOverrideExternalLightingChanges, Mode=OneWay}"
                                                      Toggled="OnExternalLightingOverridePolicyToggled" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Notifications"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,18,0,10" />
                        <Border Style="{StaticResource SettingsGroupStyle}"
                                AutomationProperties.Name="Notification preferences">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Performance changes" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Confirmed Fn+P results."
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Notify when the performance mode changes"
                                                      OffContent="" OnContent=""
                                                      IsOn="{x:Bind PerformanceNotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Power profile changes" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Active AC, USB-C, or Battery profile."
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Notify when the active power profile changes"
                                                      OffContent="" OnContent=""
                                                      IsOn="{x:Bind ProfileAndPowerSourceNotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="App updates" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="New OpenBlade releases."
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Notify when an OpenBlade update is available"
                                                      OffContent="" OnContent=""
                                                      IsOn="{x:Bind AppUpdateNotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Firmware updates" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="New Razer BIOS, EC, or MCU firmware."
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Notify when a Razer firmware update is available"
                                                      OffContent="" OnContent=""
                                                      IsOn="{x:Bind FirmwareUpdateNotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Controller advisories" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="New Razer controllers. Advisories stay visible."
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Notify when another Razer controller is detected"
                                                      OffContent="" OnContent=""
                                                      IsOn="{x:Bind ControllerAdvisoryNotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsLastRowStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="Operation failures" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="Failed control operations. Details stay visible."
                                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Notify when an OpenBlade operation fails"
                                                      OffContent="" OnContent=""
                                                      IsOn="{x:Bind OperationFailureNotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsAppearanceSection">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="App theme" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Follow Windows, or always use light or dark mode."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="170"
                                              Style="{StaticResource SettingsPickerStyle}"
                                              AutomationProperties.Name="App theme"
                                              ItemsSource="{x:Bind ViewModel.ThemeSelectionOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}"
                                              local:StableComboBoxSelection.Anchor="{x:Bind ViewModel.SelectedThemeOption, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="App accent color"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="Use OpenBlade green, the Windows accent, or a color you choose."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="{x:Bind AccentColorPreviewBrush, Mode=OneWay}"
                                                 Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="1" />
                                        <ComboBox MinWidth="160"
                                                  Style="{StaticResource SettingsPickerStyle}"
                                                  AutomationProperties.Name="App accent color"
                                                  ItemsSource="{x:Bind AccentColorOptions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind SelectedAccentColorOption, Mode=TwoWay}"
                                                  local:StableComboBoxSelection.Anchor="{x:Bind SelectedAccentColorOption, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsSubcardStyle}"
                                    Visibility="{x:Bind CustomAccentColorVisibility, Mode=OneWay}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Custom color"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind AccentColorSummary, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Choose color"
                                            VerticalAlignment="Center"
                                            Click="OnChooseCustomAccentColor" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Expander x:Name="NavigationMenuExpander"
                                          Style="{StaticResource CardContentExpanderStyle}"
                                          IsExpanded="False"
                                          AutomationProperties.Name="Navigation menu order">
                                    <Expander.Resources>
                                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    </Expander.Resources>
                                    <Expander.Header>
                                        <Border Style="{StaticResource SettingsExpanderHeaderStyle}">
                                            <StackPanel Spacing="3" Margin="16,14,60,14">
                                                <TextBlock Text="Navigation menu"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="Choose the order of pages in the left menu."
                                                           Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SettingsSubcardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Drag pages into the order you want. Dashboard stays first and About stays last."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <ListView ItemsSource="{x:Bind PrimaryNavigationItems, Mode=OneWay}"
                                                      SelectionMode="None"
                                                      CanDragItems="True"
                                                      CanReorderItems="True"
                                                      ReorderMode="Enabled"
                                                      AllowDrop="True"
                                                      ItemTemplate="{StaticResource NavigationItemOptionTemplate}"
                                                      ItemContainerStyle="{StaticResource SettingsReorderListItemStyle}"
                                                      AutomationProperties.Name="Navigation menu pages" />
