<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AppPageTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}" />
    <Style x:Key="AppSectionTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}" />
    <Style x:Key="AppBodyTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}" />
    <Style x:Key="AppBodyStrongTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    <Style x:Key="AppCaptionTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="AppDataTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <DataTemplate x:Key="AppCommandTextTemplate">
        <TextBlock Text="{Binding}"
                   Style="{StaticResource AppBodyTextStyle}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </DataTemplate>
    <Style x:Key="AppCustomCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AppCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppCustomCommandButtonStyle}">
        <Setter Property="ContentTemplate" Value="{StaticResource AppCommandTextTemplate}" />
    </Style>
    <!-- Desktop chart tools: native states and focus, lower emphasis than page commands. -->
    <Style x:Key="AppToolbarButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AppToolbarToggleButtonStyle" TargetType="ToggleButton"
           BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AppToolbarIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style x:Key="AppInlineCommandStyle" TargetType="HyperlinkButton"
           BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
</ResourceDictionary>
