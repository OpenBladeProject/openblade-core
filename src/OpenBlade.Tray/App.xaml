<Application
    x:Class="OpenBlade.Tray.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#47E10C</Color>
            <Color x:Key="SystemAccentColorLight1">#6CE73D</Color>
            <Color x:Key="SystemAccentColorLight2">#91ED6D</Color>
            <Color x:Key="SystemAccentColorLight3">#C8F6B6</Color>
            <Color x:Key="SystemAccentColorDark1">#39B40A</Color>
            <Color x:Key="SystemAccentColorDark2">#2B8707</Color>
            <Color x:Key="SystemAccentColorDark3">#1C5A05</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
