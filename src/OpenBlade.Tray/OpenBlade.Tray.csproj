<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>true</UseWindowsForms>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- .NET 10 ComWrappers appends the wrapper of every managed object marshaled to
         native into a debugger-only list that is never trimmed. Native XAML {Binding}
         subscribers receive MainViewModel as the sender of each PropertyChanged, so the
         list reached 43 million entries (512 MB, live) in one tray session. The switch
         emits System.Diagnostics.Debugger.IsSupported=false into runtimeconfig.json,
         which is the only runtime consumer of that switch in an untrimmed app. -->
    <DebuggerSupport>false</DebuggerSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- The developer smoke and localization-snapshot harnesses compile only into
         harness builds (Tray tests, localization snapshots, translator packages).
         The shipped Tray does not contain them or their launch triggers. -->
    <OpenBladeDeveloperHarness Condition="'$(OpenBladeDeveloperHarness)' == '' and '$(OpenBladeLocalizationPreview)' == 'true'">true</OpenBladeDeveloperHarness>
    <DefineConstants Condition="'$(OpenBladeDeveloperHarness)' == 'true'">$(DefineConstants);OPENBLADE_DEVELOPER_HARNESS</DefineConstants>
    <AssemblyName Condition="'$(OpenBladeLocalizationPreview)' == 'true'">OpenBlade.LocalizationPreview</AssemblyName>
    <BaseOutputPath Condition="'$(OpenBladeLocalizationPreview)' == 'true'">bin-localization-preview\</BaseOutputPath>
    <IntermediateOutputPath Condition="'$(OpenBladeLocalizationPreview)' == 'true'">obj\localization-preview\$(Configuration)\</IntermediateOutputPath>
    <BaseOutputPath Condition="'$(OpenBladeDeveloperHarness)' == 'true' and '$(OpenBladeLocalizationPreview)' != 'true'">bin-developer-harness\</BaseOutputPath>
    <IntermediateOutputPath Condition="'$(OpenBladeDeveloperHarness)' == 'true' and '$(OpenBladeLocalizationPreview)' != 'true'">obj\developer-harness\$(Configuration)\</IntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-localization-preview\**;obj-localization-preview\**;obj\localization-preview\**;bin-developer-harness\**;obj\developer-harness\**</DefaultItemExcludes>
    <ApplicationIcon Condition="Exists('Assets\Brand\OpenBlade.ico')">Assets\Brand\OpenBlade.ico</ApplicationIcon>
    <!-- On .NET 10, this prevents the Windows Desktop SDK from sending WinUI XAML through the WPF compiler while WinForms supplies the tray icon. -->
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup Condition="'$(OpenBladeLocalizationPreview)' != 'true'">
    <PRIResource Remove="Strings\qps-ploc\Resources.resw" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenBlade.Contracts\OpenBlade.Contracts.csproj" />
    <ProjectReference Include="..\OpenBlade.Display\OpenBlade.Display.csproj" />
    <ProjectReference Include="..\OpenBlade.Platform\OpenBlade.Platform.csproj" />
    <ProjectReference Include="..\OpenBlade.Session\OpenBlade.Session.csproj" />
    <ProjectReference Include="..\OpenBlade.Tray.Core\OpenBlade.Tray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\OpenBlade.Setup\StartupShortcutWriter.cs"
             Link="StartupShortcutWriter.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\Brand\**\*.ico" Condition="Exists('Assets\Brand')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Update="Assets\Brand\OpenBlade.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Brand\Notifications\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PublishApplicationResourceIndex" AfterTargets="Publish">
    <ItemGroup>
      <OpenBladeCompiledXaml Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Error
      Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
      Text="The generated WinUI resource index was not found at '$(TargetDir)$(AssemblyName).pri'." />
    <Error
      Condition="'@(OpenBladeCompiledXaml)' == ''"
      Text="The generated WinUI compiled XAML files were not found under '$(TargetDir)'." />
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFiles="$(PublishDir)$(AssemblyName).pri" />
    <Copy
      SourceFiles="@(OpenBladeCompiledXaml)"
      DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
