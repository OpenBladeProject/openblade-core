<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>true</UseWindowsForms>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\Brand\OpenBlade.ico')">Assets\Brand\OpenBlade.ico</ApplicationIcon>
    <!-- On .NET 10, this prevents the Windows Desktop SDK from sending WinUI XAML through the WPF compiler while WinForms supplies the tray icon. -->
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference only the WinUI component. The umbrella package also deploys
         AI, ML, and Widgets binaries that OpenBlade does not use. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="[2.2.1]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="[2.2.0]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenBlade.Contracts\OpenBlade.Contracts.csproj" />
    <ProjectReference Include="..\OpenBlade.Display\OpenBlade.Display.csproj" />
    <ProjectReference Include="..\OpenBlade.Session\OpenBlade.Session.csproj" />
    <ProjectReference Include="..\OpenBlade.Tray.Core\OpenBlade.Tray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\OpenBlade.Setup\StartupShortcutWriter.cs"
             Link="StartupShortcutWriter.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\Brand\**\*.ico" Condition="Exists('Assets\Brand')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Update="Assets\Brand\OpenBlade.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Brand\Notifications\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PublishApplicationResourceIndex" AfterTargets="Publish">
    <ItemGroup>
      <OpenBladeCompiledXaml Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Error
      Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
      Text="The generated WinUI resource index was not found at '$(TargetDir)$(AssemblyName).pri'." />
    <Error
      Condition="'@(OpenBladeCompiledXaml)' == ''"
      Text="The generated WinUI compiled XAML files were not found under '$(TargetDir)'." />
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFiles="$(PublishDir)$(AssemblyName).pri" />
    <Copy
      SourceFiles="@(OpenBladeCompiledXaml)"
      DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
