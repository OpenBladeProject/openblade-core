<Window
    x:Class="OpenBlade.Tray.TrayDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade quick controls">
    <Grid x:Name="Root"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          KeyDown="OnRootKeyDown"
          SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <Style x:Key="QuickTileSurfaceStyle" TargetType="Border">
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="QuickTileActionStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="QuickTileTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="QuickTileValueStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="SecondaryStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="StatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DashboardPage">
            <ScrollViewer x:Name="ControlScroller"
                          Padding="14,14,14,10"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ControlGrid"
                      MinWidth="0"
                      ColumnSpacing="10"
                      RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PerformanceTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="7,0,0,7"
                                        IsEnabled="{Binding CanEditPerformance, Mode=OneWay}"
                                        Click="OnPerformanceCycleClick"
                                        AutomationProperties.Name="Cycle performance mode">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="19" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,7,7,0"
                                            IsEnabled="{Binding CanEditPerformance, Mode=OneWay}"
                                            Click="OnPerformanceDetailsClick"
                                            AutomationProperties.Name="Choose performance mode">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Performance" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding SelectedPerformanceOption.Label, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FansTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="7,0,0,7"
                                        IsEnabled="{Binding CanEditFanControl, Mode=OneWay}"
                                        Click="OnFansCycleClick"
                                        AutomationProperties.Name="Cycle fan mode">
                                    <FontIcon Glyph="&#xE895;" FontSize="19" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,7,7,0"
                                            IsEnabled="{Binding CanEditFanControl, Mode=OneWay}"
                                            Click="OnFansDetailsClick"
                                            AutomationProperties.Name="Choose fan mode">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Fans" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding SelectedFanModeOption.Label, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="BatteryTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="7,0,0,7"
                                        IsEnabled="{Binding CanAdjustChargeLimit, Mode=OneWay}"
                                        Click="OnBatteryCycleClick"
                                        AutomationProperties.Name="Cycle charge limit">
                                    <FontIcon Glyph="&#xE83F;" FontSize="18" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,7,7,0"
                                            IsEnabled="{Binding CanAdjustChargeLimit, Mode=OneWay}"
                                            Click="OnBatteryDetailsClick"
                                            AutomationProperties.Name="Choose charge limit">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Charge limit" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Style="{StaticResource QuickTileValueStyle}">
                                <Run Text="{Binding ChargeLimitPercent, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LightingTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="7,0,0,7"
                                        IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                        Click="OnLightingCycleClick"
                                        AutomationProperties.Name="Cycle lighting effect">
                                    <FontIcon Glyph="&#xE706;" FontSize="18" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,7,7,0"
                                            IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                            Click="OnLightingDetailsClick"
                                            AutomationProperties.Name="Choose lighting effect">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Lighting" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding SelectedLightingEffectOption.Label, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="10,8,14,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Width="38"
                        Height="38"
                        Padding="0"
                        Click="OnDetailBackClick"
                        AutomationProperties.Name="Back to quick controls">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock x:Name="DetailTitle"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView x:Name="PerformanceDetail"
                          Margin="14,2,14,10"
                          ItemsSource="{Binding AvailableActivePerformanceOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedPerformanceOption, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnPerformanceChanged"
                          AutomationProperties.Name="Performance choices" />
                <ListView x:Name="FansDetail"
                          Margin="14,2,14,10"
                          Visibility="Collapsed"
                          ItemsSource="{Binding AvailableActiveFanModeOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedFanModeOption, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnFanModeChanged"
                          AutomationProperties.Name="Fan choices" />
                <ListView x:Name="BatteryDetail"
                          Margin="14,2,14,10"
                          Visibility="Collapsed"
                          ItemsSource="{Binding ChargeLimitOptions, Mode=OneWay}"
                          SelectedItem="{Binding ChargeLimitPercent, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnChargeLimitChanged"
                          AutomationProperties.Name="Charge limit choices">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding}" />
                                <Run Text="%" />
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid x:Name="LightingDetail" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Margin="14,2,14,8"
                              ItemsSource="{Binding AvailableLightingEffectOptions, Mode=OneWay}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedLightingEffectOption, Mode=TwoWay}"
                              SelectionMode="Single"
                              AutomationProperties.Name="Lighting effect choices" />
                    <Border Grid.Row="1"
                            Padding="18,10,18,14"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryStyle}">
                                    <Run Text="{Binding LightingBrightnessEditor, Mode=OneWay}" />
                                    <Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                    AutomationProperties.Name="Lighting brightness"
                                    Value="{Binding LightingBrightnessEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Padding="14,11"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="StatusItemsHost"
                      ColumnSpacing="8"
                      VerticalAlignment="Center">
                    <Grid x:Name="BatteryPowerStatus" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE83F;" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardBatteryPowerFlowLabel, Mode=OneWay}"
                                   ToolTipService.ToolTip="{Binding BatteryPowerFlowLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="TemperatureStatus" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9CA;" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardTemperatureLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="FansStatus" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardFanModeLabel, Mode=OneWay}"
                                   ToolTipService.ToolTip="{Binding ActiveFanModeLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                </Grid>
                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Click="OnSettingsClick"
                        AutomationProperties.Name="Open OpenBlade">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
