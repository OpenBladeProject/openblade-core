<Window
    x:Class="OpenBlade.Tray.TrayDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade quick controls">
    <Grid x:Name="Root"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          KeyDown="OnRootKeyDown"
          SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <Style x:Key="QuickTileSurfaceStyle" TargetType="Border">
                <Setter Property="Height" Value="78" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="QuickTileLabelStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="2,6,2,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="ExpandedTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="SecondaryStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="StatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="DashboardScroller"
                      Padding="14,14,14,10"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DashboardContent"
                        MinWidth="0"
                        HorizontalAlignment="Left"
                        Spacing="10">
                <Grid x:Name="ControlGrid"
                      MinWidth="0"
                      ColumnSpacing="10"
                      RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PerformanceTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="19" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Performance mode"
                                          IsEnabled="{Binding CanEditPerformance, Mode=OneWay}"
                                          ItemsSource="{Binding AvailableActivePerformanceOptions, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedPerformanceOption, Mode=OneWay}"
                                          local:StableComboBoxSelection.Anchor="{Binding SelectedPerformanceOption, Mode=OneWay}"
                                          SelectionChanged="OnPerformanceChanged" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="Performance"
                                   Style="{StaticResource QuickTileLabelStyle}" />
                    </Grid>

                    <Grid x:Name="FansTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE895;" FontSize="19" />
                                <ComboBox Grid.Column="1"
                                          MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Fan mode"
                                          IsEnabled="{Binding CanEditFanControl, Mode=OneWay}"
                                          ItemsSource="{Binding AvailableActiveFanModeOptions, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedFanModeOption, Mode=OneWay}"
                                          local:StableComboBoxSelection.Anchor="{Binding SelectedFanModeOption, Mode=OneWay}"
                                          SelectionChanged="OnFanModeChanged" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="Fans"
                                   Style="{StaticResource QuickTileLabelStyle}" />
                    </Grid>

                    <Grid x:Name="BatteryTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE83F;" FontSize="18" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryStyle}">
                                        <Run Text="{Binding ChargeLimitPercent, Mode=OneWay}" />
                                        <Run Text="%" />
                                    </TextBlock>
                                </Grid>
                                <Slider Grid.Row="1"
                                        Margin="0,-2,0,0"
                                        Minimum="50"
                                        Maximum="80"
                                        StepFrequency="5"
                                        SmallChange="5"
                                        LargeChange="5"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="True"
                                        IsEnabled="{Binding CanAdjustChargeLimit, Mode=OneWay}"
                                        AutomationProperties.Name="Charge limit"
                                        Value="{Binding ChargeLimitPercent, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                        PointerPressed="OnChargeLimitPointerPressed"
                                        PointerReleased="OnChargeLimitPointerReleased"
                                        PointerCaptureLost="OnChargeLimitPointerReleased"
                                        KeyUp="OnChargeLimitKeyUp" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="Charge limit"
                                   Style="{StaticResource QuickTileLabelStyle}" />
                    </Grid>

                    <Grid x:Name="LightingTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE706;" FontSize="18" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="0"
                                              Height="32"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Lighting effect"
                                              IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                              ItemsSource="{Binding AvailableLightingEffectOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedLightingEffectOption, Mode=TwoWay}"
                                              local:StableComboBoxSelection.Anchor="{Binding SelectedLightingEffectOption, Mode=OneWay}" />
                                </Grid>
                                <Slider Grid.Row="1"
                                        Margin="0,-2,0,0"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="5"
                                        IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                        AutomationProperties.Name="Lighting brightness"
                                        Value="{Binding LightingBrightnessEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="Lighting"
                                   Style="{StaticResource QuickTileLabelStyle}" />
                    </Grid>
                </Grid>

                <Border x:Name="ExpandedControlContainer"
                        Margin="-14,2,-14,-10"
                        Padding="16,15,16,16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid x:Name="ExpandedPerformance"
                              HorizontalAlignment="Stretch"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="18" />
                                <TextBlock Text="Performance"
                                           Style="{StaticResource ExpandedTitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Expanded performance mode"
                                      IsEnabled="{Binding CanEditPerformance, Mode=OneWay}"
                                      ItemsSource="{Binding AvailableActivePerformanceOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedPerformanceOption, Mode=OneWay}"
                                      local:StableComboBoxSelection.Anchor="{Binding SelectedPerformanceOption, Mode=OneWay}"
                                      SelectionChanged="OnPerformanceChanged" />
                        </Grid>
                        <Grid x:Name="ExpandedFans"
                              HorizontalAlignment="Stretch"
                              ColumnSpacing="12"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE895;" FontSize="18" />
                                <TextBlock Text="Fans"
                                           Style="{StaticResource ExpandedTitleStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Expanded fan mode"
                                      IsEnabled="{Binding CanEditFanControl, Mode=OneWay}"
                                      ItemsSource="{Binding AvailableActiveFanModeOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedFanModeOption, Mode=OneWay}"
                                      local:StableComboBoxSelection.Anchor="{Binding SelectedFanModeOption, Mode=OneWay}"
                                      SelectionChanged="OnFanModeChanged" />
                        </Grid>
                        <StackPanel x:Name="ExpandedBattery" Spacing="7" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE83F;" FontSize="18" />
                                    <TextBlock Text="Charge limit"
                                               Style="{StaticResource ExpandedTitleStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryStyle}">
                                    <Run Text="{Binding ChargeLimitPercent, Mode=OneWay}" />
                                    <Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="50"
                                    Maximum="80"
                                    StepFrequency="5"
                                    SnapsTo="StepValues"
                                    IsEnabled="{Binding CanAdjustChargeLimit, Mode=OneWay}"
                                    AutomationProperties.Name="Expanded charge limit"
                                    Value="{Binding ChargeLimitPercent, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                    PointerPressed="OnChargeLimitPointerPressed"
                                    PointerReleased="OnChargeLimitPointerReleased"
                                    PointerCaptureLost="OnChargeLimitPointerReleased"
                                    KeyUp="OnChargeLimitKeyUp" />
                        </StackPanel>
                        <StackPanel x:Name="ExpandedLighting" Spacing="8" Visibility="Collapsed">
                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE706;" FontSize="18" />
                                    <TextBlock Text="Lighting"
                                               Style="{StaticResource ExpandedTitleStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Expanded lighting effect"
                                          IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                          ItemsSource="{Binding AvailableLightingEffectOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedLightingEffectOption, Mode=TwoWay}"
                                          local:StableComboBoxSelection.Anchor="{Binding SelectedLightingEffectOption, Mode=OneWay}" />
                            </Grid>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                    AutomationProperties.Name="Expanded lighting brightness"
                                    Value="{Binding LightingBrightnessEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Padding="14,11"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="StatusItemsHost"
                      ColumnSpacing="8"
                      VerticalAlignment="Center">
                    <Grid x:Name="BatteryPowerStatus" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE83F;" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardBatteryPowerFlowLabel, Mode=OneWay}"
                                   ToolTipService.ToolTip="{Binding BatteryPowerFlowLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="TemperatureStatus" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9CA;" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardTemperatureLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="FansStatus" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardFanModeLabel, Mode=OneWay}"
                                   ToolTipService.ToolTip="{Binding ActiveFanModeLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                </Grid>
                <Button Grid.Column="1"
                        Padding="13,7"
                        Content="More"
                        Click="OnMoreClick"
                        AutomationProperties.Name="Open OpenBlade" />
            </Grid>
        </Border>
    </Grid>
</Window>
