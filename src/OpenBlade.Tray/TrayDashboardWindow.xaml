<Window
    x:Class="OpenBlade.Tray.TrayDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenBlade.Tray"
    Title="OpenBlade quick controls">
    <Grid x:Name="Root"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <local:Int32DoubleConverter x:Key="Int32Double" />
            <x:Double x:Key="QuickTileIconSize">16</x:Double>
            <x:Double x:Key="DashboardPrimaryIconSize">20</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
            <Style x:Key="QuickTileSurfaceStyle" TargetType="Border">
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="QuickTileActionStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="QuickTileIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource QuickTileIconSize}" />
            </Style>
            <Style x:Key="QuickTileBatteryIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource DashboardPrimaryIconSize}" />
            </Style>
            <Style x:Key="QuickSliderIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource DashboardPrimaryIconSize}" />
            </Style>
            <Style x:Key="StatusIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource DashboardPrimaryIconSize}" />
                <Setter Property="Width" Value="{StaticResource DashboardPrimaryIconSize}" />
                <Setter Property="Height" Value="{StaticResource DashboardPrimaryIconSize}" />
            </Style>
            <Style x:Key="QuickSliderIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="QuickTileTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="QuickTileValueStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="StatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DashboardPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ControlScroller"
                          Padding="20,14,20,10"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ControlGrid"
                      MinWidth="0"
                      ColumnSpacing="10"
                      RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PerformanceTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="5,0,0,5"
                                        IsEnabled="{Binding CanEditPerformance, Mode=OneWay}"
                                        Click="OnPerformanceCycleClick"
                                        AutomationProperties.Name="Cycle performance mode">
                                    <FontIcon Glyph="&#xEC4A;"
                                              Style="{StaticResource QuickTileIconStyle}" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,5,5,0"
                                            IsEnabled="{Binding CanEditPerformance, Mode=OneWay}"
                                            Click="OnPerformanceDetailsClick"
                                            AutomationProperties.Name="Choose performance mode">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Performance" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding SelectedPerformanceOption.Label, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FansTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="FansDetailsColumn" Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="5,0,0,5"
                                        IsEnabled="{Binding CanEditFanControl, Mode=OneWay}"
                                        Click="OnFansCycleClick"
                                        AutomationProperties.Name="Cycle fan mode">
                                    <PathIcon Width="{StaticResource QuickTileIconSize}"
                                              Height="{StaticResource QuickTileIconSize}"
                                              Data="M8,6.5 C6.5,5.2 6.2,2.4 7.4,0.8 C8.5,0 10.2,0.3 10.8,1.8 C11.2,3.6 9.6,5.7 8,6.5 Z M9.5,8 C10.8,6.5 13.6,6.2 15.2,7.4 C16,8.5 15.7,10.2 14.2,10.8 C12.4,11.2 10.3,9.6 9.5,8 Z M8,9.5 C9.5,10.8 9.8,13.6 8.6,15.2 C7.5,16 5.8,15.7 5.2,14.2 C4.8,12.4 6.4,10.3 8,9.5 Z M6.5,8 C5.2,9.5 2.4,9.8 0.8,8.6 C0,7.5 0.3,5.8 1.8,5.2 C3.6,4.8 5.7,6.4 6.5,8 Z M8,6.75 A1.25,1.25 0 1 1 7.99,9.25 A1.25,1.25 0 1 1 8,6.75 Z" />
                                </Button>
                                <Border x:Name="FansDetailsHost"
                                        Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,5,5,0"
                                            IsEnabled="{Binding CanEditFanControl, Mode=OneWay}"
                                            Click="OnFansDetailsClick"
                                            AutomationProperties.Name="Choose fan mode">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Fans" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding SelectedFanModeOption.Label, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LightingTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="5,0,0,5"
                                        IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                        Click="OnLightingCycleClick"
                                        AutomationProperties.Name="Cycle lighting effect">
                                    <FontIcon Glyph="&#xE706;"
                                              Style="{StaticResource QuickTileIconStyle}" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,5,5,0"
                                            IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                            Click="OnLightingDetailsClick"
                                            AutomationProperties.Name="Choose lighting effect">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Lighting" Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding SelectedLightingEffectOption.Label, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="BatteryProtectionTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Button Style="{StaticResource QuickTileActionStyle}"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanChangeBatteryProtection, Mode=OneWay}"
                                    Click="OnBatteryProtectionClick"
                                    AutomationProperties.Name="Toggle battery protection">
                                <FontIcon Glyph="&#xE83F;"
                                          Style="{StaticResource QuickTileBatteryIconStyle}" />
                            </Button>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Battery protection"
                                       Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding TrayDashboardChargeLimitLabel, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FunctionRowTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Button Style="{StaticResource QuickTileActionStyle}"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanEditFunctionKeyPrimary, Mode=OneWay}"
                                    Click="OnFunctionRowCycleClick"
                                    AutomationProperties.Name="Cycle function row mode">
                                <FontIcon Glyph="&#xE765;"
                                          Style="{StaticResource QuickTileIconStyle}" />
                            </Button>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Function row"
                                       Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding FunctionKeyPrimaryStateLabel, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="GamingModeTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource QuickTileActionStyle}"
                                        CornerRadius="5,0,0,5"
                                        IsEnabled="{Binding CanEditGamingMode, Mode=OneWay}"
                                        Click="OnGamingModeCycleClick"
                                        AutomationProperties.Name="Toggle gaming mode">
                                    <FontIcon Glyph="&#xE7FC;"
                                              Style="{StaticResource QuickTileIconStyle}" />
                                </Button>
                                <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Button Style="{StaticResource QuickTileActionStyle}"
                                            CornerRadius="0,5,5,0"
                                            IsEnabled="{Binding CanEditGamingModeKeyPolicy, Mode=OneWay}"
                                            Click="OnGamingModeDetailsClick"
                                            AutomationProperties.Name="Configure gaming mode keys">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="Gaming mode"
                                       Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding TrayDashboardGamingModeLabel, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="GpuTuningTile" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuickTileSurfaceStyle}">
                            <Button Style="{StaticResource QuickTileActionStyle}"
                                    CornerRadius="5"
                                    IsEnabled="{Binding CanToggleGpuClockTuning, Mode=OneWay}"
                                    Click="OnGpuClockTuningClick"
                                    AutomationProperties.Name="Toggle GPU tuning">
                                <FontIcon Glyph="&#xE950;"
                                          Style="{StaticResource QuickTileIconStyle}" />
                            </Button>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="0">
                            <TextBlock Text="GPU tuning"
                                       Style="{StaticResource QuickTileTitleStyle}" />
                            <TextBlock Text="{Binding TrayDashboardGpuTuningLabel, Mode=OneWay}"
                                       Style="{StaticResource QuickTileValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border x:Name="SliderSection"
                    Grid.Row="1"
                    Padding="12,7"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid x:Name="SliderGrid" RowSpacing="4">
                        <Grid x:Name="ChargeLimitSliderRow"
                              Height="48"
                              ColumnSpacing="8"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource QuickSliderIconButtonStyle}"
                                    IsEnabled="{Binding CanChangeBatteryProtection, Mode=OneWay}"
                                    Click="OnBatteryProtectionClick"
                                    ToolTipService.ToolTip="Toggle charge limit"
                                    AutomationProperties.Name="Toggle charge limit">
                                <FontIcon Glyph="&#xE83F;"
                                          Style="{StaticResource QuickSliderIconStyle}" />
                            </Button>
                            <Slider x:Name="ChargeLimitSlider"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Minimum="50"
                                    Maximum="80"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    LargeChange="5"
                                    SnapsTo="StepValues"
                                    IsThumbToolTipEnabled="True"
                                    IsEnabled="{Binding CanAdjustChargeLimit, Mode=OneWay}"
                                    AutomationProperties.Name="Charge limit"
                                    Value="{Binding ChargeLimitPercent, Mode=TwoWay, Converter={StaticResource Int32Double}}"
                                    PointerPressed="OnChargeLimitPointerPressed"
                                    PointerReleased="OnChargeLimitPointerReleased"
                                    PointerCaptureLost="OnChargeLimitPointerReleased"
                                    KeyUp="OnChargeLimitKeyUp" />
                        </Grid>

                        <Grid x:Name="LightingBrightnessSliderRow"
                              Height="48"
                              ColumnSpacing="8"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xED39;"
                                      Style="{StaticResource QuickSliderIconStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    IsEnabled="{Binding CanControlLighting, Mode=OneWay}"
                                    AutomationProperties.Name="Keyboard brightness"
                                    Value="{Binding LightingBrightnessEditor, Mode=TwoWay, Converter={StaticResource Int32Double}}" />
                        </Grid>

                        <Grid x:Name="GpuCoreClockSliderRow"
                              Height="48"
                              ColumnSpacing="8"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource QuickSliderIconButtonStyle}"
                                    IsEnabled="{Binding CanToggleGpuClockTuning, Mode=OneWay}"
                                    Click="OnGpuClockTuningClick"
                                    ToolTipService.ToolTip="Toggle GPU clock tuning"
                                    AutomationProperties.Name="Toggle GPU clock tuning">
                                <TextBlock Text="C"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Button>
                            <Slider x:Name="GpuCoreClockSlider"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Minimum="{Binding GpuCoreClockOffsetMinimum, Mode=OneWay}"
                                    Maximum="{Binding GpuCoreClockOffsetMaximum, Mode=OneWay}"
                                    Value="{Binding GpuCoreClockOffsetMegahertz, Mode=OneWay}"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    LargeChange="25"
                                    IsEnabled="{Binding CanEditGpuClockTuning, Mode=OneWay}"
                                    AutomationProperties.Name="GPU core clock offset"
                                    ValueChanged="OnGpuCoreClockOffsetChanged" />
                        </Grid>

                        <Grid x:Name="GpuMemoryClockSliderRow"
                              Height="48"
                              ColumnSpacing="8"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource QuickSliderIconButtonStyle}"
                                    IsEnabled="{Binding CanToggleGpuClockTuning, Mode=OneWay}"
                                    Click="OnGpuClockTuningClick"
                                    ToolTipService.ToolTip="Toggle GPU clock tuning"
                                    AutomationProperties.Name="Toggle GPU clock tuning">
                                <TextBlock Text="M"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Button>
                            <Slider x:Name="GpuMemoryClockSlider"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Minimum="{Binding GpuMemoryClockOffsetMinimum, Mode=OneWay}"
                                    Maximum="{Binding GpuMemoryClockOffsetMaximum, Mode=OneWay}"
                                    Value="{Binding GpuMemoryClockOffsetMegahertz, Mode=OneWay}"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    LargeChange="25"
                                    IsEnabled="{Binding CanEditGpuClockTuning, Mode=OneWay}"
                                    AutomationProperties.Name="GPU memory clock offset"
                                    ValueChanged="OnGpuMemoryClockOffsetChanged" />
                        </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DetailPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="10,8,14,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Width="38"
                        Height="38"
                        Padding="0"
                        Click="OnDetailBackClick"
                        AutomationProperties.Name="Back to quick controls">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock x:Name="DetailTitle"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView x:Name="PerformanceDetail"
                          Margin="14,2,14,10"
                          ItemsSource="{Binding AvailableActivePerformanceOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedPerformanceOption, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnPerformanceChanged"
                          AutomationProperties.Name="Performance choices" />
                <ListView x:Name="FansDetail"
                          Margin="14,2,14,10"
                          Visibility="Collapsed"
                          ItemsSource="{Binding AvailableActiveFanModeOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedFanModeOption, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnFanModeChanged"
                          AutomationProperties.Name="Fan choices" />
                <ListView x:Name="LightingDetail"
                          Margin="14,2,14,10"
                          Visibility="Collapsed"
                          ItemsSource="{Binding AvailableLightingEffectOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedLightingEffectOption, Mode=TwoWay}"
                          SelectionMode="Single"
                          AutomationProperties.Name="Lighting effect choices" />
                <StackPanel x:Name="GamingModeDetail"
                            Margin="18,8,18,12"
                            Spacing="14"
                            Visibility="Collapsed">
                    <TextBlock Text="Choose which keys Windows blocks while gaming mode is on."
                               Style="{StaticResource QuickTileValueStyle}"
                               TextWrapping="Wrap"
                               MaxLines="3" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Block Windows key"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="GamingModeWindowsKeyToggle"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      OffContent=""
                                      OnContent=""
                                      IsEnabled="{Binding CanEditGamingModeKeyPolicy, Mode=OneWay}"
                                      Toggled="OnGamingModeKeyPolicyToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Block Alt+Tab"
                                   VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="GamingModeAltTabToggle"
                                      Grid.Column="1"
                                      MinWidth="0"
                                      OffContent=""
                                      OnContent=""
                                      IsEnabled="{Binding CanEditGamingModeKeyPolicy, Mode=OneWay}"
                                      Toggled="OnGamingModeKeyPolicyToggled" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Height="48"
                Padding="20,0"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid x:Name="StatusItemsHost"
                      ColumnSpacing="12"
                      VerticalAlignment="Center">
                    <Grid x:Name="BatteryPowerStatus"
                          ColumnSpacing="6"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE83F;" Style="{StaticResource StatusIconStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardBatteryPowerFlowLabel, Mode=OneWay}"
                                   ToolTipService.ToolTip="{Binding BatteryPowerFlowLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="TemperatureStatus"
                          ColumnSpacing="6"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9CA;" Style="{StaticResource StatusIconStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardTemperatureLabel, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="PowerSourceStatus"
                          ColumnSpacing="6"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE945;" Style="{StaticResource StatusIconStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TrayDashboardPowerSourceLabel, Mode=OneWay}"
                                   ToolTipService.ToolTip="{Binding TroubleshootingPowerSourceStatus, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </Grid>
                    <Grid x:Name="FanSpeedStatus"
                          ColumnSpacing="6"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
