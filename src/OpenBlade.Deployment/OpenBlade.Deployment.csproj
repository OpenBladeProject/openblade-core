<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OpenBladeCandidateReceiptFixture)' == 'true'">
    <DefineConstants>$(DefineConstants);OPENBLADE_CANDIDATE_RECEIPT_FIXTURE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OpenBladeCandidateReceiptFixture)' == 'true' And '$(OpenBladePackageProofFixture)' == 'true'">
    <DefineConstants>$(DefineConstants);OPENBLADE_PACKAGE_PROOF_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OpenBladeCandidateReceiptFixture)' == 'true'">
    <Compile Include="../../build/development-deployment/WindowsNativeRoleInventory.cs" Link="WindowsNativeRoleInventory.cs" />
    <Compile Include="../../build/development-deployment/WindowsNativeInventoryBurnExtractor.cs" Link="WindowsNativeInventoryBurnExtractor.cs" />
    <Compile Include="../../build/development-deployment/BurnFixtureCabinet.cs" Link="BurnFixtureCabinet.cs" />
    <Compile Include="../../build/development-deployment/WindowsNativePackageRoleProof.cs" Link="WindowsNativePackageRoleProof.cs" />
    <InternalsVisibleTo Include="OpenBlade.DeploymentBroker" />
    <InternalsVisibleTo Include="OpenBlade.Setup" />
    <InternalsVisibleTo Include="OpenBlade.Setup.Tests" />
  </ItemGroup>

</Project>
