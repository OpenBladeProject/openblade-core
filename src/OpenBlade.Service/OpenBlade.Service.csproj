<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SelfContained>false</SelfContained>
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <UserSecretsId>dotnet-OpenBlade.Service-da4c3e6f-538f-4bb3-b922-bbdc93aa5415</UserSecretsId>
    <OpenBladePadlessHyperBoostLifecycleValidation Condition="'$(OpenBladePadlessHyperBoostLifecycleValidation)' == ''">false</OpenBladePadlessHyperBoostLifecycleValidation>
    <OpenBladeThermalExternalDriftValidation Condition="'$(OpenBladeThermalExternalDriftValidation)' == ''">false</OpenBladeThermalExternalDriftValidation>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OpenBladePadlessHyperBoostLifecycleValidation"
                      Value="$(OpenBladePadlessHyperBoostLifecycleValidation)" />
    <AssemblyMetadata Include="OpenBladeValidationSourceRevision"
                      Value="$(SourceRevision)"
                      Condition="'$(OpenBladePadlessHyperBoostLifecycleValidation)' == 'true' or '$(OpenBladeThermalExternalDriftValidation)' == 'true'" />
    <AssemblyMetadata Include="OpenBladeThermalExternalDriftValidation"
                      Value="$(OpenBladeThermalExternalDriftValidation)" />
  </ItemGroup>

  <Target Name="ValidatePadlessHyperBoostLifecycleValidationBuild"
          BeforeTargets="CoreCompile"
          Condition="'$(OpenBladePadlessHyperBoostLifecycleValidation)' == 'true'">
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevision)', '^[0-9a-fA-F]{40}$')) != 'True'"
           Text="Pad-less HyperBoost lifecycle validation builds require SourceRevision to be the exact 40-character commit SHA." />
  </Target>

  <Target Name="ValidateThermalExternalDriftValidationBuild"
          BeforeTargets="CoreCompile"
          Condition="'$(OpenBladeThermalExternalDriftValidation)' == 'true'">
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevision)', '^[0-9a-fA-F]{40}$')) != 'True'"
           Text="Thermal external-drift validation builds require SourceRevision to be the exact 40-character commit SHA." />
  </Target>

  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(OpenBladeMinimumDotNetRuntimeVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenBlade.Contracts\OpenBlade.Contracts.csproj" />
    <ProjectReference Include="..\OpenBlade.Platform\OpenBlade.Platform.csproj" />
    <ProjectReference Include="..\OpenBlade.Protocol\OpenBlade.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
