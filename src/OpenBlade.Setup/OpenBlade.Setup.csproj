<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\OpenBlade.Tray\Assets\Brand\OpenBlade.Installer.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OpenBladeLocalDevDeployment)' == 'true'">
    <DefineConstants>$(DefineConstants);OPENBLADE_LOCAL_DEV_DEPLOYMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(OpenBladeLocalDevDeployment)' != 'true'">
    <Compile Remove="LocalDevEnrollmentUser.cs" />
    <Compile Remove="LocalDevRelatedBundleCompatibility.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBlade.Contracts\OpenBlade.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OpenBladeIncludePseudoLocalization)' == 'false'">
    <EmbeddedResource Remove="Properties\Resources.qps-ploc.resx" />
  </ItemGroup>

</Project>
