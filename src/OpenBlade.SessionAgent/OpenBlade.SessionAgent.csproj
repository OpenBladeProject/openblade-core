<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <SelfContained>false</SelfContained>
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <PublishTrimmed>false</PublishTrimmed>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <OpenBladeSessionAgentManifestSource>$(MSBuildProjectDirectory)\app.manifest</OpenBladeSessionAgentManifestSource>
    <ApplicationManifest>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\OpenBlade.SessionAgent.effective.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(OpenBladeMinimumDotNetRuntimeVersion)" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenBlade.Contracts\OpenBlade.Contracts.csproj" />
    <ProjectReference Include="..\OpenBlade.Display\OpenBlade.Display.csproj" />
    <ProjectReference Include="..\OpenBlade.Platform\OpenBlade.Platform.csproj" />
    <ProjectReference Include="..\OpenBlade.Session\OpenBlade.Session.csproj" />
    <ProjectReference Include="..\OpenBlade.Tray.Core\OpenBlade.Tray.Core.csproj" />
  </ItemGroup>

  <Target Name="PrepareOpenBladeSessionAgentManifest"
          BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(OpenBladeSessionAgentManifestSource)')"
           Text="The Session Agent manifest source is missing: $(OpenBladeSessionAgentManifestSource)" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ApplicationManifest)'))" />
    <Copy SourceFiles="$(OpenBladeSessionAgentManifestSource)"
          DestinationFiles="$(ApplicationManifest)"
          SkipUnchangedFiles="false" />
    <Touch Files="$(ApplicationManifest)"
           AlwaysCreate="false"
           ForceTouch="true" />
  </Target>
</Project>
