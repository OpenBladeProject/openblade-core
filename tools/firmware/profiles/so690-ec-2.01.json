        }
      ]
    },
    {
      "title": "Direct zero duty",
      "description": "Active bit 0 and F0 bit 6 gate selector FE. B8/B9 are copied without a lower clamp to F01807/F01803. Requested zero and actual zero do not alone prove mechanically stopped fans; tach readback remains separate.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO690 EC 2.01 firmware",
          "address": 85276,
          "label": "Policy dispatcher"
        },
        {
          "kind": "instruction",
          "source": "SO690 EC 2.01 firmware",
          "address": 86376,
          "label": "Direct PWM branch"
        }
      ]
    },
    {
      "title": "Mailbox completion",
      "description": "Mapped A0 reads and A1 writes use bank/index/count at F02290..92. Status 80 is set before the loop. The caller clears command F02293 after the handler returns; status alone is insufficient. Read-only descriptors ignore writes.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO690 EC 2.01 firmware",
          "address": 8252,
          "label": "Mapped mailbox handler"
        },
        {
          "kind": "instruction",
          "source": "SO690 EC 2.01 firmware",
          "address": 73000,
          "label": "Handler return and command clear"
        }
      ]
    },
    {
      "title": "Auto handback and residual ownership",
      "description": "Restoring the captured normal selector leaves FE. Preserve the prior manual flags, override bits and staging bytes; confirm independently. There is no host-loss fan lease. Source mapping alone does not establish exclusive mailbox ownership or authorize live writes.",
      "evidence_status": "firmware-confirmed",
      "references": [
