  "findings": [
    {
      "title": "Independent Lamborghini image",
      "description": "Pins SO695 EC 1.01, not standard SO690 EC 2.01. The official carrier binds board 1A583009 and RZ09-0483. Reported firmware versions are compatibility gates, not live image attestation.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "document",
          "source": "https://mysupport.razer.com/app/answers/detail/a_id/21282",
          "label": "Official Lamborghini firmware"
        },
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 20644,
          "label": "Exact ROM initialization"
        }
      ]
    },
    {
      "title": "Mailbox completion follows the mapped operation",
      "description": "Status 80 is stored before the mapped loop. Caller 11D30 clears command F02293 after handler 203C returns. Require command zero, status, descriptor integrity and a separate fresh mapped readback; no ownership lease follows from matching descriptors.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 8848,
          "label": "Early status"
        },
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 9004,
          "label": "Mapped write"
        },
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 73008,
          "label": "Post-handler command clear"
        }
      ]
    },
    {
      "title": "Direct zero duty and Auto handback",
      "description": "FE copies B8/B9 unchanged, including zero. Restoring a captured normal selector permits feedback before permission is cleared; independently observe manual zero and restore owned override/staging bytes. No third PWM store occurs in this FE branch.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 86444,
          "label": "First direct store"
        },
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 86492,
          "label": "Second direct store"
        },
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 83834,
          "label": "FE-only feedback exclusion"
        },
        {
          "kind": "instruction",
          "source": "SO695 Lamborghini EC 1.01 firmware",
          "address": 87246,
          "label": "Conditional manual reset"
        }
      ]
    },
    {
      "title": "Physical behavior remains untested",
      "description": "Staged zero, hardware duty zero, coarse tach zero and physical fan stop are distinct. The data-only profile supplies no live access and no physical restoration or host-loss recovery guarantee.",
      "evidence_status": "unknown",
      "references": [
        {
          "kind": "document",
          "source": "docs/fan-stop-so695-source-review.md",
          "label": "Source contract and boundaries"
        }
      ]
    },
    {
      "title": "Mapped read-only firmware-family discriminator",
      "description": "Use model/HID, EC version 1.01 and fresh bank-zero E3/E4 ==09/30 together. Exact vendor ShowEcVersion reads these bytes and compares 0x3009 with ToolConfig. Standard SO690 initializes 06/30 instead. The discriminator is a firmware-reported family, not physical board or image attestation.",
      "evidence_status": "firmware-confirmed",
