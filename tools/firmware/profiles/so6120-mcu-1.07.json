  "findings": [
    {
      "title": "The named duty API is rejected",
      "description": "The actual duty setter/getter wrappers reach unsupported handling in this MCU; generic register access is a separate interface.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 39080,
          "label": "The named duty API is rejected"
        }
      ]
    },
    {
      "title": "Two response status layers",
      "description": "Generic register handlers store bus status separately from outer report status. Failed reads leave the supplied data area unchanged.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 29812,
          "label": "Two response status layers"
        }
      ]
    },
    {
      "title": "Shared transfer state",
      "description": "Normal main-loop work and timer-dispatched generic transfers share bus state and buffers. Full reentrancy and exclusive access are not established. The transport wait feeds a watchdog helper that re-enables interrupts, so blanket interrupt masking is not an established ownership guarantee.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 22628,
          "label": "Shared transfer state"
        },
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 45092,
          "label": "Watchdog feed unconditionally re-enables interrupts"
        }
      ]
    },
    {
      "title": "A running watchdog is not a host-loss lease",
      "description": "The MCU main loop continues feeding its watchdog after host-process loss. No independent bounded fan handback is established.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 26332,
          "label": "A running watchdog is not a host-loss lease"
        }
      ]
    },
    {
      "title": "Manual write does not enqueue its own flag readback",
      "description": "The successful manual-write branch sets bit 16 for a separate parameter group; index 36 readback uses bit 18. A cached GET therefore cannot be treated as confirmation of that bus write.",
      "evidence_status": "firmware-confirmed",
      "references": [
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 19586,
          "label": "2 shifted left by 15 sets bit 16"
        },
        {
          "kind": "instruction",
          "source": "SO6120 MCU 1.07 firmware",
          "address": 19520,
          "label": "Independent manual read uses bit 18"
        }
      ]
    }
  ]
