<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <OpenBladeVersion>0.24.0</OpenBladeVersion>
    <Version>$(OpenBladeVersion)</Version>
    <AssemblyVersion>$(OpenBladeVersion).0</AssemblyVersion>
    <FileVersion>$(OpenBladeVersion).0</FileVersion>
    <InformationalVersion>$(OpenBladeVersion)</InformationalVersion>
    <OpenBladeCpuVoltageValidation Condition="'$(OpenBladeCpuVoltageValidation)' == ''">false</OpenBladeCpuVoltageValidation>
    <DefineConstants Condition="'$(OpenBladeCpuVoltageValidation)' == 'true'">$(DefineConstants);OPENBLADE_CPU_VOLTAGE_VALIDATION</DefineConstants>
    <InformationalVersion Condition="'$(OpenBladeCpuVoltageValidation)' == 'true'">$(OpenBladeVersion)+voltage-validation</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
