<Project>
  <!-- Global fixture switches change referenced assemblies and restore graphs.
       Isolate every consumer before SDK Common.props chooses output/assets paths.
       Keep each effective combination distinct, including the NativeAOT graph. -->
  <PropertyGroup>
    <_OpenBladeFixtureVariant></_OpenBladeFixtureVariant>
    <!-- Short flag keys keep NativeAOT linker paths within Windows tool limits:
         n = native package tests, c = candidate receipt, p = package proof,
         s = scratch native receiver (effective only with candidate receipt),
         i = selected LocalDev native status integration. -->
    <_OpenBladeFixtureVariant Condition="'$(OpenBladeNativePackageTests)' == 'true' Or '$(OpenBladeCandidateReceiptFixture)' == 'true' Or '$(OpenBladePackageProofFixture)' == 'true' Or ('$(OpenBladeNativeStatusIntegration)' == 'true' And '$(OpenBladeLocalDevDeployment)' == 'true')">.Fixtures</_OpenBladeFixtureVariant>
    <_OpenBladeFixtureVariant Condition="'$(OpenBladeNativePackageTests)' == 'true'">$(_OpenBladeFixtureVariant).n</_OpenBladeFixtureVariant>
    <_OpenBladeFixtureVariant Condition="'$(OpenBladeCandidateReceiptFixture)' == 'true'">$(_OpenBladeFixtureVariant).c</_OpenBladeFixtureVariant>
    <_OpenBladeFixtureVariant Condition="'$(OpenBladePackageProofFixture)' == 'true'">$(_OpenBladeFixtureVariant).p</_OpenBladeFixtureVariant>
    <_OpenBladeFixtureVariant Condition="'$(OpenBladeCandidateReceiptFixture)' == 'true' And '$(OpenBladeScratchNativeReceiver)' == 'true'">$(_OpenBladeFixtureVariant).s</_OpenBladeFixtureVariant>
    <_OpenBladeFixtureVariant Condition="'$(OpenBladeNativeStatusIntegration)' == 'true' And '$(OpenBladeLocalDevDeployment)' == 'true'">$(_OpenBladeFixtureVariant).i</_OpenBladeFixtureVariant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_OpenBladeFixtureVariant)' != ''">
    <ArtifactsProjectName>$(MSBuildProjectName)$(_OpenBladeFixtureVariant)</ArtifactsProjectName>
    <BaseIntermediateOutputPath Condition="'$(ArtifactsPath)' == '' And '$(UseArtifactsOutput)' != 'true'">obj\fixtures$(_OpenBladeFixtureVariant)\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(ArtifactsPath)' == '' And '$(UseArtifactsOutput)' != 'true'">bin\fixtures$(_OpenBladeFixtureVariant)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <OpenBladeVersion>0.77.0</OpenBladeVersion>
    <OpenBladeMinimumDotNetRuntimeVersion>10.0.12</OpenBladeMinimumDotNetRuntimeVersion>
    <Version>$(OpenBladeVersion)</Version>
    <AssemblyVersion>$(OpenBladeVersion).0</AssemblyVersion>
    <FileVersion>$(OpenBladeVersion).0</FileVersion>
    <InformationalVersion>$(OpenBladeVersion)</InformationalVersion>
    <OpenBladeCpuVoltageValidation Condition="'$(OpenBladeCpuVoltageValidation)' == ''">false</OpenBladeCpuVoltageValidation>
    <DefineConstants Condition="'$(OpenBladeCpuVoltageValidation)' == 'true'">$(DefineConstants);OPENBLADE_CPU_VOLTAGE_VALIDATION</DefineConstants>
    <InformationalVersion Condition="'$(OpenBladeCpuVoltageValidation)' == 'true' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevision)', '^[0-9a-fA-F]{40}$'))">$(OpenBladeVersion)+voltage-validation.$([System.String]::Copy('$(SourceRevision)').Substring(0, 8).ToLowerInvariant())</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(OpenBladeCpuVoltageValidation)' == 'true'">false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
